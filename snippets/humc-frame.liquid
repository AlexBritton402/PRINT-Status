{% doc %}
  HUMC Gear chrome — Chipply/humcgear.com replica header + footer.
  @param {string} part - header or footer
{% enddoc %}

{%- liquid
  assign home = pages['humc-gear'].url | default: '/pages/humc-gear'
  assign catalog = collections['humc-gear'].url | default: '/collections/humc-gear'
  assign contact = pages['contact'].url | default: '/pages/contact'
-%}

{%- if part == 'header' -%}
  {% render 'store-switch', target: 'print' %}
  {% render 'store-attribution', store: 'humc' %}
  <div class="humc-announce" data-humc-announce>
    <span class="humc-announce__shop">Harbor-UCLA hospital shop</span>
    <span class="humc-announce__auth">
      {%- if shop.customer_accounts_enabled -%}
        {%- if customer -%}
          <a href="{{ routes.account_url }}">Account</a>
        {%- else -%}
          <a href="{{ routes.account_login_url }}">Login</a>
          <a href="{{ routes.account_register_url }}">Register</a>
        {%- endif -%}
      {%- endif -%}
      <a href="{{ routes.cart_url }}" aria-label="Cart">Cart{% if cart.item_count > 0 %}: {{ cart.item_count }}{% endif %}</a>
    </span>
  </div>
  <header class="humc-frame">
    <div class="humc-frame__bar">
      <a class="humc-frame__logo" href="{{ home }}">
        <img
          src="{{ 'humc-logo.png' | asset_url }}"
          alt="HUMC Gear"
          width="800"
          height="145"
          loading="eager"
        >
      </a>
    </div>
    <nav class="humc-frame__nav" aria-label="HUMC Gear">
      <a href="{{ home }}">Home</a>
      <a href="{{ catalog }}">Products</a>
      <a href="{{ contact }}">Contact Us</a>
    </nav>
  </header>
{%- endif -%}

{%- if part == 'footer' -%}
  <footer class="humc-frame__foot">
    <nav aria-label="HUMC Gear footer">
      <a href="{{ home }}">Home</a>
      <a href="{{ catalog }}">Products</a>
      <a href="{{ contact }}">Contact Us</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}">
          {%- if customer -%}Account{%- else -%}Login{%- endif -%}
        </a>
      {%- endif -%}
    </nav>
  </footer>
{%- endif -%}

{% stylesheet %}
  .humc-body {
    background: #fff;
    color: #121212;
    font-family: Karla, Helvetica, sans-serif;
  }
  .humc-body h1,
  .humc-body h2,
  .humc-body h3 {
    font-family: Montserrat, Helvetica, Arial, sans-serif;
  }
  .humc-announce {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: #fff;
    color: #380000;
    padding: 8px var(--page-margin);
    border-bottom: 1px solid #eee;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
  }
  .humc-announce__shop {
    text-transform: uppercase;
  }
  .humc-announce__auth {
    display: flex;
    gap: 0.85rem;
    margin-inline-start: auto;
    text-transform: uppercase;
  }
  .humc-announce__auth a {
    color: #333;
    text-decoration: none;
  }
  .humc-announce__auth a:hover {
    text-decoration: underline;
  }
  .humc-frame__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 1600px;
    margin-inline: auto;
    padding: 16px var(--page-margin) 12px;
  }
  .humc-frame__logo img {
    display: block;
    width: min(320px, 78vw);
    height: auto;
  }
  .humc-frame__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 36px;
    min-height: 52px;
    background: #005696;
    color: #fff;
    font-size: 0.92rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .humc-frame__nav a,
  .humc-frame__foot a {
    color: #fff;
    text-decoration: none;
  }
  .humc-frame__nav a:hover,
  .humc-frame__foot a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .humc-frame__foot {
    display: flex;
    justify-content: center;
    gap: 28px;
    padding: 36px var(--page-margin);
    background: #005696;
    color: #fff;
  }
  .humc-body .product-form-buttons .button,
  .humc-body button[name="add"],
  .humc-body .buy-buttons .button {
    background: #005696 !important;
    color: #fff !important;
    border-color: #005696 !important;
  }

  .humc-frame__foot nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
  }
  #PBarNextFrame {
    display: none !important;
  }
{% endstylesheet %}
