{% doc %}
  HUMC Gear chrome — match vvpx4r Radiant: Home / Catalog / Contact.
  @param {string} part - header or footer
{% enddoc %}

{%- liquid
  assign home = pages['humc-gear'].url | default: '/pages/humc-gear'
  assign catalog = collections['humc-gear'].url | default: '/collections/humc-gear'
  assign contact = pages['contact'].url | default: '/pages/contact'
  assign learn = pages['humc-learn-more'].url | default: '/pages/humc-learn-more'
-%}

{%- if part == 'header' -%}
  {% render 'store-switch', target: 'print' %}
  {% render 'store-attribution', store: 'humc' %}
  <header class="humc-frame">
    <div class="humc-frame__bar">
      <a class="humc-frame__logo" href="{{ home }}">
        <img
          src="{{ 'humc-logo.png' | asset_url }}"
          alt="HUMC Gear"
          width="800"
          height="145"
          loading="eager"
        >
      </a>
      <nav class="humc-frame__nav" aria-label="HUMC Gear">
        <a href="{{ home }}">Home</a>
        <a href="{{ catalog }}">Catalog</a>
        <a href="{{ contact }}">Contact</a>
      </nav>
      <div class="humc-frame__tools">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" aria-label="Account">Account</a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" aria-label="Cart">Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
      </div>
    </div>
  </header>
{%- endif -%}

{%- if part == 'footer' -%}
  <footer class="humc-frame__foot">
    <nav aria-label="HUMC Gear footer">
      <a href="{{ home }}">Home</a>
      <a href="{{ catalog }}">Catalog</a>
      <a href="{{ contact }}">Contact</a>
      <a href="{{ learn }}">Learn more</a>
    </nav>
  </footer>
{%- endif -%}

{% stylesheet %}
  .humc-body {
    background: #fff;
    color: #380000;
    font-family: Karla, Helvetica, sans-serif;
  }
  .humc-body h1,
  .humc-body h2,
  .humc-body h3 {
    font-family: Montserrat, Helvetica, Arial, sans-serif;
  }
  .humc-frame__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    max-width: 1400px;
    margin-inline: auto;
    padding: 14px var(--page-margin, 24px);
    border-bottom: 1px solid #eee;
  }
  .humc-frame__logo {
    justify-self: start;
  }
  .humc-frame__logo img {
    display: block;
    width: min(220px, 55vw);
    height: auto;
  }
  .humc-frame__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    font-size: 0.95rem;
  }
  .humc-frame__nav a {
    color: #380000;
    text-decoration: none;
  }
  .humc-frame__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .humc-frame__tools {
    display: flex;
    justify-content: flex-end;
    gap: 14px;
    font-size: 0.85rem;
  }
  .humc-frame__tools a {
    color: #380000;
    text-decoration: none;
  }
  .humc-frame__foot {
    display: flex;
    justify-content: center;
    padding: 36px var(--page-margin, 24px);
    background: #580202;
    color: #f5f4f0;
  }
  .humc-frame__foot nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
  }
  .humc-frame__foot a {
    color: #f5f4f0;
    text-decoration: none;
  }
  .humc-frame__foot a:hover {
    text-decoration: underline;
  }
  .humc-body .product-form-buttons .button,
  .humc-body button[name='add'],
  .humc-body .buy-buttons .button {
    background: #380000 !important;
    color: #fff !important;
    border-color: #380000 !important;
  }
  @media screen and (max-width: 749px) {
    .humc-frame__bar {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .humc-frame__logo,
    .humc-frame__tools {
      justify-self: center;
    }
  }
  #PBarNextFrame {
    display: none !important;
  }
{% endstylesheet %}
