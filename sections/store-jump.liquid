{%- comment -%}
  Temporary jump to a hidden company store. Remove when private links are enough.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }} store-jump">
  <a class="store-jump__link" href="{{ section.settings.link | default: '/humc' }}">
    <span class="store-jump__name">{{ section.settings.label | default: 'HUMC Gear' | escape }}</span>
    <span class="store-jump__go">{{ section.settings.go_label | default: 'Open store' | escape }}</span>
  </a>
</div>

{% stylesheet %}
  .store-jump {
    padding-block: 8px 20px;
  }
  .store-jump__link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    color: inherit;
    text-decoration: none;
    border: 1.5px solid var(--color-foreground);
    border-radius: 12px;
  }
  .store-jump__name {
    font-family: var(--font-heading--family);
    font-weight: 700;
  }
  .store-jump__go {
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 0.9375rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Store jump",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Store name",
      "default": "HUMC Gear"
    },
    {
      "type": "text",
      "id": "go_label",
      "label": "Action",
      "default": "Open store"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Store link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Store jump"
    }
  ]
}
{% endschema %}
