{%- comment -%}
  HUMC Catalog — match vvpx4r-z1 Radiant /collections/all:
  Products heading, count, square photo grid, all collection SKUs
  (including Item Personalization). No Chipply category sidebar.
{%- endcomment -%}

{%- liquid
  assign store = collection
  if store == blank
    assign store = collections['humc-gear']
  endif
-%}

<div class="humc-catalog" data-humc-catalog>
  <header class="humc-catalog__head">
    <h1 class="humc-catalog__title-page">{{ section.settings.heading | default: 'Products' | escape }}</h1>
    {%- if store != blank -%}
      {%- assign shown = 0 -%}
      {%- for product in store.products -%}
        {%- if product.published_at -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      <p class="humc-catalog__count">{{ shown }} products</p>
    {%- endif -%}
  </header>

  <ul class="humc-catalog__grid" role="list">
    {%- if store != blank -%}
      {%- for product in store.products -%}
        {%- unless product.published_at -%}
          {%- continue -%}
        {%- endunless -%}
        <li>
          <a class="humc-catalog__card" href="{{ product.url }}">
            <span class="humc-catalog__photo">
              {% render 'humc-vv-image', product: product, loading: 'lazy' %}
              {%- unless product.available -%}
                <span class="humc-catalog__sold">Sold out</span>
              {%- endunless -%}
            </span>
            <span class="humc-catalog__title">{{ product.title | escape }}</span>
            <span class="humc-catalog__price">
              <span class="humc-catalog__price-label">Regular price</span>
              {{ product.price | money }} USD
            </span>
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      <li class="humc-catalog__empty-list">No products in this catalog yet.</li>
    {%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .humc-catalog {
    max-width: 1400px;
    margin-inline: auto;
    padding: 28px var(--page-margin, 24px) 72px;
    font-family: Karla, Helvetica, sans-serif;
    color: #121212;
  }

  .humc-catalog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
    margin-block-end: 28px;
  }

  .humc-catalog__title-page {
    margin: 0;
    font-family: Montserrat, Helvetica, Arial, sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #121212;
  }

  .humc-catalog__count {
    margin: 0;
    font-size: 0.95rem;
    color: #580202;
  }

  .humc-catalog__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 20px;
  }

  @media screen and (min-width: 750px) {
    .humc-catalog__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .humc-catalog__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .humc-catalog__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }

  .humc-catalog__photo {
    position: relative;
    display: block;
    aspect-ratio: 1;
    background: #f7f7f7;
  }

  .humc-catalog__sold {
    position: absolute;
    inset: 10px auto auto 10px;
    padding: 6px 10px;
    background: #c41e3a;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .humc-catalog__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: #f5f5f5;
    color: #580202;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .humc-catalog__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .humc-catalog__title {
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .humc-catalog__price {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .humc-catalog__price-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #666;
  }

  .humc-catalog__empty-list {
    grid-column: 1 / -1;
    color: #580202;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "HUMC catalog",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Products"
    }
  ]
}
{% endschema %}
