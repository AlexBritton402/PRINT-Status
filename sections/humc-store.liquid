{%- comment -%}
  PRINT Status – HUMC Gear store page (self-contained, no collection/metafields needed).
  A separate branded store landing in the sandbox. Brand baked as defaults; editable in the
  theme editor. Does not touch the main PRINT Status store.
{%- endcomment -%}

{%- liquid
  assign brand = section.settings.brand_color | default: '#0070b0'
  assign ink = brand | color_brightness
  if ink > 130
    assign on_brand = '#111111'
  else
    assign on_brand = '#ffffff'
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }} section--full-width humc">
  <div class="humc__hero" style="background: {{ brand }}; color: {{ on_brand }};">
    <div class="humc__hero-inner">
      {%- if section.settings.logo != blank -%}
        <img
          class="humc__logo"
          src="{{ section.settings.logo | asset_url }}"
          alt="{{ section.settings.heading | default: 'HUMC Gear' | escape }}"
          width="800"
          height="145"
          loading="eager">
      {%- else -%}
        <h1 class="humc__wordmark">{{ section.settings.heading | default: 'HUMC Gear' | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="humc__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}

      {%- liquid
        assign b1l = section.settings.button_1_label | strip
        assign b2l = section.settings.button_2_label | strip
        assign show1 = false
        assign show2 = false
        if b1l != blank and section.settings.button_1_link != blank
          assign show1 = true
        endif
        if b2l != blank and section.settings.button_2_link != blank
          assign show2 = true
        endif
      -%}
      {%- if show1 or show2 -%}
        <div class="humc__cta">
          {%- if show1 -%}
            <a class="button humc__button" style="background: {{ on_brand }}; color: {{ brand }};" href="{{ section.settings.button_1_link }}">{{ b1l | escape }}</a>
          {%- endif -%}
          {%- if show2 -%}
            <a class="button humc__button humc__button--ghost" style="border-color: {{ on_brand }}; color: {{ on_brand }};" href="{{ section.settings.button_2_link }}">{{ b2l | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.intro != blank -%}
    <div class="humc__intro">{{ section.settings.intro }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .humc__hero {
    padding: clamp(40px, 7vw, 96px) var(--page-margin);
    text-align: center;
  }
  .humc__hero-inner {
    max-width: var(--page-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .humc__logo {
    width: min(460px, 80vw);
    height: auto;
    /* logo is dark-on-transparent; keep it on a light plate for contrast on the brand band */
    background: #ffffff;
    padding: 18px 24px;
    border-radius: 14px;
  }
  .humc__wordmark {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
  }
  .humc__tagline {
    margin: 0;
    font-size: clamp(1rem, 2.2vw, 1.375rem);
    font-weight: 600;
    opacity: 0.95;
  }
  .humc__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 6px;
  }
  .humc__button {
    font-family: var(--font-heading--family);
    font-weight: 700;
  }
  .humc__button--ghost {
    background: transparent !important;
    border: 2px solid;
  }
  .humc__intro {
    max-width: var(--page-width);
    margin: clamp(28px, 4vw, 48px) auto;
    padding-inline: var(--page-margin);
    text-align: center;
    font-size: 1.0625rem;
  }
  .humc__intro :is(p) { margin: 0 auto; max-width: 70ch; }
{% endstylesheet %}

{% schema %}
{
  "name": "HUMC Gear store",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Store name (used if no logo)",
      "default": "HUMC Gear"
    },
    {
      "type": "text",
      "id": "logo",
      "label": "Bundled logo asset filename",
      "default": "humc-gear-logo.png"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Brand color",
      "default": "#0070b0"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Official HUMC gear — fulfillment by PRINT Status"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "<p>Welcome to the HUMC Gear store. Shop official gear, printed and fulfilled by PRINT Status.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop gear"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "HUMC Gear store"
    }
  ]
}
{% endschema %}
