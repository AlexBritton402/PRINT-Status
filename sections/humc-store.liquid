{%- comment -%}
  HUMC Gear home — visual twin of humcgear.com (Chipply).
  Theme assets only; no live call to the old store.
{%- endcomment -%}

{%- liquid
  assign store = collections['humc-gear']
  assign shop_link = section.settings.shop_link | default: store.url | default: '/collections/humc-gear'
  assign learn_link = pages['humc-learn-more'].url | default: '/pages/humc-learn-more'
  assign hero_image = section.settings.hero_image | default: 'humc-bg-home.png'
  assign sleeve_image = section.settings.sleeve_image | default: 'humc-long-sleeve.png'
  assign scrub_image = section.settings.scrub_image | default: 'humc-scrubs.png'
  assign polo_image = section.settings.polo_image | default: 'humc-custompolo.jpg'
  assign announce = section.settings.announce
-%}

<div class="humc-home">
  <section class="humc-hero">
    <img
      class="humc-hero__img"
      src="{{ hero_image | asset_url }}"
      alt=""
      width="2000"
      height="685"
      loading="eager"
    >
    <div class="humc-hero__inner">
      {%- if announce != blank -%}
        <p class="humc-hero__announce">{{ announce | escape }}</p>
      {%- endif -%}
      <h1 class="humc-hero__title">
        {{ section.settings.hero_heading | default: 'YOUR EXCLUSIVE PROVIDER OF HARBOR-UCLA AND LA COUNTY GEAR' | escape }}
      </h1>
      <div class="humc-hero__actions">
        <div class="humc-hero__action">
          <img src="{{ 'humc-icon-order.png' | asset_url }}" alt="" width="51" height="51">
          <strong>Order</strong>
          <span>HUMCGear.com or<br>Farmer's Market</span>
        </div>
        <div class="humc-hero__action">
          <img src="{{ 'humc-icon-pickup.png' | asset_url }}" alt="" width="51" height="51">
          <strong>Pickup</strong>
          <span>At Farmer's Market or at<br>Print Status</span>
        </div>
      </div>
    </div>
  </section>

  <section class="humc-new">
    <div class="humc-new__rail" aria-hidden="true">
      <span>New Products Recently Added</span>
    </div>
    <div class="humc-new__cards">
      <a class="humc-new__card" href="{{ shop_link }}?cat=tees">
        <img
          src="{{ sleeve_image | asset_url }}"
          alt="Long sleeve tees"
          width="467"
          height="426"
          loading="lazy"
        >
        <span class="humc-new__label">LONG SLEEVE TEES</span>
        <span class="humc-new__cta">CLICK HERE</span>
      </a>
      <a class="humc-new__card" href="{{ shop_link }}?cat=scrubs">
        <img
          src="{{ scrub_image | asset_url }}"
          alt="Unisex scrubs"
          width="391"
          height="360"
          loading="lazy"
        >
        <span class="humc-new__label">UNISEX SCRUBS - NEW COLORS</span>
        <span class="humc-new__cta">CLICK HERE</span>
      </a>
    </div>
    <div class="humc-new__soon">
      <p class="humc-new__soon-kicker">COMING SOON!</p>
      <a class="humc-new__soon-media" href="{{ learn_link }}">
        <img
          src="{{ polo_image | asset_url }}"
          alt="Customize for your department"
          width="640"
          height="635"
          loading="lazy"
        >
      </a>
      <h2>CUSTOMIZE FOR YOUR DEPARTMENT</h2>
      <p>SOON YOU WILL BE ABLE TO CUSTOMIZE APPAREL WITH YOUR NAME, POSITION, AND DEPARTMENT</p>
      <a class="humc-new__learn" href="{{ learn_link }}">Learn more</a>
    </div>
  </section>
</div>

{% stylesheet %}
  .humc-home {
    color: #121212;
    background: #fff;
    font-family: Karla, Helvetica, sans-serif;
  }
  .humc-hero {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: 1px solid #ddd;
  }
  .humc-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .humc-hero__inner {
    position: relative;
    z-index: 1;
    width: min(920px, 94vw);
    margin: 36px auto 48px;
    text-align: center;
  }
  .humc-hero__announce {
    margin: 0 auto 22px;
    max-width: 720px;
    padding: 14px 18px;
    background: rgba(255, 255, 255, 0.88);
    color: #121212;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .humc-hero__title {
    margin: 18px auto 28px;
    max-width: 820px;
    padding-top: 18px;
    border-top: 2px solid #121212;
    color: #c41230;
    font-family: Montserrat, Helvetica, Arial, sans-serif;
    font-size: clamp(1.35rem, 3.2vw, 2.05rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .humc-hero__actions {
    display: flex;
    justify-content: center;
    gap: clamp(48px, 10vw, 120px);
    flex-wrap: wrap;
  }
  .humc-hero__action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: #121212;
    font-size: 0.92rem;
    line-height: 1.25;
  }
  .humc-hero__action img {
    width: 51px;
    height: 51px;
    display: block;
  }
  .humc-hero__action strong {
    font-family: Montserrat, Helvetica, Arial, sans-serif;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }
  .humc-new {
    display: grid;
    grid-template-columns: 48px minmax(0, 1.2fr) minmax(0, 0.9fr);
    gap: 28px;
    align-items: start;
    max-width: 1180px;
    margin: 0 auto;
    padding: 36px 24px 56px;
  }
  .humc-new__rail {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: Montserrat, Helvetica, Arial, sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #121212;
    white-space: nowrap;
  }
  .humc-new__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  .humc-new__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    text-align: center;
  }
  .humc-new__card img {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1;
    object-fit: contain;
    border: 1px solid #121212;
    background: #fff;
  }
  .humc-new__label {
    font-family: Montserrat, Helvetica, Arial, sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .humc-new__cta {
    display: inline-block;
    min-width: 140px;
    padding: 8px 14px;
    border: 1px solid #121212;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .humc-new__soon {
    text-align: center;
  }
  .humc-new__soon-kicker {
    margin: 0 0 10px;
    color: #c41230;
    font-family: Montserrat, Helvetica, Arial, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .humc-new__soon-media img {
    width: min(100%, 360px);
    height: auto;
    border: 1px solid #121212;
    background: #fff;
  }
  .humc-new__soon h2 {
    margin: 14px 0 8px;
    color: #c41230;
    font-family: Montserrat, Helvetica, Arial, sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .humc-new__soon p {
    margin: 0 auto 14px;
    max-width: 320px;
    color: #666;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    line-height: 1.35;
  }
  .humc-new__learn {
    display: inline-block;
    padding: 8px 16px;
    background: #095aa6;
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .humc-new__learn:hover {
    text-decoration: underline;
  }
  @media screen and (max-width: 900px) {
    .humc-new {
      grid-template-columns: 1fr;
      padding: 28px 16px 48px;
    }
    .humc-new__rail {
      writing-mode: horizontal-tb;
      transform: none;
      text-align: center;
    }
    .humc-new__cards {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "HUMC Gear store",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "announce",
      "label": "Announcement",
      "default": "10/28 We apologize as we had a last minute change in our schedule for equipment delivery. We will be back on 11/04. Please reach out regarding any orders for pickup."
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "YOUR EXCLUSIVE PROVIDER OF HARBOR-UCLA AND LA COUNTY GEAR"
    },
    {
      "type": "text",
      "id": "hero_image",
      "label": "Hero image asset",
      "default": "humc-bg-home.png"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop link"
    },
    {
      "type": "text",
      "id": "sleeve_image",
      "label": "Long sleeve image asset",
      "default": "humc-long-sleeve.png"
    },
    {
      "type": "text",
      "id": "scrub_image",
      "label": "Scrubs image asset",
      "default": "humc-scrubs.png"
    },
    {
      "type": "text",
      "id": "polo_image",
      "label": "Coming soon image asset",
      "default": "humc-custompolo.jpg"
    }
  ],
  "presets": [
    {
      "name": "HUMC Gear store"
    }
  ]
}
{% endschema %}
