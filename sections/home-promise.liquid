{%- comment -%}
  PRINT Status – pickup / turnaround promise.
  A short row of promise items (optional Horizon icon + title + text)
  used on the homepage under the service paths.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} spacing-style home-promise"
  style="{% render 'spacing-style', settings: section.settings %} --hp-columns: {{ section.settings.columns }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="home-promise__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="home-promise__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign icon = block.settings.icon
        -%}
        <li class="home-promise__item" {{ block.shopify_attributes }}>
          {%- if icon != blank and icon != 'none' -%}
            <svg
              class="home-promise__icon icon-default"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 20 20"
            >
              {%- render 'icon', icon: icon -%}
            </svg>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <p class="home-promise__title">{{ block.settings.title | escape }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="home-promise__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p class="home-promise__hint">Add a “Promise” block (title and text).</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .home-promise__heading {
    text-align: center;
    margin: 0 0 clamp(20px, 3vw, 36px);
  }

  .home-promise__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(16px, 2.5vw, 28px);
    grid-template-columns: 1fr;
  }

  .home-promise__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .home-promise__icon {
    width: 28px;
    height: 28px;
    margin-bottom: 4px;
  }

  .home-promise__title {
    margin: 0;
    font-weight: 600;
  }

  .home-promise__text {
    margin: 0;
    opacity: 0.75;
    font-size: 0.9rem;
  }

  .home-promise__hint {
    text-align: center;
    opacity: 0.7;
  }

  @media screen and (min-width: 750px) {
    .home-promise__grid {
      grid-template-columns: repeat(var(--hp-columns, 3), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home promise",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank to hide."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "map_pin", "label": "Map pin" },
            { "value": "truck", "label": "Truck" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "box", "label": "Box" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Next-day ready"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Order by 3:00 PM PST, printed the next business day. Times are PST; no weekend printing."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home promise",
      "blocks": [
        {
          "type": "promise",
          "settings": {
            "icon": "stopwatch",
            "title": "Next-day ready",
            "text": "Order by 3:00 PM PST, printed the next business day. Times are PST; no weekend printing."
          }
        },
        {
          "type": "promise",
          "settings": {
            "icon": "map_pin",
            "title": "Free local pickup",
            "text": "Flat-rate $7.99 shipping, or free UPS Ground over $99."
          }
        },
        {
          "type": "promise",
          "settings": {
            "icon": "ruler",
            "title": "Any size, any quantity",
            "text": "Custom DTF transfers and gang sheets, built to your size."
          }
        }
      ]
    }
  ]
}
{% endschema %}
