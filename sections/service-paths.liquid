{%- comment -%}
  PRINT Status – service paths.
  A row of promo cards (image bundled in assets + optional caption + link),
  used on the homepage to send customers to the main services:
  upload a transfer, build a gang sheet, etc.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }} service-paths">
  {%- if section.settings.heading != blank -%}
    <h2 class="service-paths__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="service-paths__grid" role="list" style="--sp-columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          assign link = block.settings.link
          assign img_w = 1500
          assign img_h = 1000
          case img
            when 'ad.png'
              assign img_w = 2048
              assign img_h = 946
            when 'splash.png'
              assign img_w = 1920
              assign img_h = 800
            when 'splash2.png'
              assign img_w = 1536
              assign img_h = 580
            when 'DTFadvert.png'
              assign img_w = 1300
              assign img_h = 867
            when 'UploadGangsheet.png'
              assign img_w = 1536
              assign img_h = 1024
          endcase
        -%}
        <li class="service-paths__item" {{ block.shopify_attributes }}>
          {%- if link != blank -%}<a class="service-paths__card" href="{{ link }}">{%- else -%}<div class="service-paths__card">{%- endif -%}
            {%- if img != blank -%}
              <img
                class="service-paths__img"
                src="{{ img | asset_url }}"
                width="{{ img_w }}"
                height="{{ img_h }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            {%- endif -%}
            {%- if block.settings.title != blank or block.settings.text != blank -%}
              <div class="service-paths__text">
                {%- if block.settings.title != blank -%}
                  <span class="service-paths__title">{{ block.settings.title | escape }}</span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="service-paths__caption">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- if link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p class="service-paths__hint">Add a “Service” block and pick a bundled image (e.g. DTFadvert, UploadGangsheet).</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .service-paths {
    padding-block: clamp(32px, 5vw, 64px);
  }

  .service-paths__heading {
    text-align: center;
    margin: 0 0 clamp(20px, 3vw, 36px);
  }

  .service-paths__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(16px, 2.5vw, 28px);
    grid-template-columns: 1fr;
  }

  .service-paths__card {
    display: block;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--color-background);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  a.service-paths__card:is(:hover, :focus-visible) {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
  }

  .service-paths__img {
    width: 100%;
    height: auto;
    display: block;
  }

  .service-paths__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
  }

  .service-paths__title {
    font-weight: 600;
  }

  .service-paths__caption {
    opacity: 0.75;
    font-size: 0.9rem;
  }

  .service-paths__hint {
    text-align: center;
    opacity: 0.7;
  }

  @media screen and (min-width: 750px) {
    .service-paths__grid {
      grid-template-columns: repeat(var(--sp-columns, 2), 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Service paths",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What we print"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "select",
          "id": "image",
          "label": "Image",
          "options": [
            { "value": "DTFadvert.png", "label": "DTF advert" },
            { "value": "UploadGangsheet.png", "label": "Upload gang sheet" },
            { "value": "ad.png", "label": "Made in LA (ad)" },
            { "value": "splash.png", "label": "DTF Transfers – LA (splash)" },
            { "value": "splash2.png", "label": "DTF Transfers – South Bay (splash2)" }
          ],
          "default": "DTFadvert.png"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Upload your transfer"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Caption",
          "default": "Custom sizes, ready next day"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service paths",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "image": "DTFadvert.png",
            "title": "Upload your transfer",
            "text": "Custom sizes, ready next day"
          }
        },
        {
          "type": "service",
          "settings": {
            "image": "UploadGangsheet.png",
            "title": "Build a gang sheet",
            "text": "Fit more designs per sheet"
          }
        }
      ]
    }
  ]
}
{% endschema %}
