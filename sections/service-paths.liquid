{%- comment -%}
  PRINT Status – service paths.
  A row of promo cards (image bundled in assets + optional caption + link),
  used on the homepage to send customers to the main services:
  upload a transfer, build a gang sheet, etc.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }} service-paths">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="service-paths__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="service-paths__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="service-paths__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="service-paths__grid" role="list" style="--sp-columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          assign link = block.settings.link
          assign img_w = 1500
          assign img_h = 1000
          case img
            when 'ad.png'
              assign img_w = 2048
              assign img_h = 946
            when 'splash.png'
              assign img_w = 1920
              assign img_h = 800
            when 'splash2.png'
              assign img_w = 1536
              assign img_h = 580
            when 'DTFadvert.png'
              assign img_w = 1300
              assign img_h = 867
            when 'UploadGangsheet.png'
              assign img_w = 1536
              assign img_h = 1024
          endcase
        -%}
        <li class="service-paths__item" {{ block.shopify_attributes }}>
          {%- if link != blank -%}<a class="service-paths__card" href="{{ link }}">{%- else -%}<div class="service-paths__card">{%- endif -%}
            {%- if img != blank -%}
              <img
                class="service-paths__img"
                src="{{ img | asset_url }}"
                width="{{ img_w }}"
                height="{{ img_h }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
              {%- if block.settings.title != blank or block.settings.text != blank -%}
                <div class="service-paths__text">
                  {%- if block.settings.title != blank -%}
                    <span class="service-paths__title">{{ block.settings.title | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <span class="service-paths__caption">{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                  {%- if link != blank -%}
                    <span class="service-paths__go">Start</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- else -%}
              {%- liquid
                assign accent = block.settings.accent_color | append: ''
                assign panel_style = ''
                if accent != blank
                  assign panel_brightness = accent | color_brightness
                  if panel_brightness > 150
                    assign panel_ink = '#000000'
                  else
                    assign panel_ink = '#ffffff'
                  endif
                  assign panel_style = '--sp-panel: ' | append: accent | append: '; --sp-panel-ink: ' | append: panel_ink | append: ';'
                endif
              -%}
              <div
                class="service-paths__panel"
                {% if panel_style != blank %}
                  style="{{ panel_style | escape }}"
                {% endif %}
              >
                {%- if block.settings.title != blank -%}
                  <span class="service-paths__title">{{ block.settings.title | escape }}</span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="service-paths__caption">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- if link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p class="service-paths__hint">Add a “Service” block and pick a bundled image (e.g. DTFadvert, UploadGangsheet).</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .service-paths {
    padding-block: clamp(32px, 5vw, 64px);
  }

  .service-paths__intro {
    text-align: center;
    margin: 0 auto clamp(22px, 3vw, 40px);
    max-width: 42rem;
  }

  .service-paths__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .service-paths__subheading {
    margin: 0.45rem 0 0;
    color: #6b6b70;
  }

  .service-paths__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(16px, 2.5vw, 28px);
    grid-template-columns: 1fr;
  }

  .service-paths__item {
    display: flex;
  }

  .service-paths__card {
    display: flex;
    flex-direction: column;
    flex: 1;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    background: #0b0b0d;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  a.service-paths__card:is(:hover, :focus-visible) {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
  }

  a.service-paths__card:focus-visible {
    outline: 2px solid #19d3e6;
    outline-offset: 3px;
  }

  .service-paths__img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .service-paths__panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    aspect-ratio: 3 / 2;
    padding: clamp(24px, 4vw, 40px) 22px;
    text-align: center;
    background: var(--sp-panel, color-mix(in srgb, var(--color-foreground) 12%, var(--color-background)));
    color: var(--sp-panel-ink, var(--color-foreground));
  }

  .service-paths__panel .service-paths__title {
    color: inherit;
  }

  .service-paths__panel .service-paths__caption {
    color: color-mix(in srgb, currentColor 72%, transparent);
  }

  .service-paths__text {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 16px;
    row-gap: 2px;
    margin-top: auto;
    padding: 16px 18px;
    background: #0b0b0d;
    color: #fff;
  }

  .service-paths__title {
    font-family: var(--font-heading--family);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 1.15rem;
  }

  .service-paths__caption {
    color: #c9c9cf;
    font-size: 0.95rem;
  }

  .service-paths__go {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-family: var(--font-heading--family);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #f5b301;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-paths__card {
      transition: none;
    }

    a.service-paths__card:is(:hover, :focus-visible) {
      transform: none;
    }
  }

  .service-paths__hint {
    text-align: center;
    opacity: 0.7;
  }

  @media screen and (min-width: 750px) {
    .service-paths__grid {
      grid-template-columns: repeat(var(--sp-columns, 2), 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Service paths",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What we print"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Custom DTF transfers and gang sheets, printed in-house and ready next day."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "select",
          "id": "image",
          "label": "Image",
          "options": [
            { "value": "", "label": "None (text card)" },
            { "value": "DTFadvert.png", "label": "DTF advert" },
            { "value": "UploadGangsheet.png", "label": "Upload gang sheet" },
            { "value": "ad.png", "label": "Made in LA (ad)" },
            { "value": "splash.png", "label": "DTF Transfers – LA (splash)" },
            { "value": "splash2.png", "label": "DTF Transfers – South Bay (splash2)" }
          ],
          "default": "DTFadvert.png"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Upload your transfer"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Caption",
          "default": "Custom sizes, ready next day"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "accent_color",
          "label": "Accent color",
          "info": "Panel background when no image is set. Leave blank for a neutral panel."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service paths",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "image": "DTFadvert.png",
            "title": "Upload your transfer",
            "text": "Custom sizes, ready next day"
          }
        },
        {
          "type": "service",
          "settings": {
            "image": "UploadGangsheet.png",
            "title": "Build a gang sheet",
            "text": "Fit more designs per sheet"
          }
        }
      ]
    }
  ]
}
{% endschema %}
