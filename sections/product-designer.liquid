{%- comment -%}
  PRINT Status – vinyl sheet studio.
  Customers print a sheet of vinyl: pick color or white ink, pick a sheet
  size, upload artwork or add text, then download the print file.
  Library vendored at assets/fabric.min.js.
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product
  assign variant_id = ''
  if product != blank
    assign variant_id = product.selected_or_first_available_variant.id
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div id="design-studio" class="section section--page-width color-{{ section.settings.color_scheme }} designer" data-designer>
  {%- if section.settings.heading != blank -%}
    <h2 class="designer__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}
    <div class="designer__intro rte">{{ section.settings.intro }}</div>
  {%- endif -%}

  <div class="designer__layout">
    <div class="designer__stage">
      <canvas data-designer-canvas width="360" height="392"></canvas>
      <p class="designer__sheet-label" data-designer-sheet-label>22×24 in · Color vinyl</p>
    </div>

    <div class="designer__panel">
      <span id="design-build"></span>
      <span id="design-upload"></span>
      <span id="design-white"></span>
      <span id="design-color"></span>
      <span id="design-vinyl"></span>
      <span id="design-dtf"></span>
      <span id="design-gang"></span>
      <div class="designer__group">
        <span class="designer__label">1. What you need</span>
        <div class="designer__choices designer__choices--stack">
          <button type="button" class="designer__choice is-selected" data-ink="build">Build a sheet</button>
          <button type="button" class="designer__choice" data-ink="upload">Upload a finished sheet</button>
          <button type="button" class="designer__choice" data-ink="white">White ink only</button>
        </div>
        <select data-designer-kind class="designer__select" hidden>
          <option value="build">Build a sheet</option>
          <option value="upload">Upload a finished sheet</option>
          <option value="white">White ink only</option>
        </select>
      </div>

      <div class="designer__group">
        <span class="designer__label">2. Sheet and timing</span>
        <select data-designer-size class="designer__select"></select>
        <div class="designer__choices">
          <button type="button" class="designer__choice is-selected" data-turn="normal">Next day</button>
          <button type="button" class="designer__choice" data-turn="rush">Rush, same day</button>
        </div>
        <p class="designer__price" data-designer-price></p>
        <p class="designer__hint">Every sheet is 22 inches wide. Next day means order by 3 PM. Rush means order by noon, ready by 4 PM.</p>
      </div>

      <div class="designer__group">
        <span class="designer__label">3. Artwork</span>
        <label class="button button-secondary designer__file">
          Upload image
          <input type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" data-designer-upload hidden>
        </label>
      </div>

      <div class="designer__group">
        <span class="designer__label">Text</span>
        <div class="designer__row">
          <input type="text" class="designer__text-input" data-designer-text placeholder="Your text" maxlength="60">
          <button type="button" class="button button-secondary" data-designer-add-text>Add</button>
        </div>
        <div class="designer__row designer__row--wrap">
          <select class="designer__select designer__select--sm" data-designer-font>
            <option value="Arial, sans-serif">Arial</option>
            <option value="Impact, sans-serif">Impact</option>
            <option value="Georgia, serif">Georgia</option>
            <option value="'Courier New', monospace">Courier</option>
            <option value="'Big Shoulders Display', sans-serif">Big Shoulders</option>
          </select>
          <input type="color" value="#111111" data-designer-color title="Text color" class="designer__color">
          <button type="button" class="button button-secondary designer__btn-sm" data-designer-bold>B</button>
        </div>
      </div>

      <div class="designer__group designer__row designer__row--wrap">
        <button type="button" class="button button-secondary designer__btn-sm" data-designer-duplicate>Duplicate</button>
        <button type="button" class="button button-secondary designer__btn-sm" data-designer-arrange>Auto-arrange</button>
        <button type="button" class="button button-secondary designer__btn-sm" data-designer-delete>Delete</button>
        <button type="button" class="button button-secondary designer__btn-sm" data-designer-clear>Clear</button>
      </div>

      <div class="designer__group">
        <button type="button" class="button designer__download" data-designer-download>Download print file</button>
        {%- if variant_id != blank -%}
          <button type="button" class="button designer__add" data-designer-add-cart data-variant="{{ variant_id }}">
            Add to cart
          </button>
        {%- else -%}
          <p class="designer__hint">Download the sheet. Checkout turns on after this design is tied to a product.</p>
        {%- endif -%}
        <p class="designer__status" data-designer-status aria-live="polite"></p>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'fabric.min.js' | asset_url }}" defer></script>
<script>
(() => {
  const root = document.currentScript.closest('[data-designer]') || document.querySelector('[data-designer]');
  if (!root) return;
  const canvasEl = root.querySelector('[data-designer-canvas]');
  const status = root.querySelector('[data-designer-status]');
  const say = (m) => { if (status) status.textContent = m; };

  const money = (n) => `$${Number(n).toFixed(2)}`;
  const sizes = [
    { label: '22×12', w: 22, h: 12, build: [4.99, 5.99], upload: [4.99, 5.99], white: [4.99, 6.99] },
    { label: '22×24', w: 22, h: 24, build: [9.99, 11.99], upload: [9.99, 11.99], white: [7.99, 11.99] },
    { label: '22×36', w: 22, h: 36, build: [14.99, 17.99], upload: [14.99, 17.99], white: [11.99, 17.99] },
    { label: '22×48', w: 22, h: 48, build: [19.99, 23.99], upload: [19.99, 27.99], white: [15.99, 23.99] },
    { label: '22×60', w: 22, h: 60, build: [24.99, 29.99], upload: [24.99, 34.99], white: [19.99, 29.99] },
    { label: '22×72', w: 22, h: 72, build: [29.99, 35.99], upload: [29.99, 35.99], white: [23.99, 35.99] },
    { label: '22×90', w: 22, h: 90, build: [37.49, 44.99], upload: [37.49, 44.99], white: [29.99, 44.99] },
    { label: '22×108', w: 22, h: 108, build: [44.99, 53.99], upload: [39.99, 55.99], white: [35.99, 53.99] },
    { label: '22×120', w: 22, h: 120, build: [49.99, 59.99], upload: [42.99, 59.99], white: [39.99, 59.99] },
    { label: '22×144', w: 22, h: 144, build: [59.99, 71.99], upload: [59.99, 71.99], white: [47.99, 71.99] },
  ];
  const inks = {
    build: { canvas: '#ffffff', text: '#111111' },
    upload: { canvas: '#ffffff', text: '#111111' },
    white: { canvas: '#141416', text: '#ffffff' },
  };
  let turnaround = 'normal';
  const inkFromHash = (raw) => {
    if (raw === 'white') return 'white';
    if (raw === 'upload') return 'upload';
    if (raw === 'build' || raw === 'color' || raw === 'vinyl' || raw === 'dtf' || raw === 'gang') return 'build';
    return '';
  };

  function start() {
    if (typeof fabric === 'undefined') { setTimeout(start, 120); return; }
    const canvas = new fabric.Canvas(canvasEl, {
      backgroundColor: {{ section.settings.canvas_bg | json }},
      preserveObjectStacking: true,
    });

    const sizeSel = root.querySelector('[data-designer-size]');
    const kindSel = root.querySelector('[data-designer-kind]');
    const colorInput = root.querySelector('[data-designer-color]');
    const sheetLabel = root.querySelector('[data-designer-sheet-label]');
    const priceEl = root.querySelector('[data-designer-price]');
    const modeName = () => ({ build: 'Build a sheet', upload: 'Finished sheet', white: 'White ink' }[kindSel.value] || 'Build a sheet');
    function priceFor(s) {
      const table = s[kindSel.value] || s.build;
      return table[turnaround === 'rush' ? 1 : 0];
    }
    function fillSizes() {
      const keep = sizeSel.value;
      sizeSel.replaceChildren();
      sizes.forEach((s, i) => {
        const o = document.createElement('option');
        o.value = i;
        o.textContent = `${s.label} in · ${money(priceFor(s))}`;
        sizeSel.appendChild(o);
      });
      if (sizeSel.options[keep]) sizeSel.value = String(keep);
    }
    function markChoices() {
      root.querySelectorAll('[data-ink]').forEach((b) => {
        b.classList.toggle('is-selected', b.dataset.ink === kindSel.value);
      });
      root.querySelectorAll('[data-turn]').forEach((b) => {
        b.classList.toggle('is-selected', b.dataset.turn === turnaround);
      });
    }
    function applySize(idx) {
      const s = sizes[idx] || sizes[0];
      const ink = inks[kindSel.value] || inks.build;
      const stage = root.querySelector('.designer__stage');
      const maxW = Math.max(220, stage.clientWidth - 28);
      const maxH = Math.min(640, Math.round(window.innerHeight * 0.62));
      const ratio = s.h / s.w;
      let w = maxW;
      let h = Math.round(w * ratio);
      if (h > maxH) {
        h = maxH;
        w = Math.max(160, Math.round(h / ratio));
      }
      const prevW = canvas.getWidth();
      canvas.setWidth(w);
      canvas.setHeight(h);
      if (prevW && prevW !== w) {
        const scale = w / prevW;
        canvas.getObjects().forEach((o) => {
          o.scaleX *= scale;
          o.scaleY *= scale;
          o.left *= scale;
          o.top *= scale;
          o.setCoords();
        });
      }
      canvas.backgroundColor = ink.canvas;
      canvas.renderAll();
      canvas._psSize = s;
      canvas._psKind = kindSel.value;
      if (sheetLabel) sheetLabel.textContent = `${s.label} in · ${modeName()}`;
      if (priceEl) priceEl.textContent = `${money(priceFor(s))} · ${turnaround === 'rush' ? 'rush, same day' : 'next day'}`;
      markChoices();
    }
    function setKind(kind) {
      kind = inks[kind] ? kind : 'build';
      const keep = sizeSel.options.length ? (+sizeSel.value || 1) : 1;
      kindSel.value = kind;
      colorInput.value = inks[kind].text;
      fillSizes();
      if (sizeSel.options[keep]) sizeSel.value = String(keep);
      applySize(keep);
    }
    kindSel.addEventListener('change', () => setKind(kindSel.value));
    root.querySelectorAll('[data-ink]').forEach((b) => {
      b.addEventListener('click', () => setKind(b.dataset.ink));
    });
    sizeSel.addEventListener('change', () => applySize(+sizeSel.value));
    root.querySelectorAll('[data-turn]').forEach((b) => {
      b.addEventListener('click', () => {
        turnaround = b.dataset.turn;
        fillSizes();
        applySize(+sizeSel.value || 0);
      });
    });
    const hashKind = () => inkFromHash((location.hash || '').replace('#design-', ''));
    setKind(hashKind() || 'build');
    window.addEventListener('hashchange', () => {
      const next = hashKind();
      if (next) setKind(next);
    });

    // Upload artwork
    root.querySelector('[data-designer-upload]').addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        fabric.Image.fromURL(ev.target.result, (img) => {
          const s = canvas._psSize || sizes[1];
          const fitSheet = kindSel.value === 'upload';
          const targetIn = fitSheet ? s.w - 0.6 : Math.min(8, s.w * 0.45);
          const targetPx = (targetIn / s.w) * canvas.getWidth();
          const scale = Math.min(targetPx / img.width, (canvas.getHeight() * (fitSheet ? 0.92 : 0.7)) / img.height);
          img.set({ left: canvas.getWidth() / 2, top: canvas.getHeight() / 2, originX: 'center', originY: 'center' });
          img.scale(scale);
          canvas.add(img).setActiveObject(img);
          canvas.renderAll();
          const inches = (img.getScaledWidth() / canvas.getWidth()) * s.w;
          const dpi = Math.round(img.width / Math.max(inches, 0.1));
          const quality = dpi >= 300 ? 'print-ready' : dpi >= 200 ? 'acceptable' : 'too soft for print';
          say(`Artwork added, about ${dpi} DPI (${quality}).`);
        }, { crossOrigin: 'anonymous' });
      };
      reader.readAsDataURL(file);
    });

    // Add text
    const textInput = root.querySelector('[data-designer-text]');
    const fontSel = root.querySelector('[data-designer-font]');
    root.querySelector('[data-designer-add-text]').addEventListener('click', () => {
      const val = (textInput.value || '').trim();
      if (!val) { say('Type some text first.'); return; }
      const t = new fabric.IText(val, {
        left: canvas.getWidth() / 2, top: canvas.getHeight() / 2,
        originX: 'center', originY: 'center',
        fontFamily: fontSel.value, fill: colorInput.value, fontSize: Math.round(canvas.getWidth() / 10),
      });
      canvas.add(t).setActiveObject(t);
      canvas.renderAll();
      textInput.value = '';
    });
    colorInput.addEventListener('input', () => {
      const o = canvas.getActiveObject();
      if (o && o.set) { o.set('fill', colorInput.value); canvas.renderAll(); }
    });
    fontSel.addEventListener('change', () => {
      const o = canvas.getActiveObject();
      if (o && o.type === 'i-text') { o.set('fontFamily', fontSel.value); canvas.renderAll(); }
    });
    root.querySelector('[data-designer-bold]').addEventListener('click', () => {
      const o = canvas.getActiveObject();
      if (o && o.type === 'i-text') { o.set('fontWeight', o.fontWeight === 'bold' ? 'normal' : 'bold'); canvas.renderAll(); }
    });
    root.querySelector('[data-designer-delete]').addEventListener('click', () => {
      const o = canvas.getActiveObject();
      if (o) { canvas.remove(o); canvas.renderAll(); }
    });
    root.querySelector('[data-designer-clear]').addEventListener('click', () => {
      canvas.getObjects().slice().forEach(o => canvas.remove(o));
      canvas.renderAll(); say('Cleared.');
    });
    root.querySelector('[data-designer-duplicate]').addEventListener('click', () => {
      const o = canvas.getActiveObject();
      if (!o) { say('Select a design first.'); return; }
      o.clone((clone) => {
        clone.set({ left: (o.left || 0) + 18, top: (o.top || 0) + 18 });
        canvas.add(clone).setActiveObject(clone);
        canvas.renderAll();
        say('Duplicated.');
      });
    });
    root.querySelector('[data-designer-arrange]').addEventListener('click', () => {
      const objs = canvas.getObjects();
      if (!objs.length) { say('Add artwork first.'); return; }
      const s = canvas._psSize || sizes[1];
      const gap = canvas.getWidth() * (0.25 / s.w);
      const margin = canvas.getWidth() * (0.3 / s.w);
      let x = margin;
      let y = margin;
      let rowH = 0;
      objs.forEach((o) => {
        const w = o.getScaledWidth();
        const h = o.getScaledHeight();
        if (x + w > canvas.getWidth() - margin && x > margin) {
          x = margin;
          y += rowH + gap;
          rowH = 0;
        }
        o.set({ left: x + w / 2, top: y + h / 2, originX: 'center', originY: 'center' });
        o.setCoords();
        x += w + gap;
        rowH = Math.max(rowH, h);
      });
      canvas.renderAll();
      say(y + rowH > canvas.getHeight() - margin
        ? 'Some designs hang off the sheet. Choose a longer sheet or make them smaller.'
        : 'Arranged on the sheet with a small gap.');
    });

    root.querySelector('[data-designer-download]').addEventListener('click', () => {
      if (canvas.getObjects().length === 0) { say('Add artwork or text first.'); return; }
      const s = canvas._psSize || sizes[0];
      const kind = canvas._psKind || 'dtf';
      const dataUrl = canvas.toDataURL({ format: 'png', multiplier: 3 });
      const a = document.createElement('a');
      a.href = dataUrl;
      a.download = `print-status-vinyl-${kind}-${s.w}x${s.h}.png`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      say(`Downloaded a ${kind} vinyl sheet, ${s.w}×${s.h} in.`);
    });

    // Add to cart with the composed PNG attached as a file line-item property
    const addBtn = root.querySelector('[data-designer-add-cart]');
    if (addBtn) addBtn.addEventListener('click', async () => {
      if (canvas.getObjects().length === 0) { say('Add artwork or text first.'); return; }
      try {
        say('Preparing your design…');
        addBtn.disabled = true;
        const dataUrl = canvas.toDataURL({ format: 'png', multiplier: 3 });
        const blob = await (await fetch(dataUrl)).blob();
        const file = new File([blob], 'custom-design.png', { type: 'image/png' });
        const texts = canvas.getObjects().filter(o => o.type === 'i-text').map(o => o.text).join(' | ');
        const s = canvas._psSize || sizes[0];
        const fd = new FormData();
        fd.append('id', addBtn.dataset.variant);
        fd.append('quantity', '1');
        fd.append('properties[Size]', `${s.label} (${s.w}×${s.h} in)`);
        if (texts) fd.append('properties[Text]', texts);
        fd.append('properties[Artwork]', file, 'custom-design.png');
        const res = await fetch('/cart/add.js', { method: 'POST', body: fd });
        if (!res.ok) throw new Error('cart ' + res.status);
        say('Added to cart. Taking you there…');
        window.location.href = '/cart';
      } catch (err) {
        addBtn.disabled = false;
        say('Could not add to cart. Please try again.');
      }
    });

    window.addEventListener('resize', () => applySize(+sizeSel.value));
    say('Ready. Upload artwork or add text.');
  }
  start();
})();
</script>

{% stylesheet %}
  .designer { padding-block: clamp(28px, 5vw, 56px); }
  .designer__heading { text-align: center; margin: 0 0 8px; }
  .designer__intro { text-align: center; max-width: 60ch; margin: 0 auto clamp(20px, 3vw, 32px); opacity: .8; }
  .designer__layout { display: grid; gap: clamp(16px, 3vw, 32px); grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 850px) { .designer__layout { grid-template-columns: minmax(0,1fr) minmax(240px, 300px); } }
  .designer__stage {
    background: repeating-conic-gradient(#f3f3f5 0% 25%, #fff 0% 50%) 50% / 24px 24px;
    border: 1px solid var(--color-border, #e3e3e6); border-radius: 14px; padding: 16px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: 420px; overflow: hidden;
  }
  .designer__stage .canvas-container { max-width: 100%; }
  .designer__stage canvas { box-shadow: 0 6px 20px rgba(0,0,0,.18); }
  .designer__sheet-label {
    margin: 12px 0 0; font-family: var(--font-heading--family); font-weight: 700;
    letter-spacing: .04em; text-transform: uppercase;
  }
  .designer__panel { display: flex; flex-direction: column; gap: 18px; }
  @media (min-width: 850px) {
    .designer__panel { position: sticky; top: 96px; }
  }
  .designer__choices { display: flex; flex-wrap: wrap; gap: 8px; }
  .designer__choice {
    flex: 1; min-width: 72px; padding: 10px 8px; border: 2px solid #d9d9de; border-radius: 10px;
    background: #fff; font-weight: 700; cursor: pointer;
  }
  .designer__choice.is-selected { border-color: #ff2d9b; background: #fff0f7; }
  .designer__choices--stack { flex-direction: column; }
  .designer__choices--stack .designer__choice { width: 100%; text-align: left; }
  .designer__price {
    margin: 0; font-family: var(--font-heading--family); font-size: 1.35rem; font-weight: 700;
  }
  .designer__group { display: flex; flex-direction: column; gap: 8px; }
  .designer__label { font-weight: 600; font-size: .85rem; letter-spacing: .03em; text-transform: uppercase; opacity: .7; }
  .designer__row { display: flex; gap: 8px; align-items: center; }
  .designer__row--wrap { flex-wrap: wrap; }
  .designer__select, .designer__text-input { padding: 9px 10px; border: 1px solid var(--color-border, #d9d9de); border-radius: 10px; background: #fff; }
  .designer__select { width: 100%; }
  .designer__select--sm { flex: 1; min-width: 120px; }
  .designer__text-input { flex: 1; }
  .designer__color { width: 40px; height: 40px; border: none; background: none; padding: 0; cursor: pointer; }
  .designer__file { cursor: pointer; text-align: center; }
  .designer__btn-sm { padding: 8px 12px; }
  .designer__download,
  .designer__add { width: 100%; }
  .designer .designer__download {
    background: #ff2d9b;
    color: #fff;
    border: 2px solid #ff2d9b;
    font-family: var(--font-heading--family);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .designer__hint, .designer__status { font-size: .85rem; opacity: .7; margin: 4px 0 0; min-height: 1.2em; }
{% endstylesheet %}

{% schema %}
{
  "name": "Design studio",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Design your vinyl sheet" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "product", "id": "product", "label": "Custom-transfer product", "info": "The product this design is added to the cart as." },
    {
      "type": "textarea", "id": "sizes", "label": "Transfer sizes",
      "info": "One per line: Label|widthIn|heightIn",
      "default": "Small|4|4\nMedium|8|10\nLarge|11|17\nGang sheet|22|24"
    },
    { "type": "color", "id": "canvas_bg", "label": "Canvas background", "default": "#ffffff" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [ { "name": "Design studio" } ]
}
{% endschema %}
