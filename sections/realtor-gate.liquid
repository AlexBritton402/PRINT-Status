{%- comment -%}
  PRINT Status – Realtor catalog gate.
  Verified customers (tag realtor-verified) see nothing here so the rest
  of the template renders. Everyone else sees an apply panel; sibling
  sections are hidden the same way company-hero hides the empty grid.
{%- endcomment -%}

{%- liquid
  assign verified = false
  if customer and customer.tags contains 'realtor-verified'
    assign verified = true
  endif
-%}

{% render 'noindex' %}
{%- unless verified -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div class="section color-{{ section.settings.color_scheme }} section--page-width">
    <div class="realtor-gate">
      <h2 class="realtor-gate__heading">{{ section.settings.heading | escape }}</h2>
      <div class="realtor-gate__message">{{ section.settings.message }}</div>
      {%- if section.settings.apply_link != blank -%}
        <a class="button" href="{{ section.settings.apply_link }}">{{ section.settings.apply_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
  <style>#shopify-section-{{ section.id }} ~ .shopify-section { display: none !important; }</style>
{%- endunless -%}

{% stylesheet %}
  .realtor-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    padding-block: clamp(32px, 5vw, 64px);
  }

  .realtor-gate__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 700);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1;
  }

  .realtor-gate__message {
    margin: 0;
    max-width: 60ch;
  }

  .realtor-gate__message :is(p) {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Realtor gate",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Message"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Realtor access required"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>This catalog is for verified realtors. Apply for access and we'll review your DRE license.</p>"
    },
    {
      "type": "text",
      "id": "apply_label",
      "label": "Button label",
      "default": "Apply for realtor access"
    },
    {
      "type": "url",
      "id": "apply_link",
      "label": "Apply page link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Realtor gate"
    }
  ]
}
{% endschema %}
