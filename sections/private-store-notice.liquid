{%- comment -%}
  Private-store landing for leftover public URLs such as /pages/organizations.
  Company stores are reached by private link only. This page must not list them.
{%- endcomment -%}
{% render 'noindex' %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }} private-store-notice">
  <h1 class="private-store-notice__title">{{ section.settings.heading | escape }}</h1>
  {%- if section.settings.body != blank -%}
    <div class="private-store-notice__body">{{ section.settings.body }}</div>
  {%- endif -%}
  {%- if section.settings.button_label != blank -%}
    <p>
      <a class="button" href="{{ section.settings.button_link | default: routes.root_url }}">
        {{ section.settings.button_label | escape }}
      </a>
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .private-store-notice {
    padding-block: clamp(48px, 8vw, 96px);
    max-width: 42rem;
  }
  .private-store-notice__title {
    margin: 0 0 16px;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.05;
  }
  .private-store-notice__body {
    margin-bottom: 24px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Private store notice",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This store is private"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Company stores are not listed on the public shop. Open the private link you were given.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "PRINT Status home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Private store notice"
    }
  ]
}
{% endschema %}
