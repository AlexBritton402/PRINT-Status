{%- comment -%}
  PRINT Status sheet studio. Replaces Kixxl on Build / Upload / White.
  Size, rush, price, add-to-cart, and checkout live in the editor.
  Prices stay on the Shopify variant. The print file is a line-item property.
{%- endcomment -%}

{%- liquid
  assign product = closest.product
  assign form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign initial = product.selected_or_first_available_variant
-%}

{%- if product == blank -%}
  <p class="sheet-studio__hint" {{ block.shopify_attributes }}>Sheet studio appears on a gang-sheet product.</p>
{%- else -%}
  {%- liquid
    assign cta_label = block.settings.text_create
    assign cta_colour = block.settings.colour_create
    assign job_kind = 'Create'
    if product.title contains 'Upload'
      assign cta_label = block.settings.text_upload
      assign cta_colour = block.settings.colour_upload
      assign job_kind = 'Upload'
    endif
  -%}
  {%- capture variants_json -%}
    [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id | json }},
        "available": {{ variant.available | json }},
        "size": {{ variant.option1 | json }},
        "turnaround": {{ variant.option2 | json }},
        "price": {{ variant.price | money | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    ]
  {%- endcapture -%}

  {%- assign seen_sizes = '|' -%}
  {%- assign seen_turns = '|' -%}

  <div
    class="sheet-studio spacing-style"
    data-sheet-studio
    data-job="{{ job_kind }}"
    data-form-id="{{ form_id }}"
    data-initial-variant="{{ initial.id }}"
    data-variants="{{ variants_json | escape }}"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <div class="sheet-studio__actions">
      <button
        type="button"
        class="sheet-studio__cta"
        data-sheet-open="create"
        style="--sheet-cta: {{ cta_colour }}"
      >
        {{ cta_label | escape }}
      </button>
      <label class="sheet-studio__pick" for="SheetStudioFile-{{ block.id }}">
        <span class="sheet-studio__pick-title">Upload a PNG or JPG</span>
        <span class="sheet-studio__pick-note">Transparent PNG at 300 dpi. Opens the sheet so you can place it.</span>
      </label>
      <input
        id="SheetStudioFile-{{ block.id }}"
        class="visually-hidden"
        type="file"
        accept="image/png,image/jpeg,application/pdf,.png,.jpg,.jpeg,.pdf"
        data-sheet-file
        multiple
      >
    </div>

    <dialog class="sheet-studio__dialog" data-sheet-dialog inert aria-labelledby="SheetStudioTitle-{{ block.id }}">
      <div class="sheet-studio__chrome">
        <div class="sheet-studio__bar">
          <div>
            <p class="sheet-studio__kicker">{{ product.title | escape }}</p>
            <h2 id="SheetStudioTitle-{{ block.id }}" class="sheet-studio__title" data-sheet-title>Gang Sheet</h2>
          </div>
          <p class="sheet-studio__price" data-sheet-price></p>
          <button type="button" class="sheet-studio__icon-btn" data-sheet-close aria-label="Close sheet studio">
            Close
          </button>
        </div>

        <div class="sheet-studio__picks">
          <fieldset class="sheet-studio__fieldset">
            <legend>Size</legend>
            <div class="sheet-studio__chips" data-sheet-sizes>
              {%- for variant in product.variants -%}
                {%- assign size_token = '|' | append: variant.option1 | append: '|' -%}
                {%- unless seen_sizes contains size_token -%}
                  {%- assign seen_sizes = seen_sizes | append: variant.option1 | append: '|' -%}
                  <button type="button" class="sheet-studio__chip" data-sheet-size="{{ variant.option1 | escape }}">
                    {{ variant.option1 | escape }}
                  </button>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </fieldset>
          <fieldset class="sheet-studio__fieldset">
            <legend>Turnaround</legend>
            <div class="sheet-studio__chips" data-sheet-turns>
              {%- for variant in product.variants -%}
                {%- assign turn_token = '|' | append: variant.option2 | append: '|' -%}
                {%- unless seen_turns contains turn_token -%}
                  {%- assign seen_turns = seen_turns | append: variant.option2 | append: '|' -%}
                  {%- assign turn_short = 'Normal' -%}
                  {%- if variant.option2 contains 'Rush' -%}
                    {%- assign turn_short = 'Rush (4HR)' -%}
                  {%- endif -%}
                  <button
                    type="button"
                    class="sheet-studio__chip"
                    data-sheet-turn="{{ variant.option2 | escape }}"
                  >
                    {{ turn_short }}
                  </button>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </fieldset>
        </div>

        <div class="sheet-studio__body">
          <div class="sheet-studio__board">
            <div class="sheet-studio__ruler sheet-studio__ruler--x" data-ruler-x aria-hidden="true"></div>
            <div class="sheet-studio__ruler sheet-studio__ruler--y" data-ruler-y aria-hidden="true"></div>
            <div class="sheet-studio__stage" data-sheet-stage>
              <canvas data-sheet-canvas width="360" height="392"></canvas>
            </div>
          </div>

          <div class="sheet-studio__tools">
            <div
              class="sheet-studio__drop"
              data-sheet-drop
              role="button"
              tabindex="0"
              aria-label="Add artwork to the sheet"
            >
              <span>Drop a PNG or JPG, or click to choose files.</span>
              <span class="sheet-studio__drop-note">Transparent PNG at 300 dpi. PDF only when the file is already the full 22-inch sheet.</span>
            </div>

            <div class="sheet-studio__build" data-sheet-build-tools>
              <label class="sheet-studio__field">
                <span>Text on the sheet</span>
                <span class="sheet-studio__text-row">
                  <input type="text" maxlength="60" data-sheet-text placeholder="Optional">
                  <button type="button" class="sheet-studio__ghost" data-sheet-add-text>Add</button>
                </span>
              </label>
              <label class="sheet-studio__field sheet-studio__field--gap">
                <span>Gap between designs</span>
                <span class="sheet-studio__text-row">
                  <input type="number" min="0" max="1" step="0.01" value="0.12" data-sheet-gap>
                  <span class="sheet-studio__unit">in</span>
                </span>
              </label>
              <div class="sheet-studio__row">
                <button type="button" class="sheet-studio__ghost" data-sheet-pack>Pack</button>
                <button type="button" class="sheet-studio__ghost" data-sheet-duplicate>Duplicate</button>
                <button type="button" class="sheet-studio__ghost" data-sheet-delete>Delete</button>
                <button type="button" class="sheet-studio__ghost" data-sheet-clear>Clear</button>
              </div>
            </div>

            <p class="sheet-studio__status" data-sheet-status aria-live="polite"></p>
            <div class="sheet-studio__pay">
              <button type="button" class="sheet-studio__ghost sheet-studio__ghost--wide" data-sheet-add>
                Add to cart
              </button>
              <button type="button" class="sheet-studio__add" data-sheet-checkout>Check out</button>
            </div>
          </div>
        </div>
      </div>
    </dialog>
  </div>

  <script src="{{ 'fabric.min.js' | asset_url }}" defer></script>
  <script src="{{ 'sheet-studio.js' | asset_url }}" defer></script>
{%- endif -%}

{% stylesheet %}
  .sheet-studio {
    width: 100%;
  }

  .sheet-studio__hint {
    margin: 0;
    opacity: 0.7;
  }

  .sheet-studio__actions {
    display: grid;
    gap: 10px;
  }

  .sheet-studio__pick {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px dashed rgba(var(--color-foreground-rgb), 0.35);
    background: var(--color-background, #f7f7f5);
    cursor: pointer;
  }

  .sheet-studio__pick-title {
    font-family: var(--font-heading--family);
    font-size: 0.95rem;
  }

  .sheet-studio__pick-note {
    color: rgba(var(--color-foreground-rgb), 0.68);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .menu-drawer__backdrop {
    pointer-events: none;
  }

  .sheet-studio__cta {
    appearance: none;
    width: 100%;
    min-height: 48px;
    padding: 12px 16px;
    border: 0;
    border-radius: 6px;
    background: var(--sheet-cta, #808080);
    color: #f7f7f5;
    font-family: var(--font-heading--family);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1), filter 140ms ease;
  }

  .sheet-studio__cta:hover {
    filter: brightness(0.94);
  }

  .sheet-studio__cta:active {
    transform: scale(0.97);
  }

  .sheet-studio__drop-note,
  .sheet-studio__kicker {
    margin: 8px 0 0;
    color: rgba(var(--color-foreground-rgb), 0.72);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .sheet-studio__dialog:not([open]) {
    display: none;
  }

  .sheet-studio__dialog {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: #efefed;
    color: var(--color-foreground);
  }

  .sheet-studio__dialog::backdrop {
    background: rgb(18 18 18 / 0.72);
  }

  .sheet-studio__chrome {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .sheet-studio__bar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    padding: 14px 20px;
    background: var(--color-background);
    border-bottom: 1px solid rgba(var(--color-foreground-rgb), 0.12);
  }

  .sheet-studio__title {
    margin: 2px 0 0;
    font-family: var(--font-heading--family);
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .sheet-studio__kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
  }

  .sheet-studio__price {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.15rem;
    white-space: nowrap;
  }

  .sheet-studio__picks {
    display: grid;
    gap: 10px;
    padding: 10px 20px 12px;
    background: var(--color-background);
    border-bottom: 1px solid rgba(var(--color-foreground-rgb), 0.08);
  }

  .sheet-studio__fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .sheet-studio__fieldset legend {
    padding: 0;
    margin-bottom: 6px;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground-rgb), 0.62);
  }

  .sheet-studio__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .sheet-studio__chip {
    appearance: none;
    min-height: 36px;
    padding: 6px 12px;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.2);
    border-radius: 999px;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 140ms ease, border-color 140ms ease, color 140ms ease;
  }

  .sheet-studio__chip.is-on {
    background: #121212;
    border-color: #121212;
    color: #f7f7f5;
  }

  .sheet-studio__chip:active {
    transform: scale(0.97);
  }

  .sheet-studio__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    padding: 16px 20px 20px;
    min-height: 0;
    overflow: auto;
    flex: 1 1 auto;
  }

  @media (min-width: 960px) {
    .sheet-studio__body {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 320px);
      align-items: stretch;
      overflow: hidden;
    }

    .sheet-studio__tools {
      overflow: auto;
    }
  }

  .sheet-studio__board {
    position: relative;
    min-height: 320px;
    padding: 22px 12px 12px 28px;
    background: #d8d8d4;
  }

  .sheet-studio__ruler {
    position: absolute;
    color: rgba(18, 18, 18, 0.55);
    font-size: 10px;
    pointer-events: none;
  }

  .sheet-studio__ruler--x {
    top: 4px;
    left: 28px;
    right: 12px;
    height: 16px;
  }

  .sheet-studio__ruler--y {
    top: 22px;
    left: 4px;
    bottom: 12px;
    width: 22px;
  }

  .sheet-studio__tick {
    position: absolute;
    line-height: 1;
  }

  .sheet-studio__ruler--x .sheet-studio__tick {
    top: 0;
    transform: translateX(-50%);
  }

  .sheet-studio__ruler--y .sheet-studio__tick {
    left: 0;
    transform: translateY(-50%);
  }

  .sheet-studio__stage {
    background-image:
      linear-gradient(45deg, #d0d0cc 25%, transparent 25%),
      linear-gradient(-45deg, #d0d0cc 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #d0d0cc 75%),
      linear-gradient(-45deg, transparent 75%, #d0d0cc 75%);
    background-size: 16px 16px;
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    background-color: #f6f6f3;
    border: 1px solid rgba(18, 18, 18, 0.18);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 280px;
    height: 100%;
    padding: 0;
  }

  .sheet-studio__stage canvas {
    display: block;
    max-width: 100%;
    background: transparent;
  }

  .sheet-studio__tools {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 4px 0 8px;
  }

  .sheet-studio__drop {
    display: grid;
    gap: 4px;
    padding: 18px 16px;
    border: 1px dashed rgba(var(--color-foreground-rgb), 0.28);
    background: var(--color-background);
    cursor: pointer;
  }

  .sheet-studio__drop.is-over {
    border-color: rgba(var(--color-foreground-rgb), 0.6);
  }

  .sheet-studio__field,
  .sheet-studio__field span {
    display: grid;
    gap: 6px;
  }

  .sheet-studio__field--gap {
    max-width: 140px;
  }

  .sheet-studio__unit {
    align-self: center;
    color: rgba(var(--color-foreground-rgb), 0.62);
  }

  .sheet-studio__text-row,
  .sheet-studio__row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sheet-studio__text-row input {
    flex: 1 1 140px;
    min-height: 40px;
    padding: 8px 10px;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.2);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .sheet-studio__ghost,
  .sheet-studio__icon-btn {
    appearance: none;
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.22);
    background: var(--color-background);
    color: var(--color-foreground);
    cursor: pointer;
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .sheet-studio__ghost--wide,
  .sheet-studio__add {
    min-height: 48px;
    width: 100%;
  }

  .sheet-studio__ghost:active,
  .sheet-studio__icon-btn:active,
  .sheet-studio__add:active {
    transform: scale(0.97);
  }

  .sheet-studio__pay {
    display: grid;
    gap: 8px;
    position: sticky;
    bottom: 0;
    padding-top: 8px;
    background: #efefed;
  }

  .sheet-studio__add {
    appearance: none;
    border: 0;
    background: var(--color-primary-button-background, #121212);
    color: var(--color-primary-button-text, #f7f7f5);
    font-family: var(--font-heading--family);
    cursor: pointer;
  }

  .sheet-studio__add:disabled,
  .sheet-studio__ghost:disabled {
    opacity: 0.55;
    cursor: wait;
  }

  .sheet-studio__status {
    min-height: 2.6em;
    margin: 0;
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet-studio__cta,
    .sheet-studio__ghost,
    .sheet-studio__icon-btn,
    .sheet-studio__add,
    .sheet-studio__chip {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sheet studio",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text_create",
      "label": "Create button",
      "default": "Create a Gang Sheet"
    },
    {
      "type": "color",
      "id": "colour_create",
      "label": "Create color",
      "default": "#808080"
    },
    {
      "type": "text",
      "id": "text_upload",
      "label": "Upload button",
      "default": "Upload a Gang Sheet"
    },
    {
      "type": "color",
      "id": "colour_upload",
      "label": "Upload color",
      "default": "#008656"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Sheet studio",
      "category": "Product"
    }
  ]
}
{% endschema %}
