{%- comment -%}
  HUMC Gear purchase options. Color mockups are theme assets (humc-m-*.jpg).
  Inputs attach to Horizon buy-buttons with the HTML form= attribute.
  Line item properties land on the order.
{%- endcomment -%}

{%- liquid
  assign product_resource = closest.product
  assign title = product_resource.title | default: ''
  assign title_l = title | downcase
  assign form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign handle_tail = product_resource.handle | split: '-' | last

  assign needs_size = true
  if title_l contains 'hat' or title_l contains 'bag' or title_l contains 'tumbler' or title_l contains 'tote' or title_l contains 'cap' or title_l contains 'duffle' or title_l contains 'duffel'
    assign needs_size = false
  endif

  assign default_logo = 'As shown'
  if title contains 'Single Color'
    assign default_logo = 'Single-color HUMC'
  elsif title contains 'Standard HUMC'
    assign default_logo = 'Standard HUMC'
  elsif title contains 'LA County'
    assign default_logo = 'LA County'
  elsif title_l contains '1/4 zip' or title_l contains 'trucker' or title_l contains 'otto' or title_l contains 'canvas' or title_l contains 'jumbo'
    assign default_logo = 'Standard HUMC'
  endif

  assign default_front = true
  assign default_back = false
  assign default_left = false
  assign default_right = false
  if title_l contains 'front and back'
    assign default_back = true
  endif
  if title_l contains 'sleeve'
    assign default_left = true
  endif

  assign sizes = 'S,M,L,XL,2XL,3XL,4XL,5XL' | split: ','

  assign family_phrase = ''
  if title_l contains 'heavyweight tee'
    assign family_phrase = 'heavyweight tee'
  elsif title_l contains 'drop shoulder'
    assign family_phrase = 'drop shoulder hoodie'
  elsif title_l contains 'sustainable'
    assign family_phrase = 'sustainable full zip hoodie'
  elsif title_l contains 'full zip hoodie'
    assign family_phrase = 'full zip hoodie'
  elsif title_l contains '1/4 zip'
    assign family_phrase = '1/4 zip fleece'
  elsif title_l contains 'fleece crew'
    assign family_phrase = 'fleece crew'
  elsif title_l contains 'women' and title_l contains 'soft blend'
    assign family_phrase = 'soft blend tee'
  elsif title_l contains 'soft blend tee'
    assign family_phrase = 'unisex soft blend tee'
  elsif title_l contains 'trucker' or title_l contains 'snapback'
    assign family_phrase = 'trucker hat'
  elsif title_l contains 'canvas bag' or title_l contains 'jumbo'
    assign family_phrase = 'jumbo canvas bag'
  elsif title_l contains 'tumbler'
    assign family_phrase = 'tumbler'
  endif

  assign humc_col = collections['humc-gear']
  assign preview_q = ''
  if theme.id == 189047013667
    assign preview_q = '?preview_theme_id=189047013667'
  endif
-%}

{%- unless title_l contains 'personalization' -%}
<div
  class="humc-customize spacing-style"
  data-humc-customize
  data-form-id="{{ form_id }}"
  data-needs-size="{% if needs_size %}true{% else %}false{% endif %}"
  data-product-title="{{ title | escape }}"
  data-product-handle="{{ product_resource.handle | escape }}"
  data-logo-name="{{ default_logo | escape }}"
  data-source-id="{{ handle_tail | escape }}"
  data-family="{{ family_phrase | escape }}"
  data-preview-map="{{ 'humc-preview.json' | asset_url }}"
  data-asset-base="{{ 'humc-preview.json' | asset_url | split: 'humc-preview.json' | first }}"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  <fieldset class="humc-customize__set" data-color-set>
    <legend>Color</legend>
    <p class="humc-customize__color-name" data-color-name></p>
    <div class="humc-customize__swatches" data-swatches role="list"></div>
    <input type="hidden" name="properties[Store]" form="{{ form_id }}" value="HUMC Gear">
    <input type="hidden" name="properties[Color]" form="{{ form_id }}" value="">
  </fieldset>

  {%- if needs_size -%}
    <fieldset class="humc-customize__set">
      <legend>Size</legend>
      <div class="humc-customize__chips" role="list">
        {%- for size in sizes -%}
          <button
            type="button"
            class="humc-customize__chip"
            data-field="size"
            data-value="{{ size | escape }}"
            aria-pressed="false"
          >
            {{ size | escape }}
          </button>
        {%- endfor -%}
      </div>
      <input type="hidden" name="properties[Size]" form="{{ form_id }}" value="">
    </fieldset>
  {%- else -%}
    <input type="hidden" name="properties[Size]" form="{{ form_id }}" value="One size">
  {%- endif -%}

  <fieldset class="humc-customize__set" data-logo-set>
    <legend>Set Image</legend>
    <div class="humc-customize__logos" data-logos>
      {%- assign mark_list = 'Standard HUMC,Single-color HUMC,LA County' | split: ',' -%}
      {%- for mark_raw in mark_list -%}
        {%- assign mark = mark_raw | strip -%}
        {%- assign pick_title = title -%}
        {%- assign pick_variant = product_resource.selected_or_first_available_variant.id -%}
        {%- assign pick_tail = handle_tail -%}
        {%- assign pick_found = false -%}
        {%- if mark == default_logo -%}
          {%- assign pick_found = true -%}
        {%- endif -%}
        {%- if family_phrase != blank and humc_col -%}
          {%- for sibling in humc_col.products -%}
            {%- assign sib_l = sibling.title | downcase -%}
            {%- assign same_family = false -%}
            {%- if sib_l contains family_phrase -%}
              {%- assign same_family = true -%}
            {%- endif -%}
            {%- if title_l contains 'women' -%}
              {%- unless sib_l contains 'women' -%}
                {%- assign same_family = false -%}
              {%- endunless -%}
            {%- elsif sib_l contains 'women' -%}
              {%- assign same_family = false -%}
            {%- endif -%}
            {%- if same_family -%}
              {%- assign sib_logo = '' -%}
              {%- if sibling.title contains 'Single Color' -%}
                {%- assign sib_logo = 'Single-color HUMC' -%}
              {%- elsif sibling.title contains 'Standard HUMC' -%}
                {%- assign sib_logo = 'Standard HUMC' -%}
              {%- elsif sibling.title contains 'LA County' -%}
                {%- assign sib_logo = 'LA County' -%}
              {%- endif -%}
              {%- if sib_logo == mark -%}
                {%- assign pick_title = sibling.title -%}
                {%- assign pick_variant = sibling.selected_or_first_available_variant.id -%}
                {%- assign pick_tail = sibling.handle | split: '-' | last -%}
                {%- assign pick_found = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- assign logo_sid = pick_tail -%}
        {%- assign mark_overlay = '' -%}
        {%- if mark == 'Standard HUMC' -%}
          {%- assign mark_overlay = 'humc-crest-standard.png' | asset_url -%}
        {%- elsif mark == 'Single-color HUMC' -%}
          {%- assign mark_overlay = 'humc-crest-single.png' | asset_url -%}
        {%- elsif mark == 'LA County' -%}
          {%- assign mark_overlay = 'humc-crest-la.png' | asset_url -%}
        {%- endif -%}
        {%- if family_phrase == '1/4 zip fleece' -%}
          {%- if mark == 'Standard HUMC' -%}
            {%- assign logo_sid = '18991186' -%}
          {%- elsif mark == 'Single-color HUMC' -%}
            {%- assign logo_sid = '18867111' -%}
          {%- elsif mark == 'LA County' -%}
            {%- assign logo_sid = '18993506' -%}
          {%- endif -%}
          {%- assign pick_found = true -%}
        {%- elsif family_phrase == 'trucker hat' -%}
          {%- assign logo_sid = '19193876' -%}
          {%- assign pick_found = true -%}
        {%- elsif family_phrase == 'jumbo canvas bag' -%}
          {%- if mark == 'Standard HUMC' -%}
            {%- assign logo_sid = '18416451' -%}
          {%- elsif mark == 'Single-color HUMC' -%}
            {%- assign logo_sid = '18417261' -%}
          {%- elsif mark == 'LA County' -%}
            {%- assign logo_sid = '18753436' -%}
          {%- endif -%}
          {%- assign pick_found = true -%}
        {%- endif -%}
        <button
          type="button"
          class="humc-customize__logo{% if mark == default_logo %} is-on{% endif %}"
          data-field="logo"
          data-value="{{ mark | escape }}"
          data-title="{{ pick_title | escape }}"
          data-source-id="{{ logo_sid | escape }}"
          data-overlay="{{ mark_overlay | escape }}"
          data-variant="{{ pick_variant }}"
          data-has-photo="{% if pick_found %}true{% else %}false{% endif %}"
          aria-pressed="{% if mark == default_logo %}true{% else %}false{% endif %}"
        >
          {{ mark | escape }}
        </button>
      {%- endfor -%}
      <button
        type="button"
        class="humc-customize__logo{% if default_logo == 'As shown' or default_logo == 'No logo' %} is-on{% endif %}"
        data-field="logo"
        data-value="No logo"
        data-title="{{ title | escape }}"
        data-source-id="{{ handle_tail | escape }}"
        data-has-photo="false"
        aria-pressed="{% if default_logo == 'As shown' or default_logo == 'No logo' %}true{% else %}false{% endif %}"
      >
        No logo
      </button>
    </div>
    <p class="humc-customize__hint">Pick a mark, then tap each side you want it on. No logo takes the mark off the side you are looking at.</p>
    <input type="hidden" name="properties[Logo]" form="{{ form_id }}" value="{{ default_logo | escape }}">
  </fieldset>

  <fieldset class="humc-customize__set">
    <legend>Print on each side</legend>
    <div class="humc-customize__chips" role="list">
      <button type="button" class="humc-customize__chip{% if default_front %} is-on is-focus{% endif %}" data-place="Front" aria-pressed="{% if default_front %}true{% else %}false{% endif %}">Front<span data-side-mark>{% if default_front and default_logo != 'As shown' and default_logo != 'No logo' %}HUMC{% endif %}</span></button>
      <button type="button" class="humc-customize__chip{% if default_back %} is-on{% endif %}" data-place="Back" aria-pressed="{% if default_back %}true{% else %}false{% endif %}">Back<span data-side-mark></span></button>
      {%- if needs_size -%}
        <button type="button" class="humc-customize__chip{% if default_left %} is-on{% endif %}" data-place="Left sleeve" aria-pressed="{% if default_left %}true{% else %}false{% endif %}">Left sleeve<span data-side-mark></span></button>
        <button type="button" class="humc-customize__chip{% if default_right %} is-on{% endif %}" data-place="Right sleeve" aria-pressed="{% if default_right %}true{% else %}false{% endif %}">Right sleeve<span data-side-mark></span></button>
      {%- endif -%}
    </div>
    <input type="hidden" name="properties[Print locations]" form="{{ form_id }}" value="">
    <input type="hidden" name="properties[Front]" form="{{ form_id }}" value="{% if default_front and default_logo != 'As shown' and default_logo != 'No logo' %}{{ default_logo | escape }}{% endif %}">
    <input type="hidden" name="properties[Back]" form="{{ form_id }}" value="{% if default_back and default_logo != 'As shown' and default_logo != 'No logo' %}{{ default_logo | escape }}{% endif %}">
    <input type="hidden" name="properties[Left sleeve]" form="{{ form_id }}" value="{% if default_left and default_logo != 'As shown' and default_logo != 'No logo' %}{{ default_logo | escape }}{% endif %}">
    <input type="hidden" name="properties[Right sleeve]" form="{{ form_id }}" value="{% if default_right and default_logo != 'As shown' and default_logo != 'No logo' %}{{ default_logo | escape }}{% endif %}">
    <p class="humc-customize__hint">Front, back, and both sleeves each keep their own mark. Tap a side to stamp the mark you picked.</p>
  </fieldset>

  <p class="humc-customize__summary" data-summary></p>
  <p class="humc-customize__error" data-error hidden></p>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-humc-customize')) return;

    var formId = root.getAttribute('data-form-id');
    var needsSize = root.getAttribute('data-needs-size') === 'true';
    var colorInput = root.querySelector('input[name="properties[Color]"]');
    var sizeInput = root.querySelector('input[name="properties[Size]"]');
    var logoInput = root.querySelector('input[name="properties[Logo]"]');
    var placeInput = root.querySelector('input[name="properties[Print locations]"]');
    var summary = root.querySelector('[data-summary]');
    var errorEl = root.querySelector('[data-error]');
    var swatchBox = root.querySelector('[data-swatches]');
    var colorNameEl = root.querySelector('[data-color-name]');
    var logoName = root.getAttribute('data-logo-name') || 'As shown';
    var preview = null;
    var previewMap = {};
    var currentAngle = 'Front';
    var currentColorId = '';
    var catalog = { marks: [], extraColors: [] };
    var overlayUrl = '';
    var ink = logoName === 'As shown' || logoName === 'No logo' ? 'No logo' : logoName;
    var activePlace = 'Front';
    var sideMarks = { Front: '', Back: '', 'Left sleeve': '', 'Right sleeve': '' };
    var sideInputs = {
      Front: root.querySelector('input[name="properties[Front]"]'),
      Back: root.querySelector('input[name="properties[Back]"]'),
      'Left sleeve': root.querySelector('input[name="properties[Left sleeve]"]'),
      'Right sleeve': root.querySelector('input[name="properties[Right sleeve]"]')
    };
    root.querySelectorAll('[data-place].is-on').forEach(function (btn) {
      var place = btn.getAttribute('data-place');
      if (place && ink && ink !== 'No logo' && ink !== 'As shown') sideMarks[place] = ink;
    });

    function readCatalog() {
      var el = document.getElementById('store-catalog-config');
      if (!el) return;
      try {
        var data = JSON.parse(el.textContent);
        catalog.marks = data.marks || [];
        catalog.extraColors = data.extraColors || [];
      } catch (err) {}
    }

    function markApplies(mark) {
      var handles = String((mark && mark.handles) || '').trim();
      if (!handles) return true;
      var handle = root.getAttribute('data-product-handle') || '';
      return handles.split(/[\s,]+/).indexOf(handle) !== -1;
    }

    function setPressed(buttons, value) {
      buttons.forEach(function (btn) {
        var on = btn.getAttribute('data-value') === value;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }

    function places() {
      return ['Front', 'Back', 'Left sleeve', 'Right sleeve'].filter(function (place) {
        return sideMarks[place] && root.querySelector('[data-place="' + place + '"]');
      });
    }

    function shortMark(name) {
      if (name === 'Standard HUMC' || name === 'Single-color HUMC') return 'HUMC';
      if (name === 'LA County') return 'LA';
      return name || '';
    }

    function logoAttr(name, attr) {
      var found = '';
      root.querySelectorAll('[data-field="logo"]').forEach(function (el) {
        if (el.getAttribute('data-value') === name) found = el.getAttribute(attr) || '';
      });
      return found;
    }

    function syncPlaces() {
      root.querySelectorAll('[data-place]').forEach(function (btn) {
        var place = btn.getAttribute('data-place');
        var mark = sideMarks[place] || '';
        btn.classList.toggle('is-on', Boolean(mark));
        btn.classList.toggle('is-focus', place === activePlace);
        btn.setAttribute('aria-pressed', mark ? 'true' : 'false');
        var tag = btn.querySelector('[data-side-mark]');
        if (!tag) {
          tag = document.createElement('span');
          tag.setAttribute('data-side-mark', '');
          btn.appendChild(tag);
        }
        tag.textContent = shortMark(mark);
      });
      ['Front', 'Back', 'Left sleeve', 'Right sleeve'].forEach(function (place) {
        if (sideInputs[place]) sideInputs[place].value = sideMarks[place] || '';
      });
      if (placeInput) placeInput.value = places().join(', ');
      if (logoInput) {
        var bits = places().map(function (place) {
          return place + ': ' + sideMarks[place];
        });
        logoInput.value = bits.join('; ') || 'No logo';
      }
    }

    function viewNames() {
      var order = ['Front', 'Back', 'Left', 'Right'];
      if (!preview || !preview.views) return ['Front'];
      return order.filter(function (name) {
        return name === 'Front' || preview.views[name];
      });
    }

    function lookupPreview(sourceId, title) {
      var entry = sourceId && previewMap[sourceId];
      if (entry) {
        entry.id = entry.id || sourceId;
        return entry;
      }
      var found = null;
      Object.keys(previewMap).some(function (id) {
        if (previewMap[id].title === title) {
          found = previewMap[id];
          found.id = found.id || id;
          return true;
        }
        return false;
      });
      if (found) return found;
      var t = String(title || '');
      var familyId = '';
      if (/1\/4 zip/i.test(t)) familyId = '18991186';
      else if (/trucker|otto|snapback/i.test(t)) familyId = '19193876';
      else if (/canvas bag|jumbo/i.test(t)) familyId = '18416451';
      if (familyId && previewMap[familyId]) {
        found = previewMap[familyId];
        found.id = found.id || familyId;
      }
      return found;
    }

    function setVariant(variant) {
      if (!variant) return;
      var form = document.getElementById(formId);
      var idInput = form && form.querySelector('input[name="id"]');
      if (idInput) idInput.value = variant;
    }

    function photoUrl(colorId, angle) {
      if (!preview || !preview.id || !colorId) return '';
      var base = root.getAttribute('data-asset-base') || '';
      var suffix = !angle || angle === 'Front' ? '' : '-' + angle.toLowerCase();
      return base + 'humc-m-' + preview.id + '-' + colorId + suffix + '.jpg';
    }

    function demoEls() {
      return {
        root: document.querySelector('[data-humc-demo]'),
        photo: document.querySelector('[data-humc-demo-photo]'),
        caption: document.querySelector('[data-humc-demo-caption]'),
        views: document.querySelector('[data-humc-turn]')
      };
    }

    function coverColor() {
      var on = root.querySelector('[data-field="color"].is-on');
      if (on) {
        var hex = (getComputedStyle(on).getPropertyValue('--swatch') || '').trim();
        if (hex) return hex;
      }
      return '#242729';
    }

    function applyCover(on) {
      var stage = document.querySelector('[data-humc-stage]');
      if (!stage) return;
      var cover = stage.querySelector('[data-humc-logo-cover]');
      if (!cover) {
        cover = document.createElement('span');
        cover.setAttribute('data-humc-logo-cover', '');
        stage.appendChild(cover);
      }
      stage.style.setProperty('--humc-cover', coverColor());
      cover.hidden = !on;
    }

    function applyOverlay(url) {
      overlayUrl = url || '';
      var stage = document.querySelector('[data-humc-stage]');
      if (!stage) return;
      stage.setAttribute('data-angle', currentAngle);
      var layer = stage.querySelector('[data-humc-logo-layer]');
      if (!overlayUrl) {
        if (layer) {
          layer.hidden = true;
          layer.removeAttribute('src');
          layer.style.display = 'none';
        }
        return;
      }
      if (!layer) {
        layer = document.createElement('img');
        layer.setAttribute('data-humc-logo-layer', '');
        layer.alt = '';
        stage.appendChild(layer);
      }
      layer.hidden = false;
      layer.style.display = '';
      if (layer.getAttribute('src') !== overlayUrl) layer.setAttribute('src', overlayUrl);
    }

    function setGallery(url) {
      if (!url) return;
      var demo = demoEls();
      var img = demo.photo;
      var probe = new Image();
      probe.onload = function () {
        if (img) {
          img.alt = [logoName, currentAngle, colorInput && colorInput.value].filter(Boolean).join(', ');
          img.style.opacity = '1';
          if (img.getAttribute('src') !== url) img.setAttribute('src', url);
        }
        document.querySelectorAll('.product-media__image').forEach(function (shopImg) {
          shopImg.setAttribute('src', url);
          shopImg.removeAttribute('srcset');
          shopImg.removeAttribute('srcSet');
        });
        applyOverlay(overlayUrl);
      };
      probe.onerror = function () {
        if (currentAngle !== 'Front') {
          currentAngle = 'Front';
          paintPhoto();
          renderViews();
        }
      };
      probe.src = url;
    }

    function apparelFamily() {
      return /zip|hoodie|crew|tee|fleece|hat|trucker|cap|bag/i.test(root.getAttribute('data-family') || '');
    }

    function isStockMark(mark) {
      return mark === 'Standard HUMC' || mark === 'Single-color HUMC' || mark === 'LA County';
    }

    function isBaked(mark, angle) {
      if (!mark || angle !== 'Front' || !isStockMark(mark) || !preview) return false;
      return String(preview.id) === String(logoAttr(mark, 'data-source-id'));
    }

    function needsCover(mark, angle) {
      if (angle === 'Front') {
        if (!apparelFamily()) return false;
        if (!mark || !isStockMark(mark)) return true;
        return false;
      }
      if (angle === 'Right' && mark !== 'LA County' && apparelFamily()) return true;
      return false;
    }

    function paintPhoto() {
      var place = angleToPlace(currentAngle);
      var mark = sideMarks[place] || '';
      logoName = mark || 'No logo';
      var sid = logoAttr(mark, 'data-source-id') || root.getAttribute('data-source-id') || '';
      var title = root.getAttribute('data-product-title') || '';
      var entry = lookupPreview(sid, title);
      if (entry) preview = entry;
      setGallery(photoUrl(currentColorId, currentAngle));
      var baked = isBaked(mark, currentAngle);
      applyOverlay(mark && !baked ? logoAttr(mark, 'data-overlay') : '');
      applyCover(needsCover(mark, currentAngle));
      var demo = demoEls();
      if (demo.caption) {
        demo.caption.textContent = [colorInput && colorInput.value, currentAngle, mark || 'No logo']
          .filter(Boolean)
          .join(' · ');
      }
      document.querySelectorAll('[data-humc-turn] [data-field="view"]').forEach(function (btn) {
        var on = btn.getAttribute('data-value') === currentAngle;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }

    function mountDemo() {
      var gallery =
        document.querySelector('media-gallery') ||
        document.querySelector('.product-media-container') ||
        document.querySelector('.product-media') ||
        document.querySelector('.product-information__media');
      var host = (gallery && gallery.parentNode) ||
        document.querySelector('.product-details') ||
        (root.parentNode);
      if (!host) return;
      document.body.classList.add('has-humc-demo');
      var demo = document.querySelector('[data-humc-demo]');
      if (!demo) {
        demo = document.createElement('div');
        demo.className = 'humc-demo';
        demo.setAttribute('data-humc-demo', '');
        demo.innerHTML =
          '<div class="humc-demo__stage" data-humc-stage data-family="' +
          (root.getAttribute('data-family') || '') +
          '">' +
          '<img data-humc-demo-photo alt="">' +
          '<span data-humc-logo-cover hidden></span>' +
          '<img data-humc-logo-layer hidden alt="">' +
          '</div>' +
          '<p class="humc-demo__caption" data-humc-demo-caption></p>' +
          '<div class="humc-demo__views" data-humc-turn></div>';
        if (gallery) host.insertBefore(demo, gallery);
        else host.insertBefore(demo, host.firstChild);
      }
      renderViews();
    }

    function refresh() {
      syncPlaces();
      var bits = [];
      if (colorInput && colorInput.value) bits.push(colorInput.value);
      if (sizeInput && sizeInput.value) bits.push(sizeInput.value);
      if (logoInput && logoInput.value) bits.push(logoInput.value);
      if (placeInput && placeInput.value) bits.push(placeInput.value);
      if (summary) summary.textContent = bits.length ? bits.join(' · ') : '';
    }

    function showError(msg) {
      if (!errorEl) return;
      errorEl.hidden = !msg;
      errorEl.textContent = msg || '';
    }

    function hasColorChoices() {
      return Boolean(swatchBox && swatchBox.querySelector('[data-field="color"]'));
    }

    function isReady() {
      if (hasColorChoices() && colorInput && !colorInput.value) return 'Pick a garment color.';
      if (!hasColorChoices() && colorInput && !colorInput.value) {
        selectColor('As shown', '');
      }
      if (needsSize && sizeInput && !sizeInput.value) return 'Pick a size.';
      if (!places().length) return 'Pick at least one print location.';
      return '';
    }

    function selectColor(name, colorId) {
      currentColorId = colorId || '';
      if (colorInput) colorInput.value = name || '';
      if (colorNameEl) colorNameEl.textContent = name || '';
      root.querySelectorAll('[data-field="color"]').forEach(function (btn) {
        var on = btn.getAttribute('data-value') === name;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      renderViews();
      paintPhoto();
      showError('');
      refresh();
    }

    function placeToAngle(place) {
      if (place === 'Back') return 'Back';
      if (place === 'Left sleeve') return 'Left';
      if (place === 'Right sleeve') return 'Right';
      return 'Front';
    }

    function angleToPlace(angle) {
      if (angle === 'Back') return 'Back';
      if (angle === 'Left') return 'Left sleeve';
      if (angle === 'Right') return 'Right sleeve';
      return 'Front';
    }

    function selectView(angle) {
      activePlace = angleToPlace(angle);
      currentAngle = viewNames().indexOf(angle) === -1 ? 'Front' : angle;
      syncPlaces();
      paintPhoto();
    }

    function stampPlace(place, mark) {
      sideMarks[place] = mark || '';
      activePlace = place;
      var angle = placeToAngle(place);
      currentAngle = viewNames().indexOf(angle) !== -1 ? angle : 'Front';
      showError('');
      syncPlaces();
      paintPhoto();
      refresh();
    }

    function selectInk(btn) {
      var name = btn.getAttribute('data-value') || '';
      ink = name;
      root.querySelectorAll('[data-field="logo"]').forEach(function (el) {
        var on = el === btn;
        el.classList.toggle('is-on', on);
        el.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      stampPlace(activePlace, name === 'No logo' ? '' : name);
    }

    function tapPlace(btn) {
      var place = btn.getAttribute('data-place') || 'Front';
      stampPlace(place, ink === 'No logo' ? '' : ink);
    }

    function renderViews() {
      var bar = document.querySelector('[data-humc-turn]');
      if (!bar) return;
      var names = viewNames();
      bar.innerHTML = '';
      names.forEach(function (name) {
        var url = photoUrl(currentColorId, name);
        if (!url) return;
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'humc-demo__view';
        btn.hidden = name !== 'Front';
        btn.setAttribute('data-field', 'view');
        btn.setAttribute('data-value', name);
        btn.setAttribute('aria-pressed', name === currentAngle ? 'true' : 'false');
        var thumb = document.createElement('img');
        thumb.alt = name;
        thumb.addEventListener('load', function () {
          btn.hidden = false;
        });
        thumb.addEventListener('error', function () {
          btn.remove();
          if (currentAngle === name && name !== 'Front') {
            currentAngle = 'Front';
            paintPhoto();
          }
        });
        thumb.src = url;
        var label = document.createElement('span');
        label.textContent = name;
        btn.appendChild(thumb);
        btn.appendChild(label);
        bar.appendChild(btn);
      });
    }

    function renderSwatches(entry, keepColor) {
      preview = entry;
      if (!swatchBox || !entry || !entry.colors) return;
      var colors = entry.colors.slice();
      extraColorsForProduct().forEach(function (extra) {
        var match = colors.find(function (color) {
          return color.name.toLowerCase() === String(extra.name || '').toLowerCase();
        });
        if (match) return;
        colors.push({
          id: extra.id || '',
          name: extra.name,
          hex: extra.hex || '#ccc'
        });
      });
      var seen = {};
      colors = colors.filter(function (color) {
        var key = String(color.name || color.id);
        if (seen[key]) return false;
        seen[key] = true;
        return true;
      });
      swatchBox.innerHTML = '';
      colors.forEach(function (color) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'humc-customize__swatch';
        btn.setAttribute('data-field', 'color');
        btn.setAttribute('data-value', color.name);
        btn.setAttribute('data-color-id', String(color.id));
        btn.setAttribute('title', color.name);
        btn.setAttribute('aria-label', color.name);
        btn.setAttribute('aria-pressed', 'false');
        btn.style.setProperty('--swatch', color.hex || '#ccc');
        if (/white|ash|natural|cornsilk|ice grey|light pink|yellow/i.test(color.name)) {
          btn.classList.add('is-light');
        }
        swatchBox.appendChild(btn);
      });
      if (!document.querySelector('[data-humc-demo]')) mountDemo();
      else renderViews();
      var chosen =
        (keepColor && colors.find(function (c) { return c.name === keepColor; })) ||
        colors.find(function (c) { return String(c.id) === String(entry.default); }) ||
        colors.find(function (c) { return c.name === 'Black'; }) ||
        colors[0];
      if (chosen) selectColor(chosen.name, chosen.id);
    }

    document.addEventListener('click', function (event) {
      var host = document.querySelector('[data-humc-customize]');
      if (host && host !== root) {
        root = host;
        colorInput = root.querySelector('input[name="properties[Color]"]');
        sizeInput = root.querySelector('input[name="properties[Size]"]');
        logoInput = root.querySelector('input[name="properties[Logo]"]');
        placeInput = root.querySelector('input[name="properties[Print locations]"]');
        summary = root.querySelector('[data-summary]');
        errorEl = root.querySelector('[data-error]');
        swatchBox = root.querySelector('[data-swatches]');
        colorNameEl = root.querySelector('[data-color-name]');
        sideInputs.Front = root.querySelector('input[name="properties[Front]"]');
        sideInputs.Back = root.querySelector('input[name="properties[Back]"]');
        sideInputs['Left sleeve'] = root.querySelector('input[name="properties[Left sleeve]"]');
        sideInputs['Right sleeve'] = root.querySelector('input[name="properties[Right sleeve]"]');
      }
      if (!root || !root.isConnected) return;
      var t = event.target;
      if (!t || !t.closest) return;
      var colorBtn = t.closest('[data-field="color"]');
      if (colorBtn && root.contains(colorBtn)) {
        selectColor(colorBtn.getAttribute('data-value'), colorBtn.getAttribute('data-color-id'));
        return;
      }
      var viewBtn = t.closest('[data-humc-turn] [data-field="view"]') || t.closest('[data-field="view"]');
      if (viewBtn && (root.contains(viewBtn) || viewBtn.closest('[data-humc-turn]'))) {
        selectView(viewBtn.getAttribute('data-value'));
        return;
      }
      var sizeBtn = t.closest('[data-field="size"]');
      if (sizeBtn && root.contains(sizeBtn)) {
        if (sizeInput) sizeInput.value = sizeBtn.getAttribute('data-value') || '';
        setPressed(root.querySelectorAll('[data-field="size"]'), sizeInput.value);
        showError('');
        refresh();
        return;
      }
      var logoBtn = t.closest('[data-field="logo"]');
      if (logoBtn && root.contains(logoBtn)) {
        selectInk(logoBtn);
        return;
      }
      var placeBtn = t.closest('[data-place]');
      if (placeBtn && root.contains(placeBtn)) {
        tapPlace(placeBtn);
      }
    }, true);

    function blockIfIncomplete(event) {
      var form = event.target;
      if (form && form.id !== formId) {
        var btn = event.target.closest ? event.target.closest('[name="add"]') : null;
        if (!btn) return;
        form = document.getElementById(formId);
        if (!form) return;
        var belongs = btn.form === form || btn.getAttribute('form') === formId || form.contains(btn);
        if (!belongs) return;
      } else if (!form || form.id !== formId) {
        return;
      }
      var msg = isReady();
      if (msg) {
        event.preventDefault();
        event.stopPropagation();
        if (event.stopImmediatePropagation) event.stopImmediatePropagation();
        showError(msg);
        root.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }
    }

    document.addEventListener('submit', blockIfIncomplete, true);
    document.addEventListener(
      'click',
      function (event) {
        var btn = event.target.closest('[name="add"]');
        if (!btn) return;
        var form = document.getElementById(formId);
        if (!form) return;
        var belongs = btn.form === form || btn.getAttribute('form') === formId || form.contains(btn);
        if (!belongs) return;
        var msg = isReady();
        if (msg) {
          event.preventDefault();
          event.stopPropagation();
          if (event.stopImmediatePropagation) event.stopImmediatePropagation();
          showError(msg);
          root.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          return;
        }
      },
      true
    );

    function extraColorsForProduct() {
      return (catalog.extraColors || []).filter(function (color) {
        return color && color.name && markApplies(color);
      });
    }

    function addCatalogMarks() {
      var box = root.querySelector('[data-logos]');
      if (!box) return;
      (catalog.marks || []).forEach(function (mark) {
        if (!mark || !mark.name || !markApplies(mark)) return;
        var exists = Array.prototype.some.call(box.querySelectorAll('[data-field="logo"]'), function (el) {
          return el.getAttribute('data-value') === mark.name;
        });
        if (exists) return;
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'humc-customize__logo';
        btn.setAttribute('data-field', 'logo');
        btn.setAttribute('data-value', mark.name);
        btn.setAttribute('data-title', root.getAttribute('data-product-title') || '');
        btn.setAttribute('data-source-id', root.getAttribute('data-source-id') || '');
        btn.setAttribute('data-has-photo', mark.image ? 'true' : 'false');
        btn.setAttribute('data-overlay', mark.image || '');
        btn.setAttribute('aria-pressed', 'false');
        if (mark.image) {
          var img = document.createElement('img');
          img.src = mark.image;
          img.alt = '';
          btn.appendChild(img);
        }
        btn.appendChild(document.createTextNode(mark.name));
        box.appendChild(btn);
      });
    }

    readCatalog();
    addCatalogMarks();
    syncPlaces();
    refresh();

    var mapUrl = root.getAttribute('data-preview-map');
    if (mapUrl) {
      fetch(mapUrl)
        .then(function (res) { return res.json(); })
        .then(function (map) {
          var title = root.getAttribute('data-product-title') || '';
          var sid = root.getAttribute('data-source-id') || '';
          previewMap = map;
          var entry = lookupPreview(sid, title);
          if (entry) {
            renderSwatches(entry);
          } else {
            var colorSet = root.querySelector('[data-color-set]');
            if (colorSet) colorSet.hidden = true;
            selectColor('As shown', '');
          }
        })
        .catch(function () {
          selectColor('As shown', '');
        });
    }
  })();
</script>
{%- endunless -%}

{%- if title_l contains 'personalization' -%}
  <input type="hidden" name="properties[Store]" form="{{ form_id }}" value="HUMC Gear">
