{% stylesheet %}
  .humc-customize {
    display: grid;
    gap: 1rem;
    width: 100%;
  }

  .humc-customize__gallery {
    display: grid;
    gap: 0.55rem;
  }

  .humc-customize__stage {
    position: relative;
    background: #fff;
    border: 1px solid #ddd;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .humc-customize__stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .humc-customize__stage [data-humc-design-layer] {
    position: absolute;
    object-fit: contain;
    pointer-events: none;
    height: auto;
  }

  /* Placements measured from vv Zepto screenshots (docs/reference/vv). */
