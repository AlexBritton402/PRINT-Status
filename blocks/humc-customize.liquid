{%- comment -%}
  HUMC CUSTOMIZABLE PDPs — match vv Radiant shopper view:
  Front / Back / Right sleeve, jacket/shirt color swatches, design/logo,
  quantity (no Chipply size grid). Pre-meshed mockup photos only.
  Non-customizable catalog SKUs keep a simple Horizon buy box (like vv).
{%- endcomment -%}

{%- liquid
  assign product_resource = closest.product
  assign title = product_resource.title | default: ''
  assign title_l = title | downcase
  assign form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign handle_tail = product_resource.handle | split: '-' | last

  assign is_customizable = false
  if title_l contains 'customizable'
    assign is_customizable = true
  endif

  comment
    vv CUSTOMIZABLE uses quantity only — no XS–4XL size matrix.
  endcomment
  assign needs_size = false

  assign default_logo = 'LA County'
  assign family_id = ''
  assign show_logo_picker = false
  assign logo_map_kind = 'none'
  assign color_legend = 'Color'
  if is_customizable
    assign show_logo_picker = true
  endif
  if title_l contains 'soft blend'
    assign logo_map_kind = 'soft-tee'
    assign color_legend = 'Shirt color'
  elsif title_l contains '1/4 zip' or title_l contains 'zip fleece'
    assign logo_map_kind = 'zip'
    assign color_legend = 'Jacket color'
  endif
  comment
    Prefer LA County left-chest look to match vv default design.
  endcomment
  if title contains 'Standard HUMC' or title contains 'w/ Standard'
    assign default_logo = 'Standard HUMC'
  elsif title contains 'Single Color' or title contains 'Single-color'
    assign default_logo = 'Single-color HUMC'
  elsif title contains 'LA County'
    assign default_logo = 'LA County'
  endif

  comment
    Chipply source id when baked into the handle (...-18991186).
  endcomment
  if handle_tail == '20857516' or handle_tail == '19193821' or handle_tail == '19027956' or handle_tail == '18991476' or handle_tail == '19028676' or handle_tail == '18993506' or handle_tail == '18867111' or handle_tail == '18991186' or handle_tail == '18991311' or handle_tail == '18991341' or handle_tail == '18993671' or handle_tail == '18861296' or handle_tail == '19193761' or handle_tail == '18993686' or handle_tail == '19193831' or handle_tail == '18991396' or handle_tail == '18991431' or handle_tail == '19193876' or handle_tail == '18416451' or handle_tail == '18417261' or handle_tail == '18753436' or handle_tail == '13923078' or handle_tail == '23857561'
    assign family_id = handle_tail
  endif

  assign family_phrase = ''
  if title_l contains 'heavyweight tee'
    assign family_phrase = 'heavyweight tee'
    if family_id == blank
      assign family_id = '20857516'
    endif
  elsif title_l contains 'drop shoulder' and title_l contains 'la county'
    assign family_phrase = 'drop shoulder hoodie'
    if family_id == blank
      assign family_id = '18993671'
    endif
  elsif title_l contains 'drop shoulder'
    assign family_phrase = 'drop shoulder hoodie'
    if family_id == blank
      assign family_id = '18993686'
    endif
  elsif title_l contains 'sustainable'
    assign family_phrase = 'sustainable full zip hoodie'
    if family_id == blank
      assign family_id = '19193761'
    endif
  elsif title_l contains 'full zip hoodie' and title_l contains 'standard'
    assign family_phrase = 'full zip hoodie'
    if family_id == blank
      assign family_id = '18991341'
    endif
  elsif title_l contains 'full zip hoodie' and title_l contains 'single'
    assign family_phrase = 'full zip hoodie'
    if family_id == blank
      assign family_id = '18991311'
    endif
  elsif title_l contains 'full zip hoodie'
    assign family_phrase = 'full zip hoodie'
    if family_id == blank
      assign family_id = '18861296'
    endif
  elsif title_l contains '1/4 zip' or title_l contains 'zip fleece'
    assign family_phrase = '1/4 zip fleece'
    if family_id == blank
      if default_logo == 'Single-color HUMC'
        assign family_id = '18867111'
      elsif default_logo == 'LA County'
        assign family_id = '18993506'
      else
        assign family_id = '18991186'
      endif
    endif
  elsif title_l contains 'fleece crew' and title_l contains 'la county'
    assign family_phrase = 'fleece crew'
    if family_id == blank
      assign family_id = '18991431'
    endif
  elsif title_l contains 'fleece crew'
    assign family_phrase = 'fleece crew'
    if family_id == blank
      assign family_id = '18991396'
    endif
  elsif title_l contains 'soft blend tee' and title_l contains 'women'
    assign family_phrase = 'women soft blend tee'
    if family_id == blank
      assign family_id = '19028676'
    endif
  elsif title_l contains 'soft blend tee' and title_l contains 'front and back'
    assign family_phrase = 'unisex soft blend tee'
    if family_id == blank
      assign family_id = '18991476'
    endif
  elsif title_l contains 'soft blend tee'
    assign family_phrase = 'unisex soft blend tee'
    if family_id == blank
      if default_logo == 'LA County'
        assign family_id = '18991476'
      elsif title contains '19193821' or product_resource.handle contains '19193821'
        assign family_id = '19193821'
      else
        assign family_id = '19027956'
      endif
    endif
  endif

  assign sizes = 'S,M,L,XL,2XL' | split: ','
-%}

{%- if is_customizable -%}
<div
  class="humc-customize spacing-style"
  data-humc-customize
  data-form-id="{{ form_id }}"
  data-needs-size="false"
  data-product-title="{{ title | escape }}"
  data-product-handle="{{ product_resource.handle | escape }}"
  data-source-id="{{ handle_tail | escape }}"
  data-family="{{ family_phrase | escape }}"
  data-family-id="{{ family_id | escape }}"
  data-logo-name="{{ default_logo | escape }}"
  data-show-logo-picker="{% if show_logo_picker %}true{% else %}false{% endif %}"
  data-logo-map-kind="{{ logo_map_kind | escape }}"
  data-family-phrase="{{ family_phrase | escape }}"
  data-color-legend="{{ color_legend | escape }}"
  data-preview-map="{{ 'humc-preview.json' | asset_url }}"
  data-asset-base="{{ 'humc-preview.json' | asset_url | split: 'humc-preview.json' | first }}"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  <nav class="humc-customize__crumbs" data-humc-crumbs aria-label="Breadcrumb">
    <a href="{{ pages['humc-gear'].url | default: '/pages/humc-gear' }}">Home</a>
    <span aria-hidden="true">›</span>
    <a href="{{ collections['humc-gear'].url | default: '/collections/humc-gear' }}">Products</a>
    <span aria-hidden="true">›</span>
    <span>Catalog</span>
    <span aria-hidden="true">›</span>
    <span data-humc-crumb-title>{{ title | escape }}</span>
  </nav>

  <div class="humc-customize__gallery" data-humc-gallery>
    <div class="humc-customize__stage" data-humc-stage>
      {%- comment -%} One stage image at a time; angle thumbs swap pre-meshed mockups (not logo overlays). {%- endcomment -%}
      <img data-humc-demo-photo alt="{{ title | escape }}" width="600" height="600">
    </div>
    <div class="humc-customize__views" data-humc-views role="tablist" aria-label="Product views">
      <button type="button" class="humc-customize__view is-on" data-view="Front" aria-pressed="true">
        <img data-humc-view-thumb="Front" alt="" width="72" height="72">
        <span>Front</span>
      </button>
      <button type="button" class="humc-customize__view" data-view="Back" aria-pressed="false">
        <img data-humc-view-thumb="Back" alt="" width="72" height="72">
        <span>Back</span>
      </button>
      <button type="button" class="humc-customize__view" data-view="Right" aria-pressed="false">
        <img data-humc-view-thumb="Right" alt="" width="72" height="72">
        <span>Right sleeve</span>
      </button>
    </div>
    <p class="humc-customize__caption" data-humc-demo-caption></p>
  </div>

  {%- if show_logo_picker -%}
    <fieldset class="humc-customize__set">
      <legend>Front design</legend>
      <div class="humc-customize__chips" role="list">
        {%- if logo_map_kind == 'soft-tee' -%}
          <button type="button" class="humc-customize__chip" data-field="logo" data-value="LA County" data-family-id="18991476" aria-pressed="false">Left Chest LA County</button>
          <button type="button" class="humc-customize__chip" data-field="logo" data-value="Single-color HUMC" data-family-id="19027956" aria-pressed="false">Left Chest Single-color HUMC</button>
        {%- elsif logo_map_kind == 'zip' -%}
          <button type="button" class="humc-customize__chip" data-field="logo" data-value="LA County" data-family-id="18993506" aria-pressed="false">Left Chest LA County</button>
          <button type="button" class="humc-customize__chip" data-field="logo" data-value="Standard HUMC" data-family-id="18991186" aria-pressed="false">Left Chest Standard HUMC</button>
          <button type="button" class="humc-customize__chip" data-field="logo" data-value="Single-color HUMC" data-family-id="18867111" aria-pressed="false">Left Chest Single-color HUMC</button>
        {%- endif -%}
      </div>
    </fieldset>
  {%- endif -%}

  <fieldset class="humc-customize__set" data-color-set>
    <legend>{{ color_legend | escape }}</legend>
    <p class="humc-customize__color-name" data-color-name></p>
    <div class="humc-customize__swatches" data-swatches role="list"></div>
    <input type="hidden" name="properties[Store]" form="{{ form_id }}" value="HUMC Gear">
    <input type="hidden" name="properties[Color]" form="{{ form_id }}" value="">
    <input type="hidden" name="properties[Logo]" form="{{ form_id }}" value="{{ default_logo | escape }}">
    <input type="hidden" name="properties[Print locations]" form="{{ form_id }}" value="As shown">
  </fieldset>

  {%- if needs_size -%}
    <fieldset class="humc-customize__set">
      <legend>Size</legend>
      <div class="humc-customize__size-grid" data-size-grid role="list">
        {%- for size in sizes -%}
          <label class="humc-customize__size-cell">
            <span class="humc-customize__size-label">{{ size | escape }}</span>
            <input
              type="number"
              class="humc-customize__size-qty"
              data-size-qty="{{ size | escape }}"
              min="0"
              max="99"
              value="0"
              inputmode="numeric"
              aria-label="Quantity for {{ size | escape }}"
            >
          </label>
        {%- endfor -%}
      </div>
      <input type="hidden" name="properties[Size]" form="{{ form_id }}" value="">
    </fieldset>
  {%- else -%}
    <input type="hidden" name="properties[Size]" form="{{ form_id }}" value="One size">
  {%- endif -%}

  <p class="humc-customize__summary" data-summary></p>
  <p class="humc-customize__error" data-error hidden></p>
  <div class="humc-customize__buy-slot" data-humc-buy-slot></div>
  <p class="humc-customize__tax">*Tax collected only if you are in the state of California.</p>

</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-humc-customize')) return;

    var formId = root.getAttribute('data-form-id');
    var needsSize = root.getAttribute('data-needs-size') === 'true';
    var showLogoPicker = root.getAttribute('data-show-logo-picker') === 'true';
    var colorInput = root.querySelector('input[name="properties[Color]"]');
    var sizeInput = root.querySelector('input[name="properties[Size]"]');
    var logoInput = root.querySelector('input[name="properties[Logo]"]');
    var placeInput = root.querySelector('input[name="properties[Print locations]"]');
    var colorNameEl = root.querySelector('[data-color-name]');
    var swatchBox = root.querySelector('[data-swatches]');
    var summary = root.querySelector('[data-summary]');
    var errorEl = root.querySelector('[data-error]');
    var photo = root.querySelector('[data-humc-demo-photo]');
    var caption = root.querySelector('[data-humc-demo-caption]');

    var previewMap = {};
    var catalog = { marks: [], extraColors: [] };
    var preview = null;
    var currentColorId = '';
    var currentColorName = '';
    var currentView = 'Front';
    var familyId = root.getAttribute('data-family-id') || '';
    var logoName = root.getAttribute('data-logo-name') || 'Standard HUMC';
    var logoMapKind = root.getAttribute('data-logo-map-kind') || 'zip';

    // Pre-meshed Chipply mockup families — logo choice swaps photo pack, never overlays a crest.
    var LOGO_FAMILY_BY_KIND = {
      zip: {
        'Standard HUMC': '18991186',
        'Single-color HUMC': '18867111',
        'LA County': '18993506'
      },
      'soft-tee': {
        'Single-color HUMC': '19027956',
        'LA County': '18991476'
      },
      hoodie: {
        'Single-color HUMC': '19193761'
      },
      bag: {
        'Standard HUMC': '18416451',
        'Single-color HUMC': '18417261',
        'LA County': '18753436'
      },
      hat: {
        'LA County': '19193876'
      }
    };
    var TITLE_FOR_LOGO_BY_KIND = {
      zip: {
        'Standard HUMC': '1/4 Zip Fleece w/ Standard HUMC Logo and LA County Logo on Sleeve',
        'Single-color HUMC': '1/4 Zip Fleece w/ Single Color HUMC Logo and LA County Logo on Sleeve',
        'LA County': '1/4 Zip Fleece w/ LA County Logo'
      },
      'soft-tee': {
        'Single-color HUMC': 'Unisex Soft Blend Tee w/ Single Color HUMC Logo',
        'LA County': 'Unisex Soft Blend Tee w/ LA County Logo on Front and Back'
      },
      hoodie: {
        'Single-color HUMC': "Women's Sustainable Full Zip Hoodie w/ Single Color HUMC Logo and LA County Logo on Sleeve"
      },
      bag: {
        'Standard HUMC': 'Jumbo Canvas Bag w/ Standard HUMC Logo',
        'Single-color HUMC': 'Jumbo Canvas Bag w/ Single Color HUMC Logo',
        'LA County': 'Jumbo Canvas Bag w/ LA County Logo'
      },
      hat: {
        'LA County': 'Snapback Trucker Hat w/ LA County Logo'
      }
    };
    var LOGO_FAMILY = LOGO_FAMILY_BY_KIND[logoMapKind] || LOGO_FAMILY_BY_KIND.zip;
    var TITLE_FOR_LOGO = TITLE_FOR_LOGO_BY_KIND[logoMapKind] || TITLE_FOR_LOGO_BY_KIND.zip;

    function assetBase() {
      return root.getAttribute('data-asset-base') || '';
    }

    function mountChipplyLayout() {
      document.body.classList.add('has-humc-demo');
      var gallery = root.querySelector('[data-humc-gallery]');
      var media = document.querySelector('.product-information__media');
      if (gallery && media && gallery.parentNode !== media) {
        media.innerHTML = '';
        media.appendChild(gallery);
      }
      var crumbs = root.querySelector('[data-humc-crumbs]');
      var section = document.querySelector('.product-information.section') || document.querySelector('.product-information');
      if (crumbs && section && crumbs.parentNode !== section) {
        section.insertBefore(crumbs, section.firstChild);
      }
      // Chipply order: size → Add to cart → tax → bullets → size guide
      function placeBuy() {
        var slot = root.querySelector('[data-humc-buy-slot]');
        var buy =
          document.querySelector('.product-form-buttons') ||
          document.querySelector('.buy-buttons') ||
          document.querySelector('add-to-cart-component') ||
          document.querySelector('[name="add"]');
        if (slot && buy && buy.parentNode !== slot) {
          slot.appendChild(buy);
          return true;
        }
        return !!(slot && buy);
      }
      placeBuy();
      [100, 400, 1000, 2000].forEach(function (ms) {
        window.setTimeout(placeBuy, ms);
      });
      // Hide leftover Horizon back-link / qty stepper
      document.querySelectorAll('a').forEach(function (a) {
        if (/back to humc/i.test(a.textContent || '')) a.style.display = 'none';
      });
      // Keep Horizon quantity stepper — vv CUSTOMIZABLE uses quantity, not a size matrix.
    }

    function syncListingTitle() {
      // Only rewrite the heading when the customizable logo picker is on.
      if (!showLogoPicker) return;
      var next = TITLE_FOR_LOGO[logoName];
      if (!next) return;
      document.querySelectorAll('.product-details h1, .product-information h1, h1').forEach(function (h) {
        if (/zip|fleece|tee|hoodie|customizable|humc|la county/i.test(h.textContent || '')) {
          h.textContent = next;
        }
      });
      var crumb = root.querySelector('[data-humc-crumb-title]');
      if (crumb) crumb.textContent = next;
    }

    function showError(msg) {
      if (!errorEl) return;
      errorEl.hidden = !msg;
      errorEl.textContent = msg || '';
    }

    function refreshSummary() {
      if (!summary) return;
      var bits = [];
      if (currentColorName) bits.push(currentColorName);
      if (logoInput && logoInput.value) bits.push(logoInput.value);
      if (sizeInput && sizeInput.value) bits.push(sizeInput.value);
      summary.textContent = bits.join(' · ');
    }

    function stockUrl(fid, colorId, angle) {
      if (!fid || !colorId) return '';
      var suffix = !angle || angle === 'Front' ? '' : '-' + angle.toLowerCase();
      return assetBase() + 'humc-m-' + fid + '-' + colorId + suffix + '.jpg';
    }

    function setMainPhoto(url) {
      if (!url) return;
      if (photo) {
        photo.setAttribute('src', url);
        photo.removeAttribute('srcset');
      }
      document.querySelectorAll('.product-media__image').forEach(function (shopImg) {
        shopImg.setAttribute('src', url);
        shopImg.removeAttribute('srcset');
      });
    }

    function probeUrl(url, ok, fail) {
      if (!url) {
        if (fail) fail();
        return;
      }
      var img = new Image();
      img.onload = function () {
        if (img.naturalWidth > 0) ok(url);
        else if (fail) fail();
      };
      img.onerror = function () {
        if (fail) fail();
      };
      img.src = url;
    }

    function fillThumbs() {
      // vv Radiant CUSTOMIZABLE: Front / Back / Right sleeve only
      ['Front', 'Back', 'Right'].forEach(function (angle) {
        var btn = root.querySelector('[data-view="' + angle + '"]');
        var thumb = root.querySelector('[data-humc-view-thumb="' + angle + '"]');
        var url = stockUrl(familyId, currentColorId, angle);
        probeUrl(
          url,
          function (okUrl) {
            if (thumb) {
              thumb.setAttribute('src', okUrl);
              thumb.hidden = false;
            }
            if (btn) {
              btn.hidden = false;
              btn.disabled = false;
            }
          },
          function () {
            if (thumb) {
              thumb.removeAttribute('src');
              thumb.hidden = true;
            }
            if (btn) {
              // Front always stays; other missing angles hide like Chipply only showing available shots
              if (angle === 'Front') {
                btn.hidden = false;
              } else {
                btn.hidden = true;
              }
            }
            if (currentView === angle && angle !== 'Front') setView('Front');
          }
        );
      });
    }

    function setView(angle) {
      currentView = angle || 'Front';
      var label = currentView === 'Left' ? 'Left sleeve' : currentView === 'Right' ? 'Right sleeve' : currentView;
      root.querySelectorAll('[data-view]').forEach(function (btn) {
        var on = btn.getAttribute('data-view') === currentView;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      var url = stockUrl(familyId, currentColorId, currentView);
      var front = stockUrl(familyId, currentColorId, 'Front');
      probeUrl(
        url,
        function (okUrl) {
          setMainPhoto(okUrl);
        },
        function () {
          setMainPhoto(front);
          currentView = 'Front';
          label = 'Front';
          root.querySelectorAll('[data-view]').forEach(function (btn) {
            var on = btn.getAttribute('data-view') === 'Front';
            btn.classList.toggle('is-on', on);
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
        }
      );
      if (caption) {
        caption.textContent = [currentColorName, logoName, label].filter(Boolean).join(' · ');
      }
      if (placeInput) {
        placeInput.value = 'As shown (' + label + ')';
      }
    }

    function selectLogo(name, fid) {
      logoName = name || logoName;
      familyId = fid || LOGO_FAMILY[logoName] || familyId;
      root.setAttribute('data-family-id', familyId);
      root.setAttribute('data-logo-name', logoName);
      if (logoInput) logoInput.value = logoName;
      root.querySelectorAll('[data-field="logo"]').forEach(function (btn) {
        var on = btn.getAttribute('data-value') === logoName;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      syncListingTitle();
      // Re-bind colors for this family if present in map
      var entry = previewMap[familyId];
      if (entry) {
        entry.id = familyId;
        renderSwatches(entry, true);
      } else {
        fillThumbs();
        setView(currentView);
        refreshSummary();
      }
    }

    function selectColor(name, colorId) {
      currentColorId = colorId || '';
      currentColorName = name || '';
      if (colorInput) colorInput.value = currentColorName;
      if (colorNameEl) colorNameEl.textContent = currentColorName;
      root.querySelectorAll('[data-field="color"]').forEach(function (btn) {
        var on = btn.getAttribute('data-value') === name;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      fillThumbs();
      setView(currentView);
      refreshSummary();
      showError('');
    }

    function syncSizeQty() {
      if (!needsSize || !sizeInput) return;
      var chosen = '';
      var qty = 0;
      root.querySelectorAll('[data-size-qty]').forEach(function (input) {
        var n = parseInt(input.value, 10) || 0;
        if (n > 0 && !chosen) {
          chosen = input.getAttribute('data-size-qty');
          qty = n;
        }
        input.closest('.humc-customize__size-cell').classList.toggle('is-on', n > 0);
      });
      sizeInput.value = chosen;
      var form = document.getElementById(formId);
      if (form) {
        var q = form.querySelector('[name="quantity"]');
        if (q && qty > 0) q.value = String(qty);
      }
      refreshSummary();
    }

    function isReady() {
      if (!colorInput || !colorInput.value) return 'Pick a color.';
      if (needsSize && (!sizeInput || !sizeInput.value)) return 'Enter a quantity for a size.';
      if (showLogoPicker && logoInput && !logoInput.value) return 'Pick a logo.';
      return '';
    }

    function markApplies(color) {
      var handles = (color.handles || '').toString();
      if (!handles) return true;
      var handle = root.getAttribute('data-product-handle') || '';
      return handles.split(/[\s,]+/).some(function (h) {
        return h && handle.indexOf(h) !== -1;
      });
    }

    function extraColorsForProduct() {
      return (catalog.extraColors || []).filter(function (color) {
        return color && color.name && markApplies(color);
      });
    }

    function renderSwatches(entry, keepColor) {
      preview = entry;
      if (!swatchBox || !entry || !entry.colors) return;
      var colors = entry.colors.slice();
      extraColorsForProduct().forEach(function (extra) {
        if (colors.some(function (c) { return c.name.toLowerCase() === String(extra.name || '').toLowerCase(); })) return;
        colors.push({ id: extra.id || '', name: extra.name, hex: extra.hex || '#ccc' });
      });
      var seen = {};
      colors = colors.filter(function (color) {
        var key = String(color.name || color.id);
        if (seen[key]) return false;
        seen[key] = true;
        return true;
      });
      // Match vv Zepto shopper color rows (not the full Chipply catalog).
      var allow =
        logoMapKind === 'soft-tee'
          ? ['Aqua Heather', 'Awareness Pink Heather', 'Black', 'Heathered Red', 'Charcoal', 'Deep Orange Heather']
          : logoMapKind === 'zip'
            ? ['Black', 'Charcoal', 'Heathered Charcoal', 'Light Heather Grey', 'New Navy', 'Deep Royal']
            : null;
      if (allow) {
        colors = allow
          .map(function (name) {
            return colors.find(function (c) { return c.name === name; });
          })
          .filter(Boolean);
      }
      swatchBox.innerHTML = '';
      colors.forEach(function (color) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'humc-customize__swatch';
        btn.setAttribute('data-field', 'color');
        btn.setAttribute('data-value', color.name);
        btn.setAttribute('data-color-id', String(color.id));
        btn.setAttribute('title', color.name);
        btn.setAttribute('aria-label', color.name);
        btn.setAttribute('aria-pressed', 'false');
        btn.style.setProperty('--swatch', color.hex || '#ccc');
        if (/white|ash|natural|cornsilk|ice grey|light pink|yellow|light heather/i.test(color.name)) btn.classList.add('is-light');
        swatchBox.appendChild(btn);
      });
      var chosen = null;
      if (keepColor && currentColorName) {
        chosen = colors.find(function (c) { return c.name === currentColorName; });
      }
      if (!chosen) {
        // vv opens CUSTOMIZABLE garments on Black.
        chosen =
          colors.find(function (c) { return c.name === 'Black'; }) ||
          colors.find(function (c) { return String(c.id) === String(entry.default); }) ||
          colors[0];
      }
      if (chosen) selectColor(chosen.name, chosen.id);
    }

    function lookupPreview(sourceId, title) {
      var entry = sourceId && previewMap[sourceId];
      if (entry) {
        entry.id = entry.id || sourceId;
        return entry;
      }
      if (familyId && previewMap[familyId]) {
        entry = previewMap[familyId];
        entry.id = familyId;
        return entry;
      }
      var found = null;
      Object.keys(previewMap).some(function (id) {
        if (previewMap[id].title === title) {
          found = previewMap[id];
          found.id = found.id || id;
          return true;
        }
        return false;
      });
      return found;
    }

    function readCatalog() {
      var host = document.querySelector('[data-humc-catalog]');
      if (!host) return;
      try {
        catalog = JSON.parse(host.getAttribute('data-humc-catalog') || '{}') || catalog;
      } catch (err) {
        catalog = { marks: [], extraColors: [] };
      }
    }

    mountChipplyLayout();
    syncListingTitle();

    root.querySelectorAll('[data-view]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        setView(btn.getAttribute('data-view'));
      });
    });

    root.querySelectorAll('[data-field="logo"]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectLogo(btn.getAttribute('data-value'), btn.getAttribute('data-family-id'));
      });
    });

    document.addEventListener(
      'click',
      function (event) {
        if (!root.isConnected) return;
        var t = event.target;
        if (!t || !t.closest) return;
        var colorBtn = t.closest('[data-field="color"]');
        if (colorBtn && root.contains(colorBtn)) {
          selectColor(colorBtn.getAttribute('data-value'), colorBtn.getAttribute('data-color-id'));
        }
      },
      true
    );

    root.querySelectorAll('[data-size-qty]').forEach(function (input) {
      input.addEventListener('focus', function () {
        if (input.value === '0') input.select();
      });
      input.addEventListener('input', function () {
        // Chipply-style: one size at a time for a simple cart line
        root.querySelectorAll('[data-size-qty]').forEach(function (other) {
          if (other !== input) other.value = '0';
        });
        if (!input.value || parseInt(input.value, 10) < 0) input.value = '0';
        syncSizeQty();
        showError('');
      });
    });

    document.addEventListener(
      'click',
      function (event) {
        var btn = event.target.closest('[name="add"]');
        if (!btn) return;
        var form = document.getElementById(formId);
        if (!form) return;
        var belongs = btn.form === form || btn.getAttribute('form') === formId || form.contains(btn);
        if (!belongs) return;
        syncSizeQty();
        var msg = isReady();
        if (msg) {
          event.preventDefault();
          event.stopPropagation();
          if (event.stopImmediatePropagation) event.stopImmediatePropagation();
          showError(msg);
          root.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      },
      true
    );

    document.addEventListener(
      'submit',
      function (event) {
        var form = event.target;
        if (!form || form.id !== formId) return;
        syncSizeQty();
        var msg = isReady();
        if (msg) {
          event.preventDefault();
          event.stopPropagation();
          showError(msg);
        }
      },
      true
    );

    readCatalog();
    if (logoInput) logoInput.value = logoName;
    if (showLogoPicker) {
      selectLogo(logoName, LOGO_FAMILY[logoName] || familyId);
    }

    var mapUrl = root.getAttribute('data-preview-map');
    if (mapUrl) {
      fetch(mapUrl)
        .then(function (res) { return res.json(); })
        .then(function (map) {
          previewMap = map || {};
          var entry = lookupPreview(familyId || root.getAttribute('data-source-id'), root.getAttribute('data-product-title'));
          if (entry) renderSwatches(entry);
          else showError('Preview photos are missing for this product.');
          if (showLogoPicker) {
            root.querySelectorAll('[data-field="logo"]').forEach(function (btn) {
              var on = btn.getAttribute('data-value') === logoName;
              btn.classList.toggle('is-on', on);
              btn.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
          }
        })
        .catch(function () {
          showError('Could not load product photos.');
        });
    }
  })();
</script>
{%- endif -%}

{%- if title_l contains 'personalization' -%}
  <input type="hidden" name="properties[Store]" form="{{ form_id }}" value="HUMC Gear">
{%- endif -%}

{% stylesheet %}
  .humc-customize {
    display: grid;
    gap: 1rem;
    width: 100%;
  }

  .humc-customize__gallery {
    display: grid;
    gap: 0.55rem;
  }

  .humc-customize__stage {
    background: #fff;
    border: 1px solid #ddd;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .humc-customize__stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .humc-customize__views {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .humc-customize__view {
    appearance: none;
    margin: 0;
    padding: 0.25rem;
    border: 1px solid #ddd;
    background: #fff;
    color: inherit;
    font: inherit;
    font-size: 0.68rem;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
  }

  .humc-customize__view img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    margin-block-end: 0.2rem;
    background: #f7f7f7;
  }

  .humc-customize__view.is-on {
    border-color: #095aa6;
    box-shadow: inset 0 0 0 1px #095aa6;
  }

  .humc-customize__caption,
  .humc-customize__color-name,
  .humc-customize__summary,
  .humc-customize__tax {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .humc-customize__tax { opacity: 0.7; font-size: 0.75rem; }
  .humc-customize__summary { font-weight: 600; }
  .humc-customize__error { margin: 0; color: #8b1e2d; font-size: 0.875rem; }
  .humc-customize__color-name { min-height: 1.2em; margin-block-end: 0.4rem; }

  .humc-customize__set {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }

  .humc-customize__set legend {
    padding: 0;
    margin-block-end: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .humc-customize__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .humc-customize__swatch {
    appearance: none;
    width: 1.55rem;
    height: 1.55rem;
    padding: 0;
    margin: 0;
    border: 1px solid rgb(0 0 0 / 0.35);
    border-radius: 0;
    background: var(--swatch, #ccc);
    cursor: pointer;
  }

  .humc-customize__swatch.is-light { border-color: rgb(0 0 0 / 0.45); }
  .humc-customize__swatch.is-on {
    outline: 2px solid #121212;
    outline-offset: 2px;
  }

  .humc-customize__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .humc-customize__chip {
    appearance: none;
    margin: 0;
    padding: 0.45rem 0.7rem;
    border: 1px solid #d6d6d6;
    background: #fff;
    color: inherit;
    font: inherit;
    font-size: 0.8rem;
    line-height: 1.2;
    cursor: pointer;
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 140ms ease, border-color 140ms ease;
  }

  .humc-customize__chip.is-on {
    border-color: #121212;
    background: #121212;
    color: #fff;
  }

  .humc-customize__chip:active,
  .humc-customize__swatch:active,
  .humc-customize__view:active {
    transform: scale(0.97);
  }

  .humc-customize__size-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .humc-customize__size-cell {
    display: grid;
    gap: 0.15rem;
    justify-items: center;
    min-width: 2.6rem;
    padding: 0.25rem;
    border: 1px solid #ddd;
    background: #fff;
  }

  .humc-customize__size-cell.is-on {
    border-color: #095aa6;
  }

  .humc-customize__size-label {
    font-size: 0.72rem;
    font-weight: 600;
  }

  .humc-customize__size-qty {
    width: 2.4rem;
    padding: 0.2rem 0.15rem;
    border: 1px solid #ccc;
    text-align: center;
    font: inherit;
    font-size: 0.85rem;
  }

  .humc-customize__crumbs,
  .product-information > .humc-customize__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    margin: 0 0 0.85rem;
    padding-inline: var(--page-margin, 0);
    font-size: 0.75rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    grid-column: 1 / -1;
  }

  .humc-customize__crumbs a {
    color: #666;
    text-decoration: none;
  }

  .humc-customize__crumbs a:hover {
    text-decoration: underline;
  }

  .humc-customize__bullets {
    margin: 0.75rem 0 0;
    padding-inline-start: 1.15rem;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .humc-customize__bullets li {
    margin-block-end: 0.25rem;
  }

  .humc-customize__size-guide {
    margin-block-start: 1.25rem;
  }

  .humc-customize__size-guide-title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
  }

  .humc-customize__size-guide-note {
    margin: 0 0 0.55rem;
    font-size: 0.8rem;
    color: #555;
  }

  .humc-customize__size-table-wrap {
    overflow-x: auto;
  }

  .humc-customize__size-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
  }

  .humc-customize__size-table th,
  .humc-customize__size-table td {
    border: 1px solid #ddd;
    padding: 0.35rem 0.4rem;
    text-align: center;
  }

  .humc-customize__size-table thead th {
    background: #eee;
    font-weight: 600;
  }

  /* Chipply 2-column: photo left (media), buy column right (details) */
  body.has-humc-demo .product-information__grid {
    display: grid !important;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 1.5rem 2rem;
    align-items: start;
  }

  body.has-humc-demo .product-information__media {
    display: block !important;
    width: 100%;
    max-width: none;
  }

  body.has-humc-demo .product-information__media media-gallery,
  body.has-humc-demo .product-information__media .product-media-container,
  body.has-humc-demo .product-information__media .product-media {
    display: none !important;
  }

  body.has-humc-demo .product-information__media .humc-customize__gallery {
    width: 100%;
  }

  body.has-humc-demo .product-details .humc-customize__gallery {
    display: none;
  }

  body.has-humc-demo .buy-buttons,
  body.has-humc-demo .product-form-buttons {
    display: grid;
    gap: 0.5rem;
  }

  body.has-humc-demo .buy-buttons .button,
  body.has-humc-demo button[name="add"] {
    width: 100%;
    min-height: 2.75rem;
    border-radius: 0 !important;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  body.has-humc-demo quantity-selector,
  body.has-humc-demo .quantity-selector,
  body.has-humc-demo .quantity {
    display: none !important;
  }

  @media (max-width: 900px) {
    body.has-humc-demo .product-information__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .humc-customize__chip,
    .humc-customize__swatch,
    .humc-customize__view {
      transition: none;
    }
  }
{% endstylesheet %}

