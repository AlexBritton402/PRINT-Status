{%- comment -%}
  HUMC Gear purchase options + Tapstitch-style design studio.
  Color/size on the page. Logos, lettering, and placement live in a Fabric.js editor.
  Official store marks first; custom logo upload can plug into the same canvas later.
{%- endcomment -%}

{%- liquid
  assign product_resource = closest.product
  assign title = product_resource.title | default: ''
  assign title_l = title | downcase
  assign form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign handle_tail = product_resource.handle | split: '-' | last

  assign needs_size = true
  if title_l contains 'hat' or title_l contains 'bag' or title_l contains 'tumbler' or title_l contains 'tote' or title_l contains 'cap' or title_l contains 'duffle' or title_l contains 'duffel'
    assign needs_size = false
  endif

  assign default_logo = 'Standard HUMC'
  if title contains 'Single Color'
    assign default_logo = 'Single-color HUMC'
  elsif title contains 'LA County'
    assign default_logo = 'LA County'
  endif

  assign sizes = 'S,M,L,XL,2XL,3XL,4XL,5XL' | split: ','

  assign family_phrase = ''
  assign family_id = handle_tail
  if title_l contains 'heavyweight tee'
    assign family_phrase = 'heavyweight tee'
  elsif title_l contains 'drop shoulder'
    assign family_phrase = 'drop shoulder hoodie'
  elsif title_l contains 'sustainable'
    assign family_phrase = 'sustainable full zip hoodie'
  elsif title_l contains 'full zip hoodie'
    assign family_phrase = 'full zip hoodie'
  elsif title_l contains '1/4 zip'
    assign family_phrase = '1/4 zip fleece'
    assign family_id = '18991186'
  elsif title_l contains 'fleece crew'
    assign family_phrase = 'fleece crew'
  elsif title_l contains 'women' and title_l contains 'soft blend'
    assign family_phrase = 'soft blend tee'
  elsif title_l contains 'soft blend tee'
    assign family_phrase = 'unisex soft blend tee'
  elsif title_l contains 'trucker' or title_l contains 'snapback'
    assign family_phrase = 'trucker hat'
    assign family_id = '19193876'
  elsif title_l contains 'canvas bag' or title_l contains 'jumbo'
    assign family_phrase = 'jumbo canvas bag'
    assign family_id = '18416451'
  elsif title_l contains 'tumbler'
    assign family_phrase = 'tumbler'
  endif
-%}

{%- unless title_l contains 'personalization' -%}
<div
  class="humc-customize spacing-style"
  data-humc-customize
  data-humc-design
  data-form-id="{{ form_id }}"
  data-needs-size="{% if needs_size %}true{% else %}false{% endif %}"
  data-product-title="{{ title | escape }}"
  data-product-handle="{{ product_resource.handle | escape }}"
  data-source-id="{{ handle_tail | escape }}"
  data-family="{{ family_phrase | escape }}"
  data-family-id="{{ family_id | escape }}"
  data-preview-map="{{ 'humc-preview.json' | asset_url }}"
  data-asset-base="{{ 'humc-preview.json' | asset_url | split: 'humc-preview.json' | first }}"
  data-mark-standard="{{ 'humc-crest-standard.png' | asset_url }}"
  data-mark-single="{{ 'humc-crest-single.png' | asset_url }}"
  data-mark-la="{{ 'humc-crest-la.png' | asset_url }}"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  <fieldset class="humc-customize__set" data-color-set>
    <legend>Color</legend>
    <p class="humc-customize__color-name" data-color-name></p>
    <div class="humc-customize__swatches" data-swatches role="list"></div>
    <input type="hidden" name="properties[Store]" form="{{ form_id }}" value="HUMC Gear">
    <input type="hidden" name="properties[Color]" form="{{ form_id }}" value="">
  </fieldset>

  {%- if needs_size -%}
    <fieldset class="humc-customize__set">
      <legend>Size</legend>
      <div class="humc-customize__chips" role="list">
        {%- for size in sizes -%}
          <button type="button" class="humc-customize__chip" data-field="size" data-value="{{ size | escape }}" aria-pressed="false">{{ size | escape }}</button>
        {%- endfor -%}
      </div>
      <input type="hidden" name="properties[Size]" form="{{ form_id }}" value="">
    </fieldset>
  {%- else -%}
    <input type="hidden" name="properties[Size]" form="{{ form_id }}" value="One size">
  {%- endif -%}

  <fieldset class="humc-customize__set">
    <legend>Design</legend>
    <button type="button" class="humc-customize__studio-btn" data-humc-design-open>
      Open design studio
    </button>
    <p class="humc-customize__hint">Place official HUMC marks, snap to standard spots, or move freely. Add custom lettering. Same idea as a full design lab — store logos now, custom uploads later.</p>
    <input type="hidden" name="properties[Logo]" form="{{ form_id }}" value="{{ default_logo | escape }}">
    <input type="hidden" name="properties[Print locations]" form="{{ form_id }}" value="Front">
    <input type="hidden" name="properties[Lettering]" form="{{ form_id }}" value="">
    <input type="hidden" name="properties[Design]" form="{{ form_id }}" value="">
  </fieldset>

  <p class="humc-customize__summary" data-summary></p>
  <p class="humc-customize__error" data-error hidden></p>

  <dialog class="humc-design__dialog" data-humc-design-dialog inert aria-labelledby="HumcDesignTitle-{{ block.id }}">
    <div class="humc-design__chrome">
      <div class="humc-design__bar">
        <div>
          <p class="humc-design__kicker">HUMC Gear</p>
          <h2 id="HumcDesignTitle-{{ block.id }}" class="humc-design__title">Design studio</h2>
        </div>
        <button type="button" class="humc-design__icon-btn" data-humc-design-close>Close</button>
      </div>

      <div class="humc-design__layout">
        <div class="humc-design__stage-wrap">
          <canvas data-humc-design-canvas width="600" height="600"></canvas>
          <p class="humc-design__status" data-humc-design-status>Pick a side, add a mark or lettering, then place it.</p>
        </div>

        <aside class="humc-design__tools">
          <fieldset class="humc-design__fieldset">
            <legend>Side</legend>
            <div class="humc-design__chips">
              <button type="button" class="humc-design__chip is-on" data-humc-design-view="Front" aria-pressed="true">Front</button>
              <button type="button" class="humc-design__chip" data-humc-design-view="Back" aria-pressed="false">Back</button>
              <button type="button" class="humc-design__chip" data-humc-design-view="Left" aria-pressed="false">Left</button>
              <button type="button" class="humc-design__chip" data-humc-design-view="Right" aria-pressed="false">Right</button>
            </div>
          </fieldset>

          <fieldset class="humc-design__fieldset">
            <legend>Store logos</legend>
            <div class="humc-design__chips">
              <button type="button" class="humc-design__chip" data-humc-design-mark="Standard HUMC">Standard HUMC</button>
              <button type="button" class="humc-design__chip" data-humc-design-mark="Single-color HUMC">Single-color HUMC</button>
              <button type="button" class="humc-design__chip" data-humc-design-mark="LA County">LA County</button>
            </div>
          </fieldset>

          <fieldset class="humc-design__fieldset">
            <legend>Standard spots</legend>
            <div class="humc-design__chips" data-humc-design-zones></div>
            <p class="humc-design__note">Select a logo or text, then tap a spot to snap. Or drag freely anywhere.</p>
          </fieldset>

          <fieldset class="humc-design__fieldset">
            <legend>Custom lettering</legend>
            <div class="humc-design__text-row">
              <input type="text" class="humc-design__text" data-humc-design-text maxlength="40" placeholder="Name or department" autocomplete="off">
              <input type="color" class="humc-design__color" data-humc-design-text-color value="#ffffff" title="Lettering color" aria-label="Lettering color">
              <button type="button" class="humc-design__chip" data-humc-design-add-text>Add text</button>
            </div>
          </fieldset>

          <div class="humc-design__actions">
            <button type="button" class="humc-design__chip" data-humc-design-delete>Remove selected</button>
            <button type="button" class="humc-design__chip" data-humc-design-clear>Clear this side</button>
            <button type="button" class="humc-design__apply" data-humc-design-apply>Apply design</button>
          </div>
        </aside>
      </div>
    </div>
  </dialog>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-humc-customize')) return;

    var formId = root.getAttribute('data-form-id');
    var needsSize = root.getAttribute('data-needs-size') === 'true';
    var colorInput = root.querySelector('input[name="properties[Color]"]');
    var sizeInput = root.querySelector('input[name="properties[Size]"]');
    var logoInput = root.querySelector('input[name="properties[Logo]"]');
    var placeInput = root.querySelector('input[name="properties[Print locations]"]');
    var summary = root.querySelector('[data-summary]');
    var errorEl = root.querySelector('[data-error]');
    var swatchBox = root.querySelector('[data-swatches]');
    var colorNameEl = root.querySelector('[data-color-name]');
    var preview = null;
    var previewMap = {};
    var currentColorId = '';
    var catalog = { marks: [], extraColors: [] };

    function readCatalog() {
      var el = document.getElementById('store-catalog-config');
      if (!el) return;
      try {
        var data = JSON.parse(el.textContent);
        catalog.marks = data.marks || [];
        catalog.extraColors = data.extraColors || [];
      } catch (err) {}
    }

    function markApplies(mark) {
      var handles = String((mark && mark.handles) || '').trim();
      if (!handles) return true;
      return handles.split(/[\s,]+/).indexOf(root.getAttribute('data-product-handle') || '') !== -1;
    }

    function setPressed(buttons, value) {
      buttons.forEach(function (btn) {
        var on = btn.getAttribute('data-value') === value;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }

    function refresh() {
      var bits = [];
      if (colorInput && colorInput.value) bits.push(colorInput.value);
      if (sizeInput && sizeInput.value) bits.push(sizeInput.value);
      if (logoInput && logoInput.value) bits.push(logoInput.value);
      if (placeInput && placeInput.value) bits.push(placeInput.value);
      if (summary) summary.textContent = bits.length ? bits.join(' · ') : '';
    }

    function showError(msg) {
      if (!errorEl) return;
      errorEl.hidden = !msg;
      errorEl.textContent = msg || '';
    }

    function hasColorChoices() {
      return Boolean(swatchBox && swatchBox.querySelector('[data-field="color"]'));
    }

    function isReady() {
      if (hasColorChoices() && colorInput && !colorInput.value) return 'Pick a garment color.';
      if (needsSize && sizeInput && !sizeInput.value) return 'Pick a size.';
      var design = root.querySelector('input[name="properties[Design]"]');
      if (design && !String(design.value || '').trim()) return 'Open the design studio and apply a design.';
      return '';
    }

    function lookupPreview(sourceId, title) {
      var entry = sourceId && previewMap[sourceId];
      if (entry) {
        entry.id = entry.id || sourceId;
        return entry;
      }
      var familyId = root.getAttribute('data-family-id') || '';
      if (familyId && previewMap[familyId]) {
        entry = previewMap[familyId];
        entry.id = entry.id || familyId;
        return entry;
      }
      var found = null;
      Object.keys(previewMap).some(function (id) {
        if (previewMap[id].title === title) {
          found = previewMap[id];
          found.id = found.id || id;
          return true;
        }
        return false;
      });
      return found;
    }

    function photoUrl(colorId, angle) {
      if (!preview || !preview.id || !colorId) return '';
      var base = root.getAttribute('data-asset-base') || '';
      var familyId = root.getAttribute('data-family-id') || preview.id;
      if (!angle || angle === 'Front') {
        return base + 'humc-m-' + familyId + '-' + colorId + '-plain.jpg';
      }
      if (angle === 'Right') {
        return base + 'humc-m-' + familyId + '-' + colorId + '-right-plain.jpg';
      }
      return base + 'humc-m-' + preview.id + '-' + colorId + '-' + angle.toLowerCase() + '.jpg';
    }

    function stockUrl(colorId, angle) {
      if (!preview || !preview.id || !colorId) return '';
      var base = root.getAttribute('data-asset-base') || '';
      var suffix = !angle || angle === 'Front' ? '' : '-' + angle.toLowerCase();
      return base + 'humc-m-' + preview.id + '-' + colorId + suffix + '.jpg';
    }

    function setGallery(url) {
      if (!url) return;
      var img = document.querySelector('[data-humc-demo-photo]');
      var probe = new Image();
      probe.onload = function () {
        if (img && img.getAttribute('src') !== url) img.setAttribute('src', url);
        document.querySelectorAll('.product-media__image').forEach(function (shopImg) {
          shopImg.setAttribute('src', url);
          shopImg.removeAttribute('srcset');
        });
      };
      probe.onerror = function () {
        var fallback = stockUrl(currentColorId, 'Front');
        if (fallback && fallback !== url) setGallery(fallback);
      };
      probe.src = url;
    }

    function mountDemo() {
      var gallery =
        document.querySelector('media-gallery') ||
        document.querySelector('.product-media-container') ||
        document.querySelector('.product-media');
      var host = (gallery && gallery.parentNode) || document.querySelector('.product-details') || root.parentNode;
      if (!host) return;
      document.body.classList.add('has-humc-demo');
      if (document.querySelector('[data-humc-demo]')) return;
      var demo = document.createElement('div');
      demo.className = 'humc-demo';
      demo.setAttribute('data-humc-demo', '');
      demo.innerHTML =
        '<div class="humc-demo__stage" data-humc-stage data-family="' +
        (root.getAttribute('data-family') || '') +
        '"><img data-humc-demo-photo alt=""></div>' +
        '<p class="humc-demo__caption" data-humc-demo-caption></p>';
      if (gallery) host.insertBefore(demo, gallery);
      else host.insertBefore(demo, host.firstChild);
    }

    function selectColor(name, colorId) {
      currentColorId = colorId || '';
      if (colorInput) colorInput.value = name || '';
      if (colorNameEl) colorNameEl.textContent = name || '';
      root.setAttribute('data-color-id', currentColorId);
      root.setAttribute('data-color-name', name || '');
      root.querySelectorAll('[data-field="color"]').forEach(function (btn) {
        var on = btn.getAttribute('data-value') === name;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      var prefer = photoUrl(currentColorId, 'Front');
      setGallery(prefer || stockUrl(currentColorId, 'Front'));
      var caption = document.querySelector('[data-humc-demo-caption]');
      if (caption) caption.textContent = [name, 'Ready to design'].filter(Boolean).join(' · ');
      if (window.humcDesignSetColor) window.humcDesignSetColor(name, colorId);
      showError('');
      refresh();
    }

    function extraColorsForProduct() {
      return (catalog.extraColors || []).filter(function (color) {
        return color && color.name && markApplies(color);
      });
    }

    function renderSwatches(entry) {
      preview = entry;
      if (!swatchBox || !entry || !entry.colors) return;
      var colors = entry.colors.slice();
      extraColorsForProduct().forEach(function (extra) {
        if (colors.some(function (c) { return c.name.toLowerCase() === String(extra.name || '').toLowerCase(); })) return;
        colors.push({ id: extra.id || '', name: extra.name, hex: extra.hex || '#ccc' });
      });
      var seen = {};
      colors = colors.filter(function (color) {
        var key = String(color.name || color.id);
        if (seen[key]) return false;
        seen[key] = true;
        return true;
      });
      swatchBox.innerHTML = '';
      colors.forEach(function (color) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'humc-customize__swatch';
        btn.setAttribute('data-field', 'color');
        btn.setAttribute('data-value', color.name);
        btn.setAttribute('data-color-id', String(color.id));
        btn.setAttribute('title', color.name);
        btn.setAttribute('aria-label', color.name);
        btn.setAttribute('aria-pressed', 'false');
        btn.style.setProperty('--swatch', color.hex || '#ccc');
        if (/white|ash|natural|cornsilk|ice grey|light pink|yellow/i.test(color.name)) btn.classList.add('is-light');
        swatchBox.appendChild(btn);
      });
      mountDemo();
      var chosen =
        colors.find(function (c) { return String(c.id) === String(entry.default); }) ||
        colors.find(function (c) { return c.name === 'Black'; }) ||
        colors[0];
      if (chosen) selectColor(chosen.name, chosen.id);
    }

    document.addEventListener(
      'click',
      function (event) {
        if (!root.isConnected) return;
        var t = event.target;
        if (!t || !t.closest) return;
        var colorBtn = t.closest('[data-field="color"]');
        if (colorBtn && root.contains(colorBtn)) {
          selectColor(colorBtn.getAttribute('data-value'), colorBtn.getAttribute('data-color-id'));
          return;
        }
        var sizeBtn = t.closest('[data-field="size"]');
        if (sizeBtn && root.contains(sizeBtn)) {
          if (sizeInput) sizeInput.value = sizeBtn.getAttribute('data-value') || '';
          setPressed(root.querySelectorAll('[data-field="size"]'), sizeInput.value);
          showError('');
          refresh();
        }
      },
      true
    );

    document.addEventListener(
      'click',
      function (event) {
        var btn = event.target.closest('[name="add"]');
        if (!btn) return;
        var form = document.getElementById(formId);
        if (!form) return;
        var belongs = btn.form === form || btn.getAttribute('form') === formId || form.contains(btn);
        if (!belongs) return;
        var msg = isReady();
        if (msg) {
          event.preventDefault();
          event.stopPropagation();
          if (event.stopImmediatePropagation) event.stopImmediatePropagation();
          showError(msg);
          root.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      },
      true
    );

    document.addEventListener(
      'submit',
      function (event) {
        var form = event.target;
        if (!form || form.id !== formId) return;
        var msg = isReady();
        if (msg) {
          event.preventDefault();
          event.stopPropagation();
          showError(msg);
        }
      },
      true
    );

    readCatalog();
    refresh();
    var mapUrl = root.getAttribute('data-preview-map');
    if (mapUrl) {
      fetch(mapUrl)
        .then(function (res) { return res.json(); })
        .then(function (map) {
          previewMap = map;
          var entry = lookupPreview(root.getAttribute('data-source-id'), root.getAttribute('data-product-title'));
          if (entry) renderSwatches(entry);
          else {
            var colorSet = root.querySelector('[data-color-set]');
            if (colorSet) colorSet.hidden = true;
            selectColor('As shown', '');
          }
        })
        .catch(function () {
          selectColor('As shown', '');
        });
    }
  })();
</script>

<script src="{{ 'fabric.min.js' | asset_url }}" defer></script>
<script src="{{ 'humc-design.js' | asset_url }}" defer></script>
{%- endunless -%}

{%- if title_l contains 'personalization' -%}
  <input type="hidden" name="properties[Store]" form="{{ form_id }}" value="HUMC Gear">
{%- endif -%}

{% stylesheet %}
  .humc-customize {
    display: grid;
    gap: 1.1rem;
    width: 100%;
  }

  .humc-customize__hint,
  .humc-customize__summary,
  .humc-customize__color-name {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .humc-customize__hint { opacity: 0.7; }
  .humc-customize__color-name { min-height: 1.2em; margin-block-end: 0.45rem; }
  .humc-customize__summary { font-weight: 600; }
  .humc-customize__error { margin: 0; color: #8b1e2d; font-size: 0.875rem; }

  .humc-customize__set {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }

  .humc-customize__set legend {
    padding: 0;
    margin-block-end: 0.45rem;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .humc-customize__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }

  .humc-customize__swatch {
    appearance: none;
    width: 1.05rem;
    height: 1.05rem;
    padding: 0;
    margin: 0;
    border: 1px solid rgb(0 0 0 / 0.28);
    border-radius: 50%;
    background: var(--swatch, #ccc);
    cursor: pointer;
  }

  .humc-customize__swatch.is-light { border-color: rgb(0 0 0 / 0.4); }
  .humc-customize__swatch.is-on { outline: 2px solid #121212; outline-offset: 2px; }

  .humc-customize__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .humc-customize__chip,
  .humc-customize__studio-btn,
  .humc-design__chip,
  .humc-design__apply,
  .humc-design__icon-btn {
    appearance: none;
    margin: 0;
    padding: 0.45rem 0.75rem;
    border: 1px solid #d6d6d6;
    background: #fff;
    color: inherit;
    font: inherit;
    font-size: 0.8rem;
    line-height: 1.2;
    cursor: pointer;
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 140ms ease, border-color 140ms ease;
  }

  .humc-customize__chip.is-on,
  .humc-design__chip.is-on {
    border-color: #121212;
    background: #121212;
    color: #fff;
  }

  .humc-customize__studio-btn,
  .humc-design__apply {
    border-color: #095aa6;
    background: #095aa6;
    color: #fff;
    font-weight: 600;
  }

  .humc-customize__chip:active,
  .humc-customize__studio-btn:active,
  .humc-customize__swatch:active,
  .humc-design__chip:active,
  .humc-design__apply:active {
    transform: scale(0.97);
  }

  .humc-body.has-humc-demo media-gallery,
  .humc-body.has-humc-demo .product-media-container,
  .humc-body.has-humc-demo .product-media {
    display: none !important;
  }

  .humc-demo { max-width: 600px; }

  .humc-demo__stage {
    position: relative;
    background: #fff;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .humc-demo__stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  .humc-demo__caption {
    margin: 0.55rem 0 0.7rem;
    font-size: 0.8rem;
  }

  .humc-design__dialog {
    width: min(1040px, 96vw);
    max-height: 94vh;
    padding: 0;
    border: 1px solid #d6d6d6;
    background: #fff;
    color: #121212;
  }

  .humc-design__dialog::backdrop {
    background: rgb(18 18 18 / 0.55);
  }

  .humc-design__chrome {
    display: grid;
    gap: 0.85rem;
    padding: 0.9rem;
  }

  .humc-design__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .humc-design__kicker {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #095aa6;
  }

  .humc-design__title {
    margin: 0.15rem 0 0;
    font-size: 1.15rem;
  }

  .humc-design__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: 0.9rem;
    align-items: start;
  }

  .humc-design__stage-wrap {
    background: #f3f3f3;
    padding: 0.55rem;
    min-height: 12rem;
  }

  /* Fabric owns canvas pixel size; only scale the wrapper so lower/upper stay aligned */
  .humc-design__stage-wrap .canvas-container {
    margin: 0 auto !important;
    max-width: 100%;
  }

  .humc-design__status,
  .humc-design__note {
    margin: 0.55rem 0 0;
    font-size: 0.8rem;
    line-height: 1.35;
    opacity: 0.75;
  }

  .humc-design__tools {
    display: grid;
    gap: 0.85rem;
  }

  .humc-design__fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .humc-design__fieldset legend {
    padding: 0;
    margin-block-end: 0.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .humc-design__chips,
  .humc-design__actions,
  .humc-design__text-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .humc-design__text {
    flex: 1 1 8rem;
    min-width: 0;
    padding: 0.4rem 0.5rem;
    border: 1px solid #d6d6d6;
    font: inherit;
    font-size: 0.85rem;
  }

  .humc-design__color {
    width: 2.2rem;
    height: 2.2rem;
    padding: 0;
    border: 1px solid #d6d6d6;
    background: #fff;
  }

  .humc-design__apply {
    width: 100%;
  }

  @media (max-width: 820px) {
    .humc-design__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .humc-customize__chip,
    .humc-customize__studio-btn,
    .humc-customize__swatch,
    .humc-design__chip,
    .humc-design__apply {
      transition: none;
    }
  }
{% endstylesheet %}

