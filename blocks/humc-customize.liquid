  }

  .humc-customize__view img[data-humc-view-layer].is-left-chest {
    width: 10.3%;
    left: 55.8%;
    top: 23.8%;
  }

  body[data-humc-kind='zip'] .humc-customize__view img[data-humc-view-layer].is-left-chest {
    width: 11.3%;
    left: 56.2%;
    top: 26%;
  }

  .humc-customize__view img[data-humc-view-layer].is-full-chest {
    width: 30.4%;
    left: 35.7%;
    top: 23.8%;
  }

  .humc-customize__view img[data-humc-view-layer].is-full-back {
    width: 27%;
    left: 37.1%;
    top: 22%;
  }

  body[data-humc-kind='zip'] .humc-customize__view img[data-humc-view-layer].is-full-back {
