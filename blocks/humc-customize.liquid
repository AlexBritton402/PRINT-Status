{%- comment -%}
  HUMC CUSTOMIZABLE PDPs — match vv Radiant shopper view:
  Front / Back / Right sleeve, jacket/shirt color swatches, design/logo,
  quantity (no Chipply size grid). Pre-meshed mockup photos only.
  Non-customizable catalog SKUs keep a simple Horizon buy box (like vv).
{%- endcomment -%}

{%- liquid
  assign product_resource = closest.product
  assign title = product_resource.title | default: ''
  assign title_l = title | downcase
  assign form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign handle_tail = product_resource.handle | split: '-' | last

  assign is_customizable = false
  if title_l contains 'customizable'
    assign is_customizable = true
  endif

  comment
    vv CUSTOMIZABLE uses quantity only — no XS–4XL size matrix.
  endcomment
  assign needs_size = false

  assign default_logo = 'LA County'
  assign family_id = ''
  assign show_logo_picker = false
  assign logo_map_kind = 'none'
  assign color_legend = 'Color'
  if is_customizable
    assign show_logo_picker = true
  endif
  if title_l contains 'soft blend'
    assign logo_map_kind = 'soft-tee'
    assign color_legend = 'Shirt color'
  elsif title_l contains '1/4 zip' or title_l contains 'zip fleece'
    assign logo_map_kind = 'zip'
    assign color_legend = 'Jacket color'
  endif
  comment
    Prefer LA County left-chest look to match vv default design.
  endcomment
  if title contains 'Standard HUMC' or title contains 'w/ Standard'
    assign default_logo = 'Standard HUMC'
  elsif title contains 'Single Color' or title contains 'Single-color'
    assign default_logo = 'Single-color HUMC'
  elsif title contains 'LA County'
    assign default_logo = 'LA County'
  endif

  comment
    Chipply source id when baked into the handle (...-18991186).
  endcomment
  if handle_tail == '20857516' or handle_tail == '19193821' or handle_tail == '19027956' or handle_tail == '18991476' or handle_tail == '19028676' or handle_tail == '18993506' or handle_tail == '18867111' or handle_tail == '18991186' or handle_tail == '18991311' or handle_tail == '18991341' or handle_tail == '18993671' or handle_tail == '18861296' or handle_tail == '19193761' or handle_tail == '18993686' or handle_tail == '19193831' or handle_tail == '18991396' or handle_tail == '18991431' or handle_tail == '19193876' or handle_tail == '18416451' or handle_tail == '18417261' or handle_tail == '18753436' or handle_tail == '13923078' or handle_tail == '23857561'
    assign family_id = handle_tail
  endif

  assign family_phrase = ''
  if title_l contains 'heavyweight tee'
    assign family_phrase = 'heavyweight tee'
    if family_id == blank
      assign family_id = '20857516'
    endif
  elsif title_l contains 'drop shoulder' and title_l contains 'la county'
    assign family_phrase = 'drop shoulder hoodie'
    if family_id == blank
      assign family_id = '18993671'
    endif
  elsif title_l contains 'drop shoulder'
    assign family_phrase = 'drop shoulder hoodie'
    if family_id == blank
      assign family_id = '18993686'
    endif
  elsif title_l contains 'sustainable'
    assign family_phrase = 'sustainable full zip hoodie'
    if family_id == blank
      assign family_id = '19193761'
    endif
  elsif title_l contains 'full zip hoodie' and title_l contains 'standard'
    assign family_phrase = 'full zip hoodie'
    if family_id == blank
      assign family_id = '18991341'
    endif
  elsif title_l contains 'full zip hoodie' and title_l contains 'single'
    assign family_phrase = 'full zip hoodie'
    if family_id == blank
      assign family_id = '18991311'
    endif
  elsif title_l contains 'full zip hoodie'
    assign family_phrase = 'full zip hoodie'
    if family_id == blank
      assign family_id = '18861296'
    endif
  elsif title_l contains '1/4 zip' or title_l contains 'zip fleece'
    assign family_phrase = '1/4 zip fleece'
    if family_id == blank
      if default_logo == 'Single-color HUMC'
        assign family_id = '18867111'
      elsif default_logo == 'LA County'
        assign family_id = '18993506'
      else
        assign family_id = '18991186'
      endif
    endif
  elsif title_l contains 'fleece crew' and title_l contains 'la county'
    assign family_phrase = 'fleece crew'
    if family_id == blank
      assign family_id = '18991431'
    endif
  elsif title_l contains 'fleece crew'
    assign family_phrase = 'fleece crew'
    if family_id == blank
      assign family_id = '18991396'
    endif
  elsif title_l contains 'soft blend tee' and title_l contains 'women'
    assign family_phrase = 'women soft blend tee'
    if family_id == blank
      assign family_id = '19028676'
    endif
  elsif title_l contains 'soft blend tee' and title_l contains 'front and back'
    assign family_phrase = 'unisex soft blend tee'
    if family_id == blank
      assign family_id = '18991476'
    endif
  elsif title_l contains 'soft blend tee'
    assign family_phrase = 'unisex soft blend tee'
    if family_id == blank
      if default_logo == 'LA County'
        assign family_id = '18991476'
      elsif title contains '19193821' or product_resource.handle contains '19193821'
        assign family_id = '19193821'
      else
        assign family_id = '19027956'
      endif
    endif
  endif

  assign sizes = 'S,M,L,XL,2XL' | split: ','
-%}

{%- if is_customizable -%}
<div
  class="humc-customize spacing-style"
  data-humc-customize
  data-form-id="{{ form_id }}"
  data-needs-size="false"
  data-product-title="{{ title | escape }}"
  data-product-handle="{{ product_resource.handle | escape }}"
  data-source-id="{{ handle_tail | escape }}"
  data-family="{{ family_phrase | escape }}"
  data-family-id="{{ family_id | escape }}"
  data-logo-name="{{ default_logo | escape }}"
  data-show-logo-picker="{% if show_logo_picker %}true{% else %}false{% endif %}"
  data-logo-map-kind="{{ logo_map_kind | escape }}"
  data-family-phrase="{{ family_phrase | escape }}"
  data-color-legend="{{ color_legend | escape }}"
  data-preview-map="{{ 'humc-preview.json' | asset_url }}"
  data-asset-base="{{ 'humc-preview.json' | asset_url | split: 'humc-preview.json' | first }}"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  <nav class="humc-customize__crumbs" data-humc-crumbs aria-label="Breadcrumb">
    <a href="{{ pages['humc-gear'].url | default: '/pages/humc-gear' }}">Home</a>
    <span aria-hidden="true">›</span>
    <a href="{{ collections['humc-gear'].url | default: '/collections/humc-gear' }}">Products</a>
    <span aria-hidden="true">›</span>
    <span>Catalog</span>
    <span aria-hidden="true">›</span>
    <span data-humc-crumb-title>{{ title | escape }}</span>
  </nav>

  {%- comment -%} Stage only moves into Horizon media; view tabs stay with the buy form like vv Zepto. {%- endcomment -%}
  <div class="humc-customize__gallery" data-humc-gallery>
    <div class="humc-customize__stage" data-humc-stage>
      <img data-humc-demo-photo alt="{{ title | escape }}" width="600" height="600">
      <img data-humc-design-layer alt="" width="600" height="600" hidden>
    </div>
    <p class="humc-customize__caption" data-humc-demo-caption></p>
  </div>

  <div
    class="humc-customize__views{% if logo_map_kind == 'soft-tee' %} humc-customize__views--tee{% elsif logo_map_kind == 'zip' %} humc-customize__views--zip{% endif %}"
    data-humc-views
    role="tablist"
    aria-label="Product views"
  >
    {%- if logo_map_kind == 'soft-tee' -%}
      <button type="button" class="humc-customize__view is-on" data-view="Front" aria-pressed="true">
        <span class="humc-customize__thumb" data-humc-thumb-stage="Front">
          <img data-humc-view-thumb="Front" alt="" width="72" height="72">
          <img data-humc-view-layer="Front" alt="" width="72" height="72" hidden>
        </span>
        <span>Front design</span>
      </button>
      <button type="button" class="humc-customize__view" data-view="Back" aria-pressed="false">
        <span class="humc-customize__thumb" data-humc-thumb-stage="Back">
          <img data-humc-view-thumb="Back" alt="" width="72" height="72">
          <img data-humc-view-layer="Back" alt="" width="72" height="72" hidden>
        </span>
        <span>Back design</span>
      </button>
    {%- else -%}
      <button type="button" class="humc-customize__view is-on" data-view="Front" aria-pressed="true">
        <span class="humc-customize__thumb" data-humc-thumb-stage="Front">
          <img data-humc-view-thumb="Front" alt="" width="72" height="72">
          <img data-humc-view-layer="Front" alt="" width="72" height="72" hidden>
        </span>
        <span>Front</span>
      </button>
      <button type="button" class="humc-customize__view" data-view="Back" aria-pressed="false">
        <span class="humc-customize__thumb" data-humc-thumb-stage="Back">
          <img data-humc-view-thumb="Back" alt="" width="72" height="72">
          <img data-humc-view-layer="Back" alt="" width="72" height="72" hidden>
        </span>
        <span>Back</span>
      </button>
      <button type="button" class="humc-customize__view" data-view="Right" aria-pressed="false">
        <span class="humc-customize__thumb" data-humc-thumb-stage="Right">
          <img data-humc-view-thumb="Right" alt="" width="72" height="72">
          <img data-humc-view-layer="Right" alt="" width="72" height="72" hidden>
        </span>
        <span>Right sleeve</span>
      </button>
    {%- endif -%}
  </div>

  {%- comment -%}
    vv Zepto: each angle tab exposes that location's color + design.
    Front / Back / Right sleeve each keep their own design (incl. BLANK).
  {%- endcomment -%}
  <fieldset class="humc-customize__set" data-color-set data-location-panel="color">
    <legend data-color-legend>{{ color_legend | escape }}</legend>
    <p class="humc-customize__color-name" data-color-name></p>
    <div class="humc-customize__swatches" data-swatches role="list"></div>
    <input type="hidden" name="properties[Store]" form="{{ form_id }}" value="HUMC Gear">
    <input type="hidden" name="properties[Color]" form="{{ form_id }}" value="">
    <input type="hidden" name="properties[Front design]" form="{{ form_id }}" value="Left Chest LA County" data-design-input="Front">
    <input type="hidden" name="properties[Back design]" form="{{ form_id }}" value="BLANK" data-design-input="Back">
    <input type="hidden" name="properties[Right sleeve design]" form="{{ form_id }}" value="BLANK" data-design-input="Right">
    <input type="hidden" name="properties[Logo]" form="{{ form_id }}" value="{{ default_logo | escape }}">
    <input type="hidden" name="properties[Print locations]" form="{{ form_id }}" value="As shown">
  </fieldset>

  {%- if show_logo_picker -%}
    {%- comment -%} Full vv Zepto design lists (docs/reference/vv/ZEPTO.md). Layers = assets/pz-*.png {%- endcomment -%}
    <fieldset class="humc-customize__set" data-design-panel="Front">
      <legend data-design-legend>Front design</legend>
      <div class="humc-customize__chips humc-customize__chips--design" role="list" data-design-chips="Front">
        <button type="button" class="humc-customize__chip is-on" data-field="design" data-location="Front" data-value="Left Chest LA County" data-layer="pz-LC-LA-COUNTY.png" aria-pressed="true">Left Chest LA County</button>
        <button type="button" class="humc-customize__chip" data-field="design" data-location="Front" data-value="Left Chest White LA County" data-layer="pz-LC-WHITE-LA-CO.png" aria-pressed="false">Left Chest White LA County</button>
        <button type="button" class="humc-customize__chip" data-field="design" data-location="Front" data-value="Left Chest Full Color HUMC" data-layer="pz-LC-FC-HUMC.png" aria-pressed="false">Left Chest Full Color HUMC</button>
        <button type="button" class="humc-customize__chip" data-field="design" data-location="Front" data-value="Left Chest White HUMC" data-layer="pz-LC-WHITE-HUMC.png" aria-pressed="false">Left Chest White HUMC</button>
        {%- if logo_map_kind == 'soft-tee' -%}
          <button type="button" class="humc-customize__chip" data-field="design" data-location="Front" data-value="Full Chest LA County" data-layer="pz-FC-LA-COUNTY.png" aria-pressed="false">Full Chest LA County</button>
          <button type="button" class="humc-customize__chip" data-field="design" data-location="Front" data-value="Full Chest White LA County" data-layer="pz-FC-WHITE-LA-CO.png" aria-pressed="false">Full Chest White LA County</button>
          <button type="button" class="humc-customize__chip" data-field="design" data-location="Front" data-value="Full Chest Full Color HUMC" data-layer="pz-FC-FC-HUMC.png" aria-pressed="false">Full Chest Full Color HUMC</button>
          <button type="button" class="humc-customize__chip" data-field="design" data-location="Front" data-value="Full Chest White HUMC" data-layer="pz-FC-WHITE-HUMC.png" aria-pressed="false">Full Chest White HUMC</button>
        {%- endif -%}
      </div>
    </fieldset>

    <fieldset class="humc-customize__set" data-design-panel="Back" hidden>
      <legend>Back design</legend>
      <div class="humc-customize__chips humc-customize__chips--design" role="list" data-design-chips="Back">
        <button type="button" class="humc-customize__chip is-on" data-field="design" data-location="Back" data-value="BLANK" data-layer="" aria-pressed="true">BLANK</button>
        <button type="button" class="humc-customize__chip" data-field="design" data-location="Back" data-value="Full Back LA County" data-layer="pz-FC-LA-COUNTY.png" aria-pressed="false">Full Back LA County</button>
        <button type="button" class="humc-customize__chip" data-field="design" data-location="Back" data-value="Full Back White LA County" data-layer="pz-FC-WHITE-LA-CO.png" aria-pressed="false">Full Back White LA County</button>
        <button type="button" class="humc-customize__chip" data-field="design" data-location="Back" data-value="Full Back Full Color HUMC" data-layer="pz-FC-FC-HUMC.png" aria-pressed="false">Full Back Full Color HUMC</button>
        <button type="button" class="humc-customize__chip" data-field="design" data-location="Back" data-value="Full Back White HUMC" data-layer="pz-FC-WHITE-HUMC.png" aria-pressed="false">Full Back White HUMC</button>
      </div>
    </fieldset>

    {%- if logo_map_kind == 'zip' -%}
      <fieldset class="humc-customize__set" data-design-panel="Right" hidden>
        <legend>Right sleeve design</legend>
        <div class="humc-customize__chips humc-customize__chips--design" role="list" data-design-chips="Right">
          <button type="button" class="humc-customize__chip is-on" data-field="design" data-location="Right" data-value="BLANK" data-layer="" aria-pressed="true">BLANK</button>
          <button type="button" class="humc-customize__chip" data-field="design" data-location="Right" data-value="LA County" data-layer="pz-FC-LA-COUNTY.png" aria-pressed="false">LA County</button>
          <button type="button" class="humc-customize__chip" data-field="design" data-location="Right" data-value="White LA County" data-layer="pz-FC-WHITE-LA-CO.png" aria-pressed="false">White LA County</button>
          <button type="button" class="humc-customize__chip" data-field="design" data-location="Right" data-value="Full Color HUMC" data-layer="pz-FC-FC-HUMC.png" aria-pressed="false">Full Color HUMC</button>
          <button type="button" class="humc-customize__chip" data-field="design" data-location="Right" data-value="White HUMC" data-layer="pz-FC-WHITE-HUMC.png" aria-pressed="false">White HUMC</button>
        </div>
      </fieldset>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} vv CUSTOMIZABLE uses quantity only — no size matrix on the shopper PDP. {%- endcomment -%}
  <input type="hidden" name="properties[Size]" form="{{ form_id }}" value="">

  <p class="humc-customize__summary" data-summary></p>
  <p class="humc-customize__error" data-error hidden></p>
  <div class="humc-customize__buy-slot" data-humc-buy-slot></div>
  <p class="humc-customize__tax">*Tax collected only if you are in the state of California.</p>

</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-humc-customize')) return;

    var formId = root.getAttribute('data-form-id');
    var needsSize = root.getAttribute('data-needs-size') === 'true';
    var showLogoPicker = root.getAttribute('data-show-logo-picker') === 'true';
    var colorInput = root.querySelector('input[name="properties[Color]"]');
    var sizeInput = root.querySelector('input[name="properties[Size]"]');
    var logoInput = root.querySelector('input[name="properties[Logo]"]');
    var placeInput = root.querySelector('input[name="properties[Print locations]"]');
    var colorNameEl = root.querySelector('[data-color-name]');
    var swatchBox = root.querySelector('[data-swatches]');
    var summary = root.querySelector('[data-summary]');
    var errorEl = root.querySelector('[data-error]');
    var photo = root.querySelector('[data-humc-demo-photo]');
    var layerImg = root.querySelector('[data-humc-design-layer]');
    var caption = root.querySelector('[data-humc-demo-caption]');

    var previewMap = {};
    var catalog = { marks: [], extraColors: [] };
    var preview = null;
    var currentColorId = '';
    var currentColorName = '';
    var currentView = 'Front';
    var familyId = root.getAttribute('data-family-id') || '';
    var logoMapKind = root.getAttribute('data-logo-map-kind') || 'zip';

    // Per-location designs — mirrors vv Zepto FRONT / BACK / RIGHT SLEEVE design fields.
    var designs = {
      Front: 'Left Chest LA County',
      Back: 'BLANK',
      Right: 'BLANK'
    };

    // Trimmed Zepto stamps + placement class (full-canvas overlays were oversized on these blanks).
    var DESIGN_LAYER = {
      'Left Chest LA County': { file: 'pz-stamp-LC-LA-COUNTY.png', place: 'left-chest' },
      'Left Chest White LA County': { file: 'pz-stamp-LC-WHITE-LA-CO.png', place: 'left-chest' },
      'Left Chest Full Color HUMC': { file: 'pz-stamp-LC-FC-HUMC.png', place: 'left-chest' },
      'Left Chest White HUMC': { file: 'pz-stamp-LC-WHITE-HUMC.png', place: 'left-chest' },
      'Full Chest LA County': { file: 'pz-stamp-FC-LA-COUNTY.png', place: 'full-chest' },
      'Full Chest White LA County': { file: 'pz-stamp-FC-WHITE-LA-CO.png', place: 'full-chest' },
      'Full Chest Full Color HUMC': { file: 'pz-stamp-FC-FC-HUMC.png', place: 'full-chest' },
      'Full Chest White HUMC': { file: 'pz-stamp-FC-WHITE-HUMC.png', place: 'full-chest' },
      'Full Back LA County': { file: 'pz-stamp-FC-LA-COUNTY.png', place: 'full-back' },
      'Full Back White LA County': { file: 'pz-stamp-FC-WHITE-LA-CO.png', place: 'full-back' },
      'Full Back Full Color HUMC': { file: 'pz-stamp-FC-FC-HUMC.png', place: 'full-back' },
      'Full Back White HUMC': { file: 'pz-stamp-FC-WHITE-HUMC.png', place: 'full-back' },
      'LA County': { file: 'pz-stamp-LC-LA-COUNTY.png', place: 'sleeve' },
      'White LA County': { file: 'pz-stamp-LC-WHITE-LA-CO.png', place: 'sleeve' },
      'Full Color HUMC': { file: 'pz-stamp-LC-FC-HUMC.png', place: 'sleeve' },
      'White HUMC': { file: 'pz-stamp-LC-WHITE-HUMC.png', place: 'sleeve' },
      BLANK: null
    };

    // Color-map family ids (for swatch catalog lookup only).
    var COLOR_FAMILY = logoMapKind === 'soft-tee' ? '18991476' : '18993506';
    familyId = COLOR_FAMILY;

    // Map our swatch names → Zepto blank garment file slugs (assets/pz-tee-* / pz-zip-*).
    var TEE_GARMENT = {
      'Aqua Heather': 'aqua-heather',
      'Awareness Pink Heather': 'awareness-pink',
      Black: 'black',
      'Blush Frost': 'blush-frost',
      Charcoal: 'charcoal',
      'Deep Orange Heather': 'deep-orange'
    };
    var ZIP_GARMENT = {
      Black: 'black',
      Charcoal: 'charcoal',
      'Heathered Charcoal': 'heather-charcoal',
      'Light Heather Grey': 'light-heather',
      'New Navy': 'navy',
      'Deep Royal': 'royal'
    };

    function assetBase() {
      return root.getAttribute('data-asset-base') || '';
    }

    // Stage may move into Horizon media; view tabs stay on the form. Query both.
    function galleryHost() {
      return document.querySelector('[data-humc-gallery]') || root;
    }
    function viewsHost() {
      return root.querySelector('[data-humc-views]') || document.querySelector('[data-humc-views]') || root;
    }

    function colorLegendFor(view) {
      if (logoMapKind === 'soft-tee') {
        return view === 'Back' ? 'Shirt color back' : 'Shirt color front';
      }
      if (view === 'Back') return 'Back jacket color';
      if (view === 'Right') return 'Jacket sleeve color';
      return 'Jacket color';
    }

    function designLabelFor(view) {
      if (logoMapKind === 'soft-tee') {
        return view === 'Back' ? 'Back design' : 'Front design';
      }
      if (view === 'Back') return 'Back design';
      if (view === 'Right') return 'Right sleeve design';
      return 'Front design';
    }

    function layerFor(designName) {
      if (!designName || designName === 'BLANK') return null;
      return DESIGN_LAYER[designName] || null;
    }

    // Bump when garment/stamp assets are replaced so CDN/browser cache cannot keep stale frames.
    var ASSET_V = '20261104b';

    function layerUrl(file) {
      if (!file) return '';
      return assetBase() + file + (file.indexOf('?') >= 0 ? '&' : '?') + 'v=' + ASSET_V;
    }

    function garmentUrl(path) {
      if (!path) return '';
      return path + (path.indexOf('?') >= 0 ? '&' : '?') + 'v=' + ASSET_V;
    }

    function setDesignLayer(designName) {
      layerImg = document.querySelector('[data-humc-design-layer]') || layerImg;
      if (!layerImg) return;
      var spec = layerFor(designName);
      layerImg.className = '';
      if (!spec || !spec.file) {
        layerImg.removeAttribute('src');
        layerImg.hidden = true;
        return;
      }
      layerImg.classList.add('is-' + (spec.place || 'left-chest'));
      layerImg.setAttribute('src', layerUrl(spec.file));
      layerImg.hidden = false;
    }

    function syncDesignInputs() {
      Object.keys(designs).forEach(function (loc) {
        var input = root.querySelector('[data-design-input="' + loc + '"]');
        if (input) input.value = designs[loc];
      });
      if (logoInput) {
        logoInput.value = ['Front: ' + designs.Front, 'Back: ' + designs.Back]
          .concat(logoMapKind === 'zip' ? ['Right: ' + designs.Right] : [])
          .join(' · ');
      }
      if (placeInput) {
        var parts = [];
        if (designs.Front && designs.Front !== 'BLANK') parts.push('Front');
        if (designs.Back && designs.Back !== 'BLANK') parts.push('Back');
        if (logoMapKind === 'zip' && designs.Right && designs.Right !== 'BLANK') parts.push('Right sleeve');
        placeInput.value = parts.length ? parts.join(', ') : 'As shown';
      }
    }

    function showLocationPanels(view) {
      root.querySelectorAll('[data-design-panel]').forEach(function (panel) {
        var loc = panel.getAttribute('data-design-panel');
        panel.hidden = loc !== view;
      });
      var legend = root.querySelector('[data-color-legend]');
      if (legend) legend.textContent = colorLegendFor(view);
      // vv still shows color on every tab (shirt/jacket/sleeve color labels change).
      var colorSet = root.querySelector('[data-color-set]');
      if (colorSet) colorSet.hidden = false;
    }

    function mountChipplyLayout() {
      document.body.classList.add('has-humc-demo');
      document.body.setAttribute('data-humc-kind', logoMapKind);
      var gallery = root.querySelector('[data-humc-gallery]');
      var media = document.querySelector('.product-information__media');
      if (gallery && media && gallery.parentNode !== media) {
        media.innerHTML = '';
        media.appendChild(gallery);
      }
      var crumbs = root.querySelector('[data-humc-crumbs]');
      var section = document.querySelector('.product-information.section') || document.querySelector('.product-information');
      if (crumbs && section && crumbs.parentNode !== section) {
        section.insertBefore(crumbs, section.firstChild);
      }
      // Chipply order: size → Add to cart → tax → bullets → size guide
      function placeBuy() {
        var slot = root.querySelector('[data-humc-buy-slot]');
        var buy =
          document.querySelector('.product-form-buttons') ||
          document.querySelector('.buy-buttons') ||
          document.querySelector('add-to-cart-component') ||
          document.querySelector('[name="add"]');
        if (slot && buy && buy.parentNode !== slot) {
          slot.appendChild(buy);
          return true;
        }
        return !!(slot && buy);
      }
      placeBuy();
      [100, 400, 1000, 2000].forEach(function (ms) {
        window.setTimeout(placeBuy, ms);
      });
      // Hide leftover Horizon back-link / qty stepper
      document.querySelectorAll('a').forEach(function (a) {
        if (/back to humc/i.test(a.textContent || '')) a.style.display = 'none';
      });
      // Keep Horizon quantity stepper — vv CUSTOMIZABLE uses quantity, not a size matrix.
    }

    function syncListingTitle() {
      // Keep the Shopify listing title (e.g. "… - CUSTOMIZABLE") — vv does not rename the H1
      // when the shopper picks a left-chest logo. Only update the breadcrumb trail quietly.
      var crumb = root.querySelector('[data-humc-crumb-title]');
      if (crumb && root.getAttribute('data-product-title')) {
        crumb.textContent = root.getAttribute('data-product-title');
      }
    }

    function showError(msg) {
      if (!errorEl) return;
      errorEl.hidden = !msg;
      errorEl.textContent = msg || '';
    }

    function refreshSummary() {
      if (!summary) return;
      var bits = [currentColorName, designLabelFor(currentView) + ' — ' + (designs[currentView] || 'BLANK')];
      summary.textContent = bits.filter(Boolean).join(' · ');
    }

    function garmentSlug() {
      var map = logoMapKind === 'soft-tee' ? TEE_GARMENT : ZIP_GARMENT;
      return map[currentColorName] || map.Black || 'black';
    }

    function urlForLocation(location) {
      // Zepto blank garments + pz design layer (not Chipply meshed packs — those double-print logos).
      var slug = garmentSlug();
      var angle = location || 'Front';
      var path;
      if (logoMapKind === 'soft-tee') {
        if (angle === 'Back') {
          if (slug === 'deep-orange') path = assetBase() + 'pz-tee-deep-orange-heather-back.jpg';
          else path = assetBase() + 'pz-tee-' + slug + '-back.jpg';
        } else {
          path = assetBase() + 'pz-tee-' + slug + '-front.jpg';
        }
      } else if (angle === 'Back') {
        path = assetBase() + 'pz-zip-QZ-' + slug + '-back.png';
      } else if (angle === 'Right') {
        // Zepto file uses capital N for navy sleeve only
        path = slug === 'navy'
          ? assetBase() + 'pz-zip-QZ-Navy-right-sleeve.png'
          : assetBase() + 'pz-zip-QZ-' + slug + '-right-sleeve.png';
      } else {
        path = assetBase() + 'pz-zip-QZ-' + slug + '-front.png';
      }
      return garmentUrl(path);
    }

    function setMainPhoto(url) {
      if (!url) return;
      if (photo) {
        photo.setAttribute('src', url);
        photo.removeAttribute('srcset');
      }
      document.querySelectorAll('.product-media__image').forEach(function (shopImg) {
        shopImg.setAttribute('src', url);
        shopImg.removeAttribute('srcset');
      });
    }

    function probeUrl(url, ok, fail) {
      if (!url) {
        if (fail) fail();
        return;
      }
      var img = new Image();
      img.onload = function () {
        if (img.naturalWidth > 0) ok(url);
        else if (fail) fail();
      };
      img.onerror = function () {
        if (fail) fail();
      };
      img.src = url;
    }

    function viewAngles() {
      // Soft tee (vv): Front design / Back design only. Zip: Front / Back / Right sleeve.
      if (logoMapKind === 'soft-tee') return ['Front', 'Back'];
      return ['Front', 'Back', 'Right'];
    }

    function fillThumbLayer(angle) {
      var host = viewsHost();
      var stamp = host.querySelector('[data-humc-view-layer="' + angle + '"]');
      if (!stamp) return;
      var spec = layerFor(designs[angle] || 'BLANK');
      stamp.className = '';
      if (!spec || !spec.file) {
        stamp.removeAttribute('src');
        stamp.hidden = true;
        return;
      }
      stamp.classList.add('is-' + (spec.place || 'left-chest'));
      stamp.setAttribute('src', layerUrl(spec.file));
      stamp.hidden = false;
    }

    function fillThumbs() {
      var host = viewsHost();
      viewAngles().forEach(function (angle) {
        var btn = host.querySelector('[data-view="' + angle + '"]');
        var thumb = host.querySelector('[data-humc-view-thumb="' + angle + '"]');
        var url = urlForLocation(angle);
        // Never hide the vv angle tabs — always keep Front/Back/(Right) available.
        if (btn) {
          btn.hidden = false;
          btn.disabled = false;
        }
        probeUrl(
          url,
          function (okUrl) {
            if (thumb) {
              thumb.setAttribute('src', okUrl);
              thumb.hidden = false;
            }
          },
          function () {
            if (thumb) {
              thumb.removeAttribute('src');
              thumb.hidden = true;
            }
          }
        );
        // Each thumb remembers that location's color (garment) + chosen logo.
        fillThumbLayer(angle);
      });
    }

    function setView(angle) {
      currentView = angle || 'Front';
      var label = designLabelFor(currentView);
      viewsHost().querySelectorAll('[data-view]').forEach(function (btn) {
        btn.hidden = false;
        var on = btn.getAttribute('data-view') === currentView;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      showLocationPanels(currentView);
      var url = urlForLocation(currentView);
      var front = urlForLocation('Front');
      probeUrl(
        url,
        function (okUrl) {
          setMainPhoto(okUrl);
        },
        function () {
          setMainPhoto(front);
        }
      );
      setDesignLayer(designs[currentView]);
      if (caption) {
        caption.textContent = [currentColorName, label, designs[currentView]].filter(Boolean).join(' · ');
      }
      syncDesignInputs();
      refreshSummary();
    }

    function selectDesign(location, name) {
      if (!location) return;
      designs[location] = name || designs[location];
      root.querySelectorAll('[data-field="design"][data-location="' + location + '"]').forEach(function (btn) {
        var on = btn.getAttribute('data-value') === designs[location];
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      syncDesignInputs();
      syncListingTitle();
      fillThumbs();
      setView(currentView);
      refreshSummary();
    }

    function selectColor(name, colorId) {
      currentColorId = colorId || '';
      currentColorName = name || '';
      if (colorInput) colorInput.value = currentColorName;
      if (colorNameEl) colorNameEl.textContent = currentColorName;
      root.querySelectorAll('[data-field="color"]').forEach(function (btn) {
        var on = btn.getAttribute('data-value') === name;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      fillThumbs();
      setView(currentView);
      refreshSummary();
      showError('');
    }

    function syncSizeQty() {
      if (!needsSize || !sizeInput) return;
      var chosen = '';
      var qty = 0;
      root.querySelectorAll('[data-size-qty]').forEach(function (input) {
        var n = parseInt(input.value, 10) || 0;
        if (n > 0 && !chosen) {
          chosen = input.getAttribute('data-size-qty');
          qty = n;
        }
        input.closest('.humc-customize__size-cell').classList.toggle('is-on', n > 0);
      });
      sizeInput.value = chosen;
      var form = document.getElementById(formId);
      if (form) {
        var q = form.querySelector('[name="quantity"]');
        if (q && qty > 0) q.value = String(qty);
      }
      refreshSummary();
    }

    function isReady() {
      if (!colorInput || !colorInput.value) return 'Pick a color.';
      if (needsSize && (!sizeInput || !sizeInput.value)) return 'Enter a quantity for a size.';
      if (showLogoPicker && (!designs.Front || designs.Front === '')) return 'Pick a front design.';
      return '';
    }

    function markApplies(color) {
      var handles = (color.handles || '').toString();
      if (!handles) return true;
      var handle = root.getAttribute('data-product-handle') || '';
      return handles.split(/[\s,]+/).some(function (h) {
        return h && handle.indexOf(h) !== -1;
      });
    }

    function extraColorsForProduct() {
      return (catalog.extraColors || []).filter(function (color) {
        return color && color.name && markApplies(color);
      });
    }

    function renderSwatches(entry, keepColor) {
      preview = entry;
      if (!swatchBox || !entry || !entry.colors) return;
      var colors = entry.colors.slice();
      extraColorsForProduct().forEach(function (extra) {
        if (colors.some(function (c) { return c.name.toLowerCase() === String(extra.name || '').toLowerCase(); })) return;
        colors.push({ id: extra.id || '', name: extra.name, hex: extra.hex || '#ccc' });
      });
      var seen = {};
      colors = colors.filter(function (color) {
        var key = String(color.name || color.id);
        if (seen[key]) return false;
        seen[key] = true;
        return true;
      });
      // Match vv Zepto shopper color rows (not the full Chipply catalog).
      var allow =
        logoMapKind === 'soft-tee'
          ? ['Aqua Heather', 'Awareness Pink Heather', 'Black', 'Blush Frost', 'Charcoal', 'Deep Orange Heather']
          : logoMapKind === 'zip'
            ? ['Black', 'Charcoal', 'Heathered Charcoal', 'Light Heather Grey', 'New Navy', 'Deep Royal']
            : null;
      if (allow) {
        colors = allow
          .map(function (name) {
            return colors.find(function (c) { return c.name === name; });
          })
          .filter(Boolean);
      }
      swatchBox.innerHTML = '';
      colors.forEach(function (color) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'humc-customize__swatch';
        btn.setAttribute('data-field', 'color');
        btn.setAttribute('data-value', color.name);
        btn.setAttribute('data-color-id', String(color.id));
        btn.setAttribute('title', color.name);
        btn.setAttribute('aria-label', color.name);
        btn.setAttribute('aria-pressed', 'false');
        btn.style.setProperty('--swatch', color.hex || '#ccc');
        if (/white|ash|natural|cornsilk|ice grey|light pink|yellow|light heather/i.test(color.name)) btn.classList.add('is-light');
        swatchBox.appendChild(btn);
      });
      var chosen = null;
      if (keepColor && currentColorName) {
        chosen = colors.find(function (c) { return c.name === currentColorName; });
      }
      if (!chosen) {
        // vv opens CUSTOMIZABLE garments on Black.
        chosen =
          colors.find(function (c) { return c.name === 'Black'; }) ||
          colors.find(function (c) { return String(c.id) === String(entry.default); }) ||
          colors[0];
      }
      if (chosen) selectColor(chosen.name, chosen.id);
    }

    function lookupPreview(sourceId, title) {
      var entry = sourceId && previewMap[sourceId];
      if (entry) {
        entry.id = entry.id || sourceId;
        return entry;
      }
      if (familyId && previewMap[familyId]) {
        entry = previewMap[familyId];
        entry.id = familyId;
        return entry;
      }
      var found = null;
      Object.keys(previewMap).some(function (id) {
        if (previewMap[id].title === title) {
          found = previewMap[id];
          found.id = found.id || id;
          return true;
        }
        return false;
      });
      return found;
    }

    function readCatalog() {
      var host = document.querySelector('[data-humc-catalog]');
      if (!host) return;
      try {
        catalog = JSON.parse(host.getAttribute('data-humc-catalog') || '{}') || catalog;
      } catch (err) {
        catalog = { marks: [], extraColors: [] };
      }
    }

    mountChipplyLayout();
    syncListingTitle();

    viewsHost().querySelectorAll('[data-view]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        setView(btn.getAttribute('data-view'));
      });
    });

    root.querySelectorAll('[data-field="design"]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectDesign(btn.getAttribute('data-location'), btn.getAttribute('data-value'));
      });
    });

    document.addEventListener(
      'click',
      function (event) {
        if (!root.isConnected) return;
        var t = event.target;
        if (!t || !t.closest) return;
        var colorBtn = t.closest('[data-field="color"]');
        if (colorBtn && root.contains(colorBtn)) {
          selectColor(colorBtn.getAttribute('data-value'), colorBtn.getAttribute('data-color-id'));
        }
      },
      true
    );

    root.querySelectorAll('[data-size-qty]').forEach(function (input) {
      input.addEventListener('focus', function () {
        if (input.value === '0') input.select();
      });
      input.addEventListener('input', function () {
        // Chipply-style: one size at a time for a simple cart line
        root.querySelectorAll('[data-size-qty]').forEach(function (other) {
          if (other !== input) other.value = '0';
        });
        if (!input.value || parseInt(input.value, 10) < 0) input.value = '0';
        syncSizeQty();
        showError('');
      });
    });

    document.addEventListener(
      'click',
      function (event) {
        var btn = event.target.closest('[name="add"]');
        if (!btn) return;
        var form = document.getElementById(formId);
        if (!form) return;
        var belongs = btn.form === form || btn.getAttribute('form') === formId || form.contains(btn);
        if (!belongs) return;
        syncSizeQty();
        var msg = isReady();
        if (msg) {
          event.preventDefault();
          event.stopPropagation();
          if (event.stopImmediatePropagation) event.stopImmediatePropagation();
          showError(msg);
          root.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      },
      true
    );

    document.addEventListener(
      'submit',
      function (event) {
        var form = event.target;
        if (!form || form.id !== formId) return;
        syncSizeQty();
        var msg = isReady();
        if (msg) {
          event.preventDefault();
          event.stopPropagation();
          showError(msg);
        }
      },
      true
    );

    readCatalog();
    familyId = COLOR_FAMILY;
    root.setAttribute('data-family-id', familyId);
    // Re-bind layer img if gallery moves later
    layerImg = document.querySelector('[data-humc-design-layer]') || layerImg;
    photo = document.querySelector('[data-humc-demo-photo]') || photo;
    syncDesignInputs();
    showLocationPanels('Front');
    if (showLogoPicker) {
      Object.keys(designs).forEach(function (loc) {
        root.querySelectorAll('[data-field="design"][data-location="' + loc + '"]').forEach(function (btn) {
          var on = btn.getAttribute('data-value') === designs[loc];
          btn.classList.toggle('is-on', on);
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      });
    }

    var mapUrl = root.getAttribute('data-preview-map');
    if (mapUrl) {
      fetch(mapUrl)
        .then(function (res) { return res.json(); })
        .then(function (map) {
          previewMap = map || {};
          var entry = lookupPreview(familyId || root.getAttribute('data-source-id'), root.getAttribute('data-product-title'));
          if (entry) renderSwatches(entry);
          else showError('Preview photos are missing for this product.');
          showLocationPanels(currentView);
          fillThumbs();
          setView(currentView);
        })
        .catch(function () {
          showError('Could not load product photos.');
        });
    }
  })();
</script>
{%- endif -%}

{%- if title_l contains 'personalization' -%}
