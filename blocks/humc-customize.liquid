{% stylesheet %}
  .humc-customize {
    display: grid;
    gap: 1.1rem;
    width: 100%;
  }

  .humc-customize__hint,
  .humc-customize__summary,
  .humc-customize__color-name {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .humc-customize__hint {
    opacity: 0.7;
  }

  .humc-customize__color-name {
    min-height: 1.2em;
    margin-block-end: 0.45rem;
  }

  .humc-customize__summary {
    font-weight: 600;
  }

  .humc-customize__error {
    margin: 0;
    color: #8b1e2d;
    font-size: 0.875rem;
  }

  .humc-customize__set {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }

  .humc-customize__set legend {
    padding: 0;
    margin-block-end: 0.45rem;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .humc-customize__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }

  .humc-customize__swatch {
    appearance: none;
    width: 1.05rem;
    height: 1.05rem;
    padding: 0;
    margin: 0;
    border: 1px solid rgb(0 0 0 / 0.28);
    border-radius: 50%;
    background: var(--swatch, #ccc);
    cursor: pointer;
  }

  .humc-customize__swatch.is-light {
    border-color: rgb(0 0 0 / 0.4);
  }

  .humc-customize__swatch.is-on {
    outline: 2px solid #121212;
    outline-offset: 2px;
  }

  .humc-customize__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .humc-customize__chip {
    appearance: none;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.12rem;
    margin: 0;
    padding: 0.4rem 0.65rem;
    border: 1px solid #d6d6d6;
    background: #fff;
    color: inherit;
    font: inherit;
    font-size: 0.8rem;
    line-height: 1.2;
    cursor: pointer;
  }

  .humc-customize__chip [data-side-mark] {
    min-height: 0.85em;
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .humc-customize__chip.is-on {
    border-color: #121212;
    background: #121212;
    color: #fff;
  }

  .humc-customize__chip.is-focus {
    outline: 2px solid #121212;
    outline-offset: 2px;
  }

  .humc-customize__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .humc-customize__logo {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.4rem 0.65rem;
    border: 1px solid #d6d6d6;
    background: #fff;
    color: inherit;
    font: inherit;
    text-decoration: none;
    font-size: 0.8rem;
    line-height: 1.2;
    cursor: pointer;
  }

  .humc-customize__logo img {
    display: block;
    height: 16px;
    width: auto;
  }

  .humc-customize__logo.is-on {
    border-color: #121212;
    background: #121212;
    color: #fff;
  }

  .humc-customize__chip,
  .humc-customize__swatch,
  .humc-customize__logo,
  .humc-demo__view {
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 140ms ease, border-color 140ms ease;
  }

  .humc-customize__chip:active,
  .humc-customize__swatch:active,
  .humc-customize__logo:active,
  .humc-demo__view:active {
    transform: scale(0.97);
  }

  .humc-body.has-humc-demo media-gallery,
  .humc-body.has-humc-demo .product-media-container,
  .humc-body.has-humc-demo .product-media {
    display: none !important;
  }

  .humc-demo {
    max-width: 600px;
  }

  .humc-demo__stage {
    position: relative;
    background: #fff;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .humc-demo__stage [data-humc-demo-photo] {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    position: relative;
    z-index: 0;
    transition: opacity 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .humc-demo__stage [data-humc-logo-layer],
  .humc-demo__stage [data-humc-logo-cover] {
    position: absolute;
    pointer-events: none;
    object-fit: contain;
  }

  .humc-demo__stage [data-humc-logo-cover] {
    z-index: 2;
    border-radius: 50%;
    background: var(--humc-cover, #242729);
  }

  .humc-demo__stage [data-humc-logo-layer] {
    z-index: 3;
    height: auto;
  }

  .humc-demo__stage[data-angle='Front'] [data-humc-logo-layer] {
    top: 24.5%;
    left: 58.5%;
    width: 8.5%;
  }

  .humc-demo__stage[data-angle='Front'] [data-humc-logo-cover] {
    top: 21%;
    left: 55%;
    width: 16%;
    height: 16%;
  }

  .humc-demo__stage[data-angle='Back'] [data-humc-logo-layer] {
    top: 28%;
    left: 50%;
    width: 9%;
    transform: translateX(-50%);
  }

  .humc-demo__stage[data-angle='Back'] [data-humc-logo-cover] {
    top: 26%;
    left: 50%;
    width: 14%;
    height: 14%;
    transform: translateX(-50%);
  }

  .humc-demo__stage[data-angle='Left'] [data-humc-logo-layer] {
    top: 31%;
    left: 47%;
    width: 8%;
  }

  .humc-demo__stage[data-angle='Left'] [data-humc-logo-cover] {
    top: 29%;
    left: 45%;
    width: 12%;
    height: 12%;
  }

  .humc-demo__stage[data-angle='Right'] [data-humc-logo-layer] {
    top: 29%;
    left: 32.5%;
    width: 8%;
  }

  .humc-demo__stage[data-angle='Right'] [data-humc-logo-cover] {
    top: 25.5%;
    left: 28.5%;
    width: 16%;
    height: 16%;
  }

  .humc-demo__stage[data-family='trucker hat'] [data-humc-logo-layer],
  .humc-demo__stage[data-family='jumbo canvas bag'] [data-humc-logo-layer] {
    top: 34%;
    left: 50%;
    width: 28%;
    transform: translateX(-50%);
  }

  .humc-demo__caption {
    margin: 0.55rem 0 0.7rem;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .humc-demo__views {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .humc-demo__view[hidden] {
    display: none;
  }

  .humc-demo__view {
    appearance: none;
    width: 4.6rem;
    margin: 0;
    padding: 0.3rem;
    border: 1px solid #d6d6d6;
    background: #fff;
    color: inherit;
    font: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .humc-demo__view img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    background: #f3f3f3;
    margin-block-end: 0.25rem;
  }

  .humc-demo__view.is-on {
    border-color: #121212;
  }

  @media (prefers-reduced-motion: reduce) {
    .humc-customize__chip,
    .humc-customize__swatch,
    .humc-customize__logo,
    .humc-demo__view,
    .humc-demo__stage [data-humc-demo-photo] {
      transition: none;
    }
  }
{% endstylesheet %}

