  }

  .humc-customize__size-label {
    font-size: 0.72rem;
    font-weight: 600;
  }

  .humc-customize__size-qty {
    width: 2.4rem;
    padding: 0.2rem 0.15rem;
    border: 1px solid #ccc;
    text-align: center;
    font: inherit;
    font-size: 0.85rem;
  }

  .humc-customize__crumbs,
  .product-information > .humc-customize__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    margin: 0 0 0.85rem;
    padding-inline: var(--page-margin, 0);
    font-size: 0.75rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    grid-column: 1 / -1;
  }

  .humc-customize__crumbs a {
    color: #666;
    text-decoration: none;
  }

  .humc-customize__crumbs a:hover {
    text-decoration: underline;
  }

  .humc-customize__bullets {
    margin: 0.75rem 0 0;
    padding-inline-start: 1.15rem;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .humc-customize__bullets li {
    margin-block-end: 0.25rem;
  }

  .humc-customize__size-guide {
    margin-block-start: 1.25rem;
  }

  .humc-customize__size-guide-title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
  }

  .humc-customize__size-guide-note {
    margin: 0 0 0.55rem;
    font-size: 0.8rem;
    color: #555;
  }

  .humc-customize__size-table-wrap {
    overflow-x: auto;
  }

  .humc-customize__size-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
  }

  .humc-customize__size-table th,
  .humc-customize__size-table td {
    border: 1px solid #ddd;
    padding: 0.35rem 0.4rem;
    text-align: center;
  }

  .humc-customize__size-table thead th {
    background: #eee;
    font-weight: 600;
  }

  /* Chipply 2-column: photo left (media), buy column right (details) */
  body.has-humc-demo .product-information__grid {
    display: grid !important;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 1.5rem 2rem;
    align-items: start;
  }

  body.has-humc-demo .product-information__media {
    display: block !important;
    width: 100%;
    max-width: none;
  }

  body.has-humc-demo .product-information__media media-gallery,
  body.has-humc-demo .product-information__media .product-media-container,
  body.has-humc-demo .product-information__media .product-media {
    display: none !important;
  }

  body.has-humc-demo .product-information__media .humc-customize__gallery {
    width: 100%;
  }

  body.has-humc-demo .product-details .humc-customize__gallery {
    display: none;
  }

  body.has-humc-demo .buy-buttons,
  body.has-humc-demo .product-form-buttons {
    display: grid;
    gap: 0.5rem;
  }

  body.has-humc-demo .buy-buttons .button,
  body.has-humc-demo button[name="add"] {
    width: 100%;
    min-height: 2.75rem;
    border-radius: 0 !important;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  body.has-humc-demo quantity-selector,
  body.has-humc-demo .quantity-selector,
  body.has-humc-demo .quantity {
    display: none !important;
  }

  @media (max-width: 900px) {
    body.has-humc-demo .product-information__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .humc-customize__chip,
    .humc-customize__swatch,
    .humc-customize__view {
      transition: none;
    }
  }
{% endstylesheet %}

